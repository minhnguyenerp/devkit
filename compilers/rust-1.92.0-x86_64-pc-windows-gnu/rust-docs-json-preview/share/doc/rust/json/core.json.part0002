y":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u8"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u64"},"trait":{"path":"Shr","id":4650,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"40536":{"id":40536,"crate_id":0,"name":"_mm_mul_sch","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[2796,1],"end":[2798,2]},"visibility":"public","docs":"Multiply the lower complex numbers in a and b, and store the result in the lower elements of dst,\nand copy the upper 6 packed elements from a to the upper elements of dst. Each complex number is\ncomposed of two adjacent half-precision (16-bit) floating-point elements, which defines the complex\nnumber `complex = vec.fp16[0] + i * vec.fp16[1]`.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_mul_sch)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfmulcsh))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}]],"output":{"resolved_path":{"path":"__m128h","id":9310,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22589":{"id":22589,"crate_id":0,"name":"RightCurlyBracket","span":{"filename":"library\\core\\src\\ascii\\ascii_char.rs","begin":[439,5],"end":[439,28]},"visibility":"default","docs":"U+007D","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 110998, is_soft: false}, feature: \"ascii_char_variants\"}}]"}],"deprecation":null,"inner":{"variant":{"kind":"plain","discriminant":{"expr":"125","value":"125"}}}},"791":{"id":791,"crate_id":0,"name":"Hasher","span":{"filename":"library\\core\\src\\hash\\mod.rs","begin":[313,1],"end":[555,2]},"visibility":"public","docs":"A trait for hashing an arbitrary stream of bytes.\n\nInstances of `Hasher` usually represent state that is changed while hashing\ndata.\n\n`Hasher` provides a fairly basic interface for retrieving the generated hash\n(with [`finish`]), and writing integers as well as slices of bytes into an\ninstance (with [`write`] and [`write_u8`] etc.). Most of the time, `Hasher`\ninstances are used in conjunction with the [`Hash`] trait.\n\nThis trait provides no guarantees about how the various `write_*` methods are\ndefined and implementations of [`Hash`] should not assume that they work one\nway or another. You cannot assume, for example, that a [`write_u32`] call is\nequivalent to four calls of [`write_u8`].  Nor can you assume that adjacent\n`write` calls are merged, so it's possible, for example, that\n```\n# fn foo(hasher: &mut impl std::hash::Hasher) {\nhasher.write(&[1, 2]);\nhasher.write(&[3, 4, 5, 6]);\n# }\n```\nand\n```\n# fn foo(hasher: &mut impl std::hash::Hasher) {\nhasher.write(&[1, 2, 3, 4]);\nhasher.write(&[5, 6]);\n# }\n```\nend up producing different hashes.\n\nThus to produce the same hash value, [`Hash`] implementations must ensure\nfor equivalent items that exactly the same sequence of calls is made -- the\nsame methods with the same parameters in the same order.\n\n# Examples\n\n```\nuse std::hash::{DefaultHasher, Hasher};\n\nlet mut hasher = DefaultHasher::new();\n\nhasher.write_u32(1989);\nhasher.write_u8(11);\nhasher.write_u8(9);\nhasher.write(b\"Huh?\");\n\nprintln!(\"Hash is {:x}!\", hasher.finish());\n```\n\n[`finish`]: Hasher::finish\n[`write`]: Hasher::write\n[`write_u8`]: Hasher::write_u8\n[`write_u32`]: Hasher::write_u32","links":{"`Hash`":793,"Hasher::write":29209,"Hasher::write_u8":29212,"Hasher::finish":29210,"Hasher::write_u32":29214},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"trait":{"is_auto":false,"is_unsafe":false,"is_dyn_compatible":true,"items":[29210,29209,29212,29213,29214,29215,29216,29217,29218,29219,29220,29221,29222,29223,29211,29224],"generics":{"params":[],"where_predicates":[]},"bounds":[],"implementations":[29131,29241]}}},"44387":{"id":44387,"crate_id":0,"name":"vec_sldw","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\powerpc\\altivec.rs","begin":[3418,1],"end":[3423,2]},"visibility":"public","docs":"Vector Shift Left Double by Words\n\n## Endian considerations\n\nThis intrinsic is not endian-neutral, so uses of vec_sldw in\nbig-endian code must be rewritten for little-endian targets.\n\nThe concatenation of a and b is done in big-endian fashion (left to right), and the shift is\nalways to the left. This will generally produce surprising results for little- endian targets.","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 111145, is_soft: false}, feature: \"stdarch_powerpc\"}}]"},{"target_feature":{"enable":["altivec"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"generic":"T"}],["b",{"generic":"T"}]],"output":{"generic":"T"},"is_c_variadic":false},"generics":{"params":[{"name":"T","kind":{"type":{"bou