ANT_NORM_p5_2    // interval [0.5, 2)\\\n   _MM_MANT_NORM_p5_1    // interval [0.5, 1)\\\n   _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\\\nThe sign is determined by sc which can take the following values:\\\n   _MM_MANT_SIGN_src     // sign = sign(src)\\\n   _MM_MANT_SIGN_zero    // sign = 0\\\n   _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\\\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=mm_maskz_getmant_round_ss&expand=2894)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantss, NORM = 0, SIGN = 0, SAE = 4))]"},{"other":"#[rustc_legacy_const_generics(3, 4, 5)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}],["a",{"resolved_path":{"path":"__m128","id":9277,"args":null}}],["b",{"resolved_path":{"path":"__m128","id":9277,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36281,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36282,"args":null}}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128","id":9277,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"20338":{"id":20338,"crate_id":0,"name":"bitxor_assign","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[905,1],"end":[905,81]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"i