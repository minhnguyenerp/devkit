_MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\n\nThe sign is determined by sc which can take the following values:\n\n    _MM_MANT_SIGN_src     // sign = sign(src)\n    _MM_MANT_SIGN_zero    // sign = 0\n    _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_getmant_round_sh)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantsh, NORM = 0, SIGN = 0, SAE = 8))]"},{"other":"#[rustc_legacy_const_generics(2, 3, 4)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36281,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36282,"args":null}}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9310,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1150":{"id":1150,"crate_id":0,"name":"isolate_lowest_one","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2344,1],"end":[2354,2]},"visibility":"public","docs":"Returns `self` with only the least significant bit set.\n\n# Example\n\n```\n#![feature(isolate_most_least_significant_one)]\n\n# use core::num::NonZero;\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet a = NonZero::<i32>::new(0b_01100100)?;\nlet b = NonZero::<i32>::new(0b_00000100)?;\n\nassert_eq!(a.isolate_lowest_one(), b);\n