e}}},"36825":{"id":36825,"crate_id":0,"name":"_mm512_i32scatter_pd","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[16920,1],"end":[16931,2]},"visibility":"public","docs":"Scatter double-precision (64-bit) floating-point elements from a into memory using 32-bit indices. 64-bit elements are stored at addresses starting at base_addr and offset by each 32-bit element in vindex (each index is scaled by the factor in scale). scale should be 1, 2, 4 or 8.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_i32scatter_pd&expand=3044)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vscatterdpd, SCALE = 1))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["slice",{"raw_pointer":{"is_mutable":true,"type":{"primitive":"f64"}}}],["offsets",{"resolved_path":{"path":"__m256i","id":9283,"args":null}}],["src",{"resolved_path":{"path":"__m512d","id":9298,"args":null}}],["SCALE",{"primitive":"i32"}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"18878":{"id":18878,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u128"},"trait":{"path":"Shr","id":4650,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}}}}}}},"40676":{"id":40676,"crate_id":0,"name":"_mm_fmadd_round_sh","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[5500,1],"end":[5509,2]},"visibility":"public","docs":"Multiply the lower half-precision (16-bit) floating-point elements in a and b, and add the intermediate\nresult to the lower element in c. Store the result in the lower element of dst, and copy the upper\n7 packed elements from a to the upper elements of dst.\n\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_fmadd_round_sh)","links":{"`_MM_FROUND_TO_POS_INF`":35150,"`_MM_SET_ROUNDING_MODE`":34890,"`_MM_FROUND_TO_NEAREST_INT`":35148,"`_MM_FROUND_NO_EXC`":35154,"`_MM_FROUND_TO_NEG_INF`":35149,"`_MM_FROUND_TO_ZERO`":35151,"`_MM_FROUND_CUR_DIRECTION`":35152},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfmadd, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["c",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9310,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"931":{"id":931,"crate_id":0,"name":"cast_signed","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2245,1],"end":[2255,2]},"visibility":"public","docs":"Returns the bit pattern of `self` reinterpreted as a signed integer of the same size.\n\n# Examples\n\n```\n# use std::num::NonZero;\n\nlet n = NonZero::<u32>::MAX;\n\nassert_eq!(n.cast_signed(), NonZero::new(-1i32).unwrap());\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 87, patch: 0})}, feature: \"integer_sign_cast\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 87, patch: 0})}, feature: \"integer_sign_cast\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i32"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22729":{"id":22729,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[827,1],"end":[837,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"U","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where