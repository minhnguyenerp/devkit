w/us/en/docs/intrinsics-guide/index.html#text=_mm256_mask_dbsad_epu8&expand=2112)","links":{},"attrs":[{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[<cfg_attr>(test, assert_instr(vdbpsadbw, IMM8 = 0))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512bw","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m256i","id":9283,"args":null}}],["k",{"resolved_path":{"path":"__mmask16","id":35777,"args":null}}],["a",{"resolved_path":{"path":"__m256i","id":9283,"args":null}}],["b",{"resolved_path":{"path":"__m256i","id":9283,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m256i","id":9283,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"21427":{"id":21427,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[1077,1],"end":[1077,77]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"ShrAssign","id":4662,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i64"}}}}],"constraints":[]}}},"for":{"primitive":"i64"},"items":[21426],"is_negative":false,"is_synthetic":false,"b