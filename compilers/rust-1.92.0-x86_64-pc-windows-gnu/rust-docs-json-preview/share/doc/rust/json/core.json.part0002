bility {stability: Stability {level: Unstable {reason: None,\nissue: 116909, is_soft: false}, feature: \"f16\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"method returns a new number and does not mutate the original value"}},{"other":"#[attr = AllowIncoherentImpl]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"primitive":"f16"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9284":{"id":9284,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\mod.rs","begin":[8,1],"end":[279,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[doc(cfg(any(target_arch = \"x86\", target_arch = \"x86_64\")))]"},{"other":"#[allow(non_camel_case_types)]"},{"other":"#[allow(clippy :: missing_inline_in_public_items)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":["clone_from"],"trait":{"path":"Clone","id":37,"args":null},"for":{"resolved_path":{"path":"__m256i","id":9283,"args":null}},"items":[9282],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"31082":{"id":31082,"crate_id":0,"name":"xperm8","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\riscv_shared\\zk.rs","begin":[64,1],"end":[74,2]},"visibility":"public","docs":"Byte-wise lookup of indicies into a vector in registers.\n\nThe xperm8 instruction operates on bytes. The rs1 register contains a vector of XLEN/8\n8-bit elements. The rs2 register contains a vector of XLEN/8 8-bit indexes. The result is\neach element in rs2 replaced by the indexed element in rs1, or zero if the index into rs2\nis out of bounds.\n\nSource: RISC-V Cryptography Extensions Volume I: Scalar & Entropy Source Instructions\n\nVersion: v1.0.1\n\nSection: 3.47","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(xperm8))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 114544, is_soft: false}, feature: \"riscv_ext_intrinsics\"}}]"},{"target_feature":{"enable":["zbkx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["rs1",{"primitive":"usize"}],["rs2",{"primitive":"usize"}]],"output":{"primitive":"usize"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"13135":{"id":13135,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"Idx","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"Idx"},"bounds":[{"trait_bound":{"trait":{"path":"Freeze","id":676,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Freeze","id":676,"args":null},"for":{"resolved_path":{"path":"Range","id":8734,"args":{"angle_bracketed":{"args":[{"type":{"generic":"Idx"}}],"constraints":[]}}}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"34933":{"id":34933,"crate_id":0,"name":"_mm_subs_epu16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\sse2.rs","begin":[446,1],"end":[448,2]},"visibility":"public","docs":"Subtract packed unsigned 16-bit integers in `b` from packed unsigned 16-bit\nintegers in `a` using saturation.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_subs_epu16)","links":{}