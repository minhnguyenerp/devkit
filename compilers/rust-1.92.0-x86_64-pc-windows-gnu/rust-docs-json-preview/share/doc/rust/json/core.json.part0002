i32_mask&expand=1029)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpcmp))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}],["b",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}]],"output":{"resolved_path":{"path":"__mmask16","id":35777,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19833":{"id":19833,"crate_id":0,"name":"shr","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"i32"}]],"output":{"primitive":"i128"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"41631":{"id":41631,"crate_id":0,"name":"_tile_cmmrlfp16ps","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86_64\\amx.rs","begin":[238,1],"end":[243,2]},"visibility":"public","docs":"Perform matrix multiplication of two tiles containing complex elements and accumulate the results into a packed single precision tile.\nEach dword element in input tiles a and b is interpreted as a complex number with FP16 real part and FP16 imaginary part.\nCalculates the real part of the result. For each possible combination of (row of a, column of b),\nit performs a set of multiplication and accumulations on all corresponding complex numbers (one from a and one from b).\nThe real part of the a element is multiplied with the real part of the corresponding b element, and the negated imaginary part of\nthe a element is multiplied with the imaginary part of the corresponding b elements.\nThe two accumulated results are added, and then accumulated into the corresponding row and column of dst.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_tile_cmmrlfp16ps&ig_expand=6862)","links":{},"attrs":[{"other":"#[rustc_legacy_const_generics(0, 1, 2)]"},{"other":"#[<cfg_attr>(test, assert_instr(tcmmrlfp16ps, DST = 0, A = 1, B = 2))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 126622, is_soft: false}, feature: \"x86_amx_intrinsics\"}}]"},{"target_feature":{"enable":["amx-complex"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["DST",{"primitive":"i32"}],["A",{"primitive":"i32"}],["B",{"primitive":"i32"}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"1886":{"id":1886,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[594,1],"end":[594,78]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143773, is_soft: false}, feature: \"const_convert\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 49, patch: 0})}, feature: \"nzint_try_from_nzint_conv\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"TryFrom","id":163,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"NonZero","