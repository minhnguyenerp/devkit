s, and store the upper 16-bits in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_maskz_shldi_epi16&expand=5035)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpshldw, IMM8 = 5))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512vbmi2","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}],["a",{"resolved_path":{"path":"__m128i","id":9274,"args":null}}],["b",{"resolved_path":{"path":"__m128i","id":9274,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128i","id":9274,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"359":{"id":359,"crate_id":0,"name":"LOG10_E","span":{"filename":"library\\core\\src\\num\\f32.rs","begin":[373,5],"end":[373,73]},"visibility":"public","docs":"log<sub>10</sub>(e)","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"constant":{"type":{"primitive":"f32"},"const":{"expr":"0.434294481903251827651128918916605082_f32","value":"0.434294492f32","is_literal":true}}}},"22157":{"id":22157,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\range.rs","begin":[764,1],"end":[788,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"