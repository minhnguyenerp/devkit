ion],\n`NonZeroU16` and `Option<NonZeroU16>`\nare guaranteed to have the same size and alignment:\n\n```\nuse std::num::NonZeroU16;\n\nassert_eq!(size_of::<NonZeroU16>(), size_of::<Option<NonZeroU16>>());\nassert_eq!(align_of::<NonZeroU16>(), align_of::<Option<NonZeroU16>>());\n```\n\n# Compile-time creation\n\nSince both [`Option::unwrap()`] and [`Option::expect()`] are `const`, it is possible to\ndefine a new\n`NonZeroU16`\nat compile time via:\n```\nuse std::num::NonZeroU16;\n\nconst TEN: NonZeroU16 = NonZeroU16::new(10).expect(\"ten is non-zero\");\n```\n\n[null pointer optimization]: crate::option#representation","links":{"crate::option#representation":816,"`u16`":254,"`Option::unwrap()`":1938,"`Option::expect()`":1939},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 28, patch: 0})}, feature: \"nonzero\"}}]"}],"deprecation":null,"inner":{"type_alias":{"type":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"23739":{"id":23739,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\iter\\adapters\\enumerate.rs","begin":[14,17],"end":[14,22]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"I","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"$crate::fmt::Debug","id":712,"args":null},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Debug","id":712,"args":null},"for":{"resolved_path":{"path":"Enumerate","id":8597,"args":{"angle_bracketed":{"args":[{"type":{"generic":"I"}}],"constra