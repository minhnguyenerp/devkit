fine_epi64_epi8)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgf2p8affineqb, B = 0))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["gfni","avx512bw","avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"crate::core_arch::x86::__m512i","id":9292,"args":null}}],["k",{"resolved_path":{"path":"crate::core_arch::x86::__mmask64","id":38666,"args":null}}],["x",{"resolved_path":{"path":"crate::core_arch::x86::__m512i","id":9292,"args":null}}],["a",{"resolved_path":{"path":"crate::core_arch::x86::__m512i","id":9292,"args":null}}],["B",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"crate::core_arch::x86::__m512i","id":9292,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22291":{"id":22291,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\unsize.rs","begin":[48,1],"end":[48,94]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 18598, is_soft: false}, feature: \"coerce_unsized\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"'a","kind":{"lifetime":{"outlives":[]}}},{"name":"T","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"PointeeSized","id":7294,"args":null},"generic_params":[],"modifier":"none"}},{"trait_bound":{"trait":{"path":"Unsize","id":8321,"args":{"angle_bracketed":{"args":[{"type":{"generic":"U"}}],"constraints":[]}}},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":false}}},{"name":"U","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"p