ync":false,"abi":"Rust"},"has_body":true}}},"10677":{"id":10677,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\net\\socket_addr.rs","begin":[606,1],"end":[612,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143773, is_soft: false}, feature: \"const_convert\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 16, patch: 0})}, feature: \"ip_from_ip\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"SocketAddrV6","id":8708,"args":null}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"SocketAddr","id":8702,"args":null}},"items":[10676],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"32475":{"id":32475,"crate_id":0,"name":"vqdmulh_laneq_s32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[37623,1],"end":[37626,2]},"visibility":"public","docs":"Vector saturating doubling multiply high by scalar\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vqdmulh_laneq_s32)","links":{},"attrs":[{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(vqdmulh, LANE = 0))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(sqdmulh, LANE = 0))]"},{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"int32x2_t","id":8980,"args":null}}],["b",{"resolved_path":{"path":"int32x4_t","id":9016,"args":null}}],["LANE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"int32x2_t","id":8980,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"14528":{"id":14528,"crate_id":0,"name":"mul","span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[361,1],"end":[361,83]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"i64"}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"i64"},"trait":{"path":"Mul","id":2290,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"36326":{"id":36326,"crate_id":0,"name":"_mm512_maskz_sqrt_round_ps","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[8383,1],"end":[8390,2]},"visibility":"public","docs":"Compute the square root of packed single-precision (32-bit) floating-point elements in a, and store the results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\\\n\nRounding is done according to the rounding\\[3:0\\] parameter, which can be one of:\\\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_maskz_sqrt_round_ps&expand=5376)","links":{"`_MM_FROUND_TO_POS_INF`":35150,"`_MM_SET_ROUNDING_MODE`":34890,"`_MM_FROUND_TO_NEAREST_INT`":35148,"`_MM_FROUND_NO_EXC`":35154,"`_MM_FROUND_TO_NEG_INF`":35149,"`_MM_FROUND_TO_ZERO`":35151,"`_MM_FROUND_CUR_DIRECTION`":35152},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vsqrtps, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask16","id":35777,"args":null}}],["a",{"resolved_path":{"path":"__m512","id":9295,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512","id":9295,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18379":{"id":18379,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: fa