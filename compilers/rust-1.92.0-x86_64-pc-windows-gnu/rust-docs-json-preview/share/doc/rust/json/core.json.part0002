imitive":"i8"}},{"const":{"expr":"$num_elements","value":null,"is_literal":true}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"7106":{"id":7106,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\iter\\traits\\accum.rs","begin":[204,1],"end":[204,77]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 14, patch: 0})}, feature: \"wrapping_iter_arith\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Sum","id":4285,"args":null},"for":{"resolved_path":{"path":"Wrapping","id":4335,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}}],"constraints":[]}}}},"items":[7105],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"28904":{"id":28904,"crate_id":0,"name":"fmt","span":{"filename":"library\\core\\src\\str\\error.rs","begin":[139,5],"end":[141,6]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["f",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"resolved_path":{"path":"fmt::Formatter","id":709,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"}],"constraints":[]}}}}}}]],"output":{"resolved_path":{"path":"fmt::Result","id":710,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"50702":{"id":50702,"crate_id":0,"name":"carrying_mul","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[420,5],"end":[439,6]},"visibility":"public","docs":"Calculates the \"full multiplication\" `self * rhs + carry`\nwithout the possibility to overflow.\n\nThis returns the low-order (wrapping) bits and the high-order (overflow) bits\nof the result as two separate values, in that order.\n\nPerforms \"long multiplication\" which takes in an extra amount to add, and may return an\nadditional amount of overflow. This allows for chaining together multiple\nmultiplications to create \"big integers\" which represent larger values.\n\nIf you don't need the `carry`, then you can use [`Self::widening_mul`] instead.\n\n# Examples\n\nPlease note that this example is shared among integer types, which is why `i32` is used.\n\n```\n#![feature(bigint_helper_methods)]\nassert_eq!(5i32.carrying_mul(-2, 0), (4294967286, -1));\nassert_eq!(5i32.carrying_mul(-2, 10), (0, 0));\nassert_eq!(1_000_000_000i32.carrying_mul(-10, 0), (2884901888, -3));\nassert_eq!(1_000_000_000i32.carrying_mul(-10, 10), (2884901898, -3));\nassert_eq!(isize::MAX.carrying_mul(isize::MAX, isize::MAX), (isize::MAX.unsigned_abs() + 1, isize::MAX / 2));\n```","links":{"`Self::widening_mul`":50703},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 85532, is_soft: false}, feature: \"bigint_helper_methods\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 85532, is_soft: false}, feature: \"bigint_helper_methods\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}],["carry",{"generic":"Self"}]],"output":{"tuple":[{"primitive":"usize"},{"generic":"Self"}]},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10957":{"id":10957,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\vendor\\x86.rs","begin":[58,5],"end":[58,50]},"visibility