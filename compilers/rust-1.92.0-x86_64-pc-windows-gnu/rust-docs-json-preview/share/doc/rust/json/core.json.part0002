\core_arch\\src\\x86\\avx512f.rs","begin":[20475,1],"end":[20480,2]},"visibility":"public","docs":"Shift packed 64-bit integers in a left by count while shifting in zeros, and store the results in dst using writemask k (elements are copied from src when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_mask_sll_epi64&expand=5284)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpsllq))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m256i","id":9283,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}],["a",{"resolved_path":{"path":"__m256i","id":9283,"args":null}}],["count",{"resolved_path":{"path":"__m128i","id":9274,"args":null}}]],"output":{"resolved_path":{"path":"__m256i","id":9283,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19091":{"id":19091,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"usize"},"trait":{"path":"Shr","id":4650,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}}}}}},"40889":{"id":40889,"crate_id":0,"name":"_mm512_getmant_round_ph","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[9460,1],"end":[9471,2]},"visibility":"public","docs":"Normalize the mantissas of packed half-precision (16-bit) floating-point elements in a, and store\nthe results in dst. This intrinsic essentially calculates `±(2^k)*|x.significand|`, where k depends\non the interval range defined by norm and the sign depends on sign and the source sign. Exceptions can\nbe suppressed by passing _MM_FROUND_NO_EXC in the sae parameter\n\nThe mantissa is normalized to the interval specified by interv, which can take the following values:\n\n    _MM_MANT_NORM_1_2     // interval [1, 2)\n    _MM_MANT_NORM_p5_2    // interval [0.5, 2)\n    _MM_MANT_NORM_p5_1    // interval [0.5, 1)\n    _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\n\nThe sign is determined by sc which can take the following values:\n\n    _MM_MANT_SIGN_src     // sign = sign(src)\n    _MM_MANT_SIGN_zero    // sign = 0\n    _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_getmant_round_ph)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantph, NORM = 0, SIGN = 0, SAE = 8))]"},{"other":"#[rustc_legacy_const_generics(1, 2, 3)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512h","id":9316,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36281,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36282,"args":null}}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512h","id":9316,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header