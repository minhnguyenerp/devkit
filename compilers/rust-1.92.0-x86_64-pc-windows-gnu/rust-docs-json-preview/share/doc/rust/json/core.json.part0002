00,5],"end":[200,76]},"visibility":"public","docs":"Largest finite `f128` value.\n\nEqual to\n(1&nbsp;&minus;&nbsp;2<sup>&minus;[`MANTISSA_DIGITS`]</sup>)&nbsp;2<sup>[`MAX_EXP`]</sup>.\n\n[`MANTISSA_DIGITS`]: f128::MANTISSA_DIGITS\n[`MAX_EXP`]: f128::MAX_EXP","links":{"f128::MANTISSA_DIGITS":49111,"f128::MAX_EXP":49118},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 116909, is_soft: false}, feature: \"f128\"}}]"}],"deprecation":null,"inner":{"assoc_const":{"type":{"primitive":"f128"},"value":"1.18973149535723176508575932662800702e+4932_f128"}}},"9369":{"id":9369,"crate_id":0,"name":"clone","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\powerpc\\altivec.rs","begin":[23,1],"end":[48,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"vector_signed_int","id":9370,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31167":{"id":31167,"crate_id":0,"name":"__crc32h","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[167,1],"end":[177,2]},"visibility":"public","docs":"CRC32 single round checksum for bytes (16 bits).\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/__crc32h)","links":{},"attrs":[{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v8\"))]"},{"other":"#[<cfg_attr>(test, assert_instr(crc32h))]"},{"other":"#[<cfg_attr>(target_arch = \"arm\",\nunstable(feature = \"stdarch_aarch32_crc32\", issue = \"125085\"))]"},{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable(feature = \"stdarch_aarch64_cr