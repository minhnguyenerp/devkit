iter.next(), Some(4));\nassert_eq!(iter.next(), Some(5));\nassert_eq!(iter.next(), Some(6));\nassert_eq!(iter.next(), None);\n```","links":{"`Iterator::chain`":23594},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"iter_chain\"}}]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"generic":"A"}],["b",{"generic":"B"}]],"output":{"resolved_path":{"path":"Chain","id":8585,"args":{"angle_bracketed":{"args":[{"type":{"qualified_path":{"name":"IntoIter","args":null,"self_type":{"generic":"A"},"trait":{"path":"","id":75,"args":null}}}},{"type":{"qualified_path":{"name":"IntoIter","args":null,"self_type":{"generic":"B"},"trait":{"path":"","id":75,"args":null}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[{"name":"A","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"B","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"A"},"bounds":[{"trait_bound":{"trait":{"path":"IntoIterator","id":75,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}},{"bound_predicate":{"type":{"generic":"B"},"bounds":[{"trait_bound":{"trait":{"path":"IntoIterator","id":75,"args":{"angle_bracketed":{"args":[],"constraints":[{"name":"Item","args":null,"binding":{"equality":{"type":{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"A"},"trait":{"path":"","id":75,"args":null}}}}}}]}}},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"45391":{"id":45391,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[767,1],"end":[780,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"ty