tability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"primitive":"u32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"45774":{"id":45774,"crate_id":0,"name":"lsx_vffint_s_w","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lsx\\generated.rs","begin":[4237,1],"end":[4239,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9406,"args":null}}]],"output":{"resolved_path":{"path":"m128","id":9409,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"6029":{"id":6029,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"resolved_path":{"path":"Wrapping","id":4335,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}},"trait":{"path":"BitAnd","id":2401,"args":null}}}}}},"27827":{"id":27827,"crate_id":0,"name":"fetch_xor","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3808,1],"end":[3825,2]},"visibility":"public","docs":"Bitwise \"xor\" with the current value.\n\nPerforms a bitwise \"xor\" operation on the current value and the argument `val`, and\nsets the new value to the result.\n\nReturns the previous value.\n\n`fetch_xor` takes an [`Ordering`] argument which describes the memory ordering\nof this operation. All ordering modes are possible. Note that using\n[`Acquire`] makes the store part of this operation [`Relaxed`], and\nusing [`Release`] makes the load part [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic operations on\n[`i128`].\n\n# Examples\n\n```\n#![feature(integer_atomics)]\n\nuse std::sync::atomic::{AtomicI128, Ordering};\n\nlet foo = AtomicI128::new(0b101101);\nassert_eq!(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);\nassert_eq!(foo.load(Ordering::SeqCst), 0b011110);\n```","links":{"`Acquire`":27450,"`Relaxed`":27451,"`i128`":212,"`Ordering`":8755,"`Release`":27452},"attrs":[{"other":"#[<cfg>(target_has_atomic = \"128\")]"},{"other":"#[<cfg_attr>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 99069, is_soft: false}, feature: \"integer_atomics\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["val",{"primitive":"i128"}],["order",{"resolved_path":{"path":"Ordering","id":8755,"args":null}}]],"output":{"primitive":"i128"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49625":{"id":49625,"crate_id":0,"name":"rotate_left","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[319,5],"end":[338,6]},"visibility":"public","docs":"Shifts the bits to the left by a specified amount, `n`,\nwrapping the truncated bits to the end of the resulting integer.\n\nPlease note this isn't the same operation as the `<<` shifting operator!\n\n# Examples\n\n```\nlet n = 0xaa00000000006e1i64;\nlet m = 0x6e10aa;\n\nassert_eq!(n.rotate_left(12), m);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"const_int_methods\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["n",{"primitive":"u32"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9880":{"id":9880,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\str\\lossy.rs","begin":[70,35],"end":[70,37]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 79, patch: 0})}, feature: \"utf8_chunks\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"'a","kind":{"lifetime":{"outlives":[]}}}],"where_predicates":[]},"provided_trait_methods":["assert_receiver_is_total_eq"],"trait":{"path":"Eq","id":41,"args":null},"for":{"resolved_path":{"path":"Utf8Chunk","id":8921,"args":{"angle_bracketed":{"args":[{"lifetime":"'a"}],"c