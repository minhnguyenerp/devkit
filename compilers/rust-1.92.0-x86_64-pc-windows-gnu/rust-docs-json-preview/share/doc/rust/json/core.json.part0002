re\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[8315,1],"end":[8317,2]},"visibility":"public","docs":"Compare packed half-precision (16-bit) floating-point elements in a and b, and store packed maximum\nvalues in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\nDoes not follow the IEEE Standard for Floating-Point Arithmetic (IEEE 754) maximum value when inputs are\nNaN or signed-zero values.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_maskz_max_ph)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vmaxph))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}]],"output":{"resolved_path":{"path":"__m128h","id":9310,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1083":{"id":1083,"crate_id":0,"name":"wrapping_abs","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[247,5],"end":[266,6]},"visibility":"public","docs":"Wrapping (modular) absolute value. Computes `self.abs()`, wrapping around at\nthe boundary of the type.\n\nThe only case where such wrapping can occur is when one takes the absolute value of the negative\nminimal value for the type; this is a positive value that is too large to represent in the type. In\nsuch a case, this function returns `MIN` itself.\n\n# Examples\n\n```\nassert_eq!(100i8.wrapping_abs(), 100);\nassert_eq!((-100i8).wrapping_abs(), 100);\nassert_eq!(i8::MIN.wrapping_abs(), i8::MIN);\nassert_eq!((-128i8).wrapping_abs() as u8, 128);\n```","links":{},"attrs":[{"other":"#[allow(unused_attributes)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"const_int_methods\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 13, patch: 0})}, feature: \"no_panic_abs\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22881":{"id":22881,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\any.rs","begin":[138,1],"end":[142,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"outlives":"'static"},{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Any","id":707,"args":null},"for":{"resolved_path":{"path":"Cell","id":8535,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"items":[704],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"44679":{"id":44679,"crate_id":0,"name":"lasx_xvbitseti_h","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[1921,1],"e