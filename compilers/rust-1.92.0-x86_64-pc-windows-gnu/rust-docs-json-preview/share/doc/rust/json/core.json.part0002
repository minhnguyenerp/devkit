":"_mm512_mask3_fmsubadd_pd","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[4378,1],"end":[4380,2]},"visibility":"public","docs":"Multiply packed double-precision (64-bit) floating-point elements in a and b, alternatively subtract and add packed elements in c from/to the intermediate result, and store the results in dst using writemask k (elements are copied from c when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask3_fmsubadd_pd&expand=2681)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfmsubadd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512d","id":9298,"args":null}}],["b",{"resolved_path":{"path":"__m512d","id":9298,"args":null}}],["c",{"resolved_path":{"path":"__m512d","id":9298,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}]],"output":{"resolved_path":{"path":"__m512d","id":9298,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18160":{"id":18160,"crate_id":0,"name":"shl","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\ops\\shift_scalar.rs","begin":[62,1],"end":[62,77]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i16"}}}]],"output":{"qualified_path":{"name":"Output","args":null,