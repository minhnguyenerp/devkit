asx\\generated.rs","begin":[3018,1],"end":[3020,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m256i","id":9397,"args":null}}],["b",{"resolved_path":{"path":"m256i","id":9397,"args":null}}]],"output":{"resolved_path":{"path":"m256i","id":9397,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5074":{"id":5074,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 60, patch: 0})}, feature: \"wrapping_int_assign_impl\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"MulAssign","id":2302,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"usize"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4335,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"usize"}}],"constraints":[]}}}},"items":[5073],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"26872":{"id":26872,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"RefUnwindSafe","id":681,"args":null},"for":{"resolved_path":{"path":"vector_unsigned_int","id":9436,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"48670":{"id":48670,"crate_id":0,"name":"align_offset","span":{"filename":"library\\core\\src\\ptr\\const_ptr.rs","begin":[1294,5],"end":[1312,6]},"visibility":"public","docs":"Computes the offset that needs to be applied to the pointer in order to make it aligned to\n`align`.\n\nIf it is not possible to align the pointer, the implementation returns\n`usize::MAX`.\n\nThe offset is expressed in number of `T` elements, and not bytes. The value returned can be\nused with the `wrapping_add` method.\n\nThere are no guarantees whatsoever that offsetting the pointer will not overflow or go\nbeyond the allocation that the pointer points into. It is up to the caller to ensure that\nthe returned offset is correct in all terms other than alignment.\n\n# Panics\n\nThe function panics if `align` is not a power-of-two.\n\n# Examples\n\nAccessing adjacent `u8` as `u16`\n\n```\n# unsafe {\nlet x = [5_u8, 6, 7, 8, 9];\nlet ptr = x.as_ptr();\nlet offset = ptr.align_offset(align_of::<u16>());\n\nif offset < x.len() - 1 {\n    let u16_ptr = ptr.add(offset).cast::<u16>();\n    assert!(*u16_ptr == u16::from_ne_bytes([5, 6]) || *u16_ptr == u16::from_ne_bytes([6, 7]));\n} else {\n    // while the pointer can be aligned via `offset`, it would point\n    // outside the allocation\n}\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 36, patch: 0})}, feature: \"align_offset\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["align",{"primitive":"usize"}]],"output":{"primitive":"usize"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[{"bound_predicate":{"type":{"generic