rns a new vector and does not mutate the original inputs"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[{"name":"OFFSET","kind":{"const":{"type":{"primitive":"usize"},"default":null}}}],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"7252":{"id":7252,"crate_id":0,"name":"Subnormal","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[1367,5],"end":[1367,14]},"visibility":"default","docs":"“Subnormal” or “denormal” floating point representation (less precise, relative to\ntheir magnitude, than [`Normal`]).\n\nSubnormal numbers are larger in magnitude than [`Zero`] but smaller in magnitude than all\n[`Normal`] numbers.\n\n[`Normal`]: Self::Normal\n[`Zero`]: Self::Zero","links":{"Self::Zero":7250,"Self::Normal":7251},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"variant":{"kind":"plain","discriminant":null}}},"29050":{"id":29050,"crate_id":0,"name":"fmt","span":{"filename":"library\\core\\src\\fmt\\float.rs","begin":[264,5],"end":[266,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["fmt",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"resolved_path":{"path":"Formatter","id":709,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"}],"constraints":[]}}}}}}]],"output":{"resolved_path":{"path":"Result","id":710,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"50848":{"id":50848,"crate_id":0,"name":"overflowing_mul","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[1269,5],"end":[1290,6]},"visibility":"public","docs":"Calculates the multiplication of `self` and `rhs`.\n\nReturns a tuple of the multiplication along with a boolean\nindicating whether an arithmetic overflow would occur. If an\noverflow would have occurred then the wrapped value is returned.\n\nIf you want the *value* of the overflow, rather than just *whether*\nan overflow occurred, see [`Self::carrying_mul`].\n\n# Examples\n\nPlease note that this example is shared among integer types, which is why `u32` is used.\n\n```\nassert_eq!(5u32.overflowing_mul(2), (10, false));\nassert_eq!(1_000_000_000u32.overflowing_mul(10), (1410065408, true));\n```","links":{"`Self::carrying_mul`":50847},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"const_wrapping_math\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 7, patch: 0})}, feature: \"wrapping\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"tuple":[{"generic":"Self"},{"primitive":"bool"}]},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"11103":{"id":11103,"crate_id":0,"name":"try_from","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[367,1],"end":[367,60]},"visibility":"default","docs":"Tries to create the target number type from a source\nnumber type. This returns an error if the source value\nis outside of the range of the target type.","links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"dep