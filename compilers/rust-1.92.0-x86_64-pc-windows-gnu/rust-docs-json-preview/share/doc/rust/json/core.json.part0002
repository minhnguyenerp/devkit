`\n[undefined behavior]: https://doc.rust-lang.org/reference/behavior-considered-undefined.html","links":{},"attrs":[{"other":"#[<cfg_attr>(miri, track_caller)]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["slice",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"slice":{"generic":"T"}}}}],["enable",{"resolved_path":{"path":"Mask","id":9461,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"isize"}},{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}}],["idxs",{"resolved_path":{"path":"Simd","id":9465,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"usize"}},{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}}],["or",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"7903":{"id":7903,"crate_id":0,"name":"copysignf32","span":{"filename":"library\\core\\src\\intrinsics\\mod.rs","begin":[3209,1],"end":[3209,49]},"visibility":"public","docs":"Copies the sign from `y` to `x` for `f32` values.\n\nThe stabilized version of this intrinsic is\n[`f32::copysign`](../../std/primitive.f32.html#method.copysign)","links":{},"attrs":[{"other":"#[rustc_nounwind]"},{"other":"#[rustc_intrinsic_const_stable_indirect]"},{"other":"#[rustc_intrinsic]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"primitive":"f32"}],["y",{"primitive":"f32"}]],"output":{"primitive":"f32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"29701":{"id":29701,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[221,1],"end":[225,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":