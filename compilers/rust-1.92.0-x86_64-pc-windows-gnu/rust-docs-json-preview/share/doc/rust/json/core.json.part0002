bility":"public","docs":"Round packed half-precision (16-bit) floating-point elements in a to the number of fraction bits\nspecified by imm8, and store the results in dst. Exceptions can be suppressed by passing _MM_FROUND_NO_EXC\nin the sae parameter\n\nRounding is done according to the imm8 parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] : round to nearest\n* [`_MM_FROUND_TO_NEG_INF`] : round down\n* [`_MM_FROUND_TO_POS_INF`] : round up\n* [`_MM_FROUND_TO_ZERO`] : truncate\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_roundscale_round_ph)","links":{"`_MM_FROUND_TO_POS_INF`":35150,"`_MM_SET_ROUNDING_MODE`":34890,"`_MM_FROUND_TO_NEAREST_INT`":35148,"`_MM_FROUND_CUR_DIRECTION`":35152,"`_MM_FROUND_TO_NEG_INF`":35149,"`_MM_FROUND_TO_ZERO`":35151},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vrndscaleph, IMM8 = 0, SAE = 8))]"},{"other":"#[rustc_legacy_const_generics(1, 2)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512h","id":9316,"args":null}}],["IMM8",{"primitive":"i32"}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512h","id":9316,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1162":{"id":1162,"crate_id":0,"name":"MIN","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2344,1],"end":[2354,2]},"visibility":"public","docs":"The smallest value that can be represented by this non-zero\ninteger type,\nequal to [`i32::MIN`].\n\nNote: While most integer types are defined for every whole\nnumber between `MIN` and `MAX`, signed non-zero integers are\na special case. They have a \"gap\" at 0.\n\n# Examples\n\n```\n# use std::num::NonZero;\n#\nassert_eq!(NonZero::<i32>::MIN.get(), i32::MIN);\n```","links":{"`i32::MIN`":220},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 70, patch: 0})}, feature: \"nonzero_min_max\"}}]"}],"deprecation":null,"inner":{"assoc_const":{"type":{"generic":"Self"},"value":"_"}}},"22960":{"id":22960,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[221,1],"end":[225,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"BorrowMut","id":687,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Ref","id":11840,"args":{"angle_bracketed":{"args":[{"lifetime":"'b"},{"type":{"generic":"T"}}],"constraints":[]}}}},"items":[685],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"44758":{"id":44758,"crate_id":0,"name":"lasx_xvslti_bu","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[2552,1],"end":[2555,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[rustc_legacy_const_generics(1)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"