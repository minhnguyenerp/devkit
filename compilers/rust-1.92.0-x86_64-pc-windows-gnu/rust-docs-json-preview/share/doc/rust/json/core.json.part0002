,"links":{"`_MM_FROUND_TO_POS_INF`":35150,"`_MM_SET_ROUNDING_MODE`":34890,"`_MM_FROUND_TO_NEAREST_INT`":35148,"`_MM_FROUND_NO_EXC`":35154,"`_MM_FROUND_TO_NEG_INF`":35149,"`_MM_FROUND_TO_ZERO`":35151,"`_MM_FROUND_CUR_DIRECTION`":35152},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfnmsub, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["c",{"resolved_path":{"path":"__m128h","id":9310,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9310,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1004":{"id":1004,"crate_id":0,"name":"ilog10","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[1186,5],"end":[1209,6]},"visibility":"public","docs":"Returns the base 10 logarithm of the number, rounded down.\n\n# Panics\n\nThis function will panic if `self` is zero.\n\n# Example\n\n```\nassert_eq!(10u128.ilog10(), 1);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 67, patch: 0})}, feature: \"int_log\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 67, patch: 0})}, feature: \"int_log\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without