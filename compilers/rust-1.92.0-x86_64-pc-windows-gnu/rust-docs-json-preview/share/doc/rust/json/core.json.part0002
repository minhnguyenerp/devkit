\\core\\src\\num\\saturating.rs","begin":[891,1],"end":[891,77]},"visibility":"public","docs":"Converts an integer from big endian to the target's endianness.\n\nOn big endian this is a no-op. On little endian the bytes are\nswapped.\n\n# Examples\n\n```\nuse std::num::Saturating;\n\nlet n = Saturating(0x1Au32);\n\nif cfg!(target_endian = \"big\") {\n    assert_eq!(<Saturating<u32>>::from_be(n), n)\n} else {\n    assert_eq!(<Saturating<u32>>::from_be(n), n.swap_bytes())\n}\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23812":{"id":23812,"crate_id":0,"name":"fold","span":{"filename":"library\\core\\src\\iter\\adapters\\filter_map.rs","begin":[142,5],"end":[147,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["init",{"generic":"Acc"}],["fold",{"generic":"Fold"}]],"output":{"generic":"Acc"},"is_c_variadic":false},"generics":{"params":[{"name":"Acc","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"Fold","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"Fold"},"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"gene