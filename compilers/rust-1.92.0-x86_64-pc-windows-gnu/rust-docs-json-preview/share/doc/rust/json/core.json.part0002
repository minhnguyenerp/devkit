: \"saturating_int_impl\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Mul","id":2290,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Saturating","id":1955,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}}}}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Saturating","id":1955,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}}}},"items":[4129,4130],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"25929":{"id":25929,"crate_id":0,"name":"RealmLocal","span":{"filename":"library\\core\\src\\net\\ip_addr.rs","begin":[224,5],"end":[224,15]},"visibility":"default","docs":"Realm-Local scope.","links":{},"attrs":[],"deprecation":null,"inner":{"variant":{"kind":"plain","discriminant":null}}},"47727":{"id":47727,"crate_id":0,"name":"Mask","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\simd\\num\\int.rs","begin":[411,1],"end":[411,72]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"resolved_path":{"path":"Mask","id":9461,"args":{"angle_bracketed":{"args":[{"type":{"qualified_path":{"name":"Mask","args":null,"self_type":{"primitive":"i8"},"trait":{"path":"SimdElement","id":9464,"args":null}}}},{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}}}}},"7982":{"id":7982,"crate_id":0,"name":"assume_init_ref","span":{"filename":"library\\core\\src\\mem\\maybe_uninit.rs","begin":[870,5],"end":[877,6]},"visibility":"public","docs":"Gets a shared reference to the contained value.\n\nThis can be useful when we want to access a `MaybeUninit` that has been\ninitialized but don't have ownership of the `MaybeUninit` (preventing the use\nof `.assume_init()`).\n\n# Safety\n\nCalling this when the content is not yet fully initialized causes undefined\nbehavior: it is up to the caller to guarantee that the `MaybeUninit<T>` really\nis in an initialized state.\n\n# Examples\n\n### Correct usage of this method:\n\n```rust\nuse std::mem::MaybeUninit;\n\nlet mut x = MaybeUninit::<Vec<u32>>::uninit();\n# let mut x_mu = x;\n# let mut x = &mut x_mu;\n// Initialize `x`:\nx.write(vec![1, 2, 3]);\n// Now that our `MaybeUninit<_>` is known to be initialized, it is okay to\n// create a shared reference to it:\nlet x: &Vec<u32> = unsafe {\n    // SAFETY: `x` has been initialized.\n    x.assume_init_ref()\n};\nassert_eq!(x, &vec![1, 2, 3]);\n# // Prevent leaks for Miri\n# unsafe { MaybeUninit::assume_init_drop(&mut x_mu); }\n```\n\n### *Incorrect* usages of this method:\n\n```rust,no_run\nuse std::mem::MaybeUninit;\n\nlet x = MaybeUninit::<Vec<u32>>::uninit();\nlet x_vec: &Vec<u32> = unsafe { x.assume_init_ref() };\n// We have created a reference to an uninitialized vector! This is undefined behavior. ⚠️\n```\n\n```rust,no_run\nuse std::{cell::Cell, mem::MaybeUninit};\n\nlet b = MaybeUninit::<Cell<bool>>::uninit();\n// Initialize the `MaybeUninit` using `Cell::set`:\nunsafe {\n    b.assume_init_ref().set(true);\n    //^^^^^^^^^^^^^^^ Reference to an uninitialized `Cell<bool>`: UB!\n}\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"const_maybe_uninit_assume_init_ref\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 55, patch: 0})}, feature: \"maybe_uninit_ref\"}}]"},{"other":"#[attr = Inline(Always)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"T"}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"29780":{"id":29780,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[785,1],"end":[791,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"ChunkByMut","id":12000,"args":{"angle_bracketed":{"args":[{"lifetime":"'a"},{"type":{"generic":"T"}},{"type":{"generic":"P"}}],"constraints":[]}}}},"items":[693],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"11833":{"id":11833,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"I","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"I"},"bounds":[{"trait_bound":{"trait":{"path":"Send","id":5,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Send","id":5,"args":null},"for":{"resolved_path":{"path":"FromIter","id":8529,"args":{"angle_bracketed":{"args":[{"type":{"generic":"I"}}],"constraints":[]}}}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"15684":{"id":15684,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[72,1],"end":[72,71]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inne