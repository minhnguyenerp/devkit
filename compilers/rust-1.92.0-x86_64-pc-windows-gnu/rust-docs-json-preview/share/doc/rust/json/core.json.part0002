function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["f",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"resolved_path":{"path":"$crate::fmt::Formatter","id":709,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"}],"constraints":[]}}}}}}]],"output":{"resolved_path":{"path":"$crate::fmt::Result","id":710,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"50203":{"id":50203,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\any.rs","begin":[138,1],"end":[142,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"outlives":"'static"},{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Any","id":707,"args":null},"for":{"primitive":"u16"},"items":[704],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"10458":{"id":10458,"crate_id":0,"name":"from","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[90,1],"end":[90,25]},"visibility":"default","docs":"Converts a [`bool`] to [`u128`] losslessly.\nThe resulting value is `0` for `false` and `1` for `true` values.\n\n# Examples\n\n```\nassert_eq!(u128::from(true), 1);\nassert_eq!(u128::from(false), 0);\n```","links":{"`u128`":248,"`bool`":10449},"attrs":[{"other":"#[attr = Inline(Always)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["small",{"primitive":"bool"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is