{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}}}},"items":[18225,18226],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"40025":{"id":40025,"crate_id":0,"name":"_mm512_mask_shldv_epi64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512vbmi2.rs","begin":[513,1],"end":[518,2]},"visibility":"public","docs":"Concatenate packed 64-bit integers in a and b producing an intermediate 128-bit result. Shift the result left by the amount specified in the corresponding element of c, and store the upper 64-bits in dst using writemask k (elements are copied from a when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask_shldv_epi64&expand=5085)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpshldvq))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512vbmi2"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35780,"args":null}}],["b",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}],["c",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}]],"output":{"resolved_path":{"path":"__m512i","id":9292,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22078":{"id":22078,"crate_id":0,"name":"get_unchecked","span":{"filename":"library\\core\\src\\slice\\index.rs","begin":[680,5],"end":[683,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs