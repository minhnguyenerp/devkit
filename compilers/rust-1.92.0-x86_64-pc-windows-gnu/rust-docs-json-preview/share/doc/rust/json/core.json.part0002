\core_arch\\src\\x86\\sse.rs","begin":[464,1],"end":[466,2]},"visibility":"public","docs":"Checks if the lowest `f32` of both inputs are ordered. The lowest 32 bits of\nthe result will be `0xffffffff` if neither of `a.extract(0)` or\n`b.extract(0)` is a NaN, or `0` otherwise. The upper 96 bits of the result\nare the upper 96 bits of `a`.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_cmpord_ss)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(cmpordss))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},{"target_feature":{"enable":["sse"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128","id":9277,"args":null}}],["b",{"resolved_path":{"path":"__m128","id":9277,"args":null}}]],"output":{"resolved_path":{"path":"__m128","id":9277,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"16852":{"id":16852,"crate_id":0,"name":"shl","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"u16"}]],"output":{"primitive":"u64"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"38650":{"id":38650,"crate_id":0,"name":"_MM_PERM_DDCD","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[42339,1],"end":[42339,47]},"visibility":"public","docs":null,"links":{},"