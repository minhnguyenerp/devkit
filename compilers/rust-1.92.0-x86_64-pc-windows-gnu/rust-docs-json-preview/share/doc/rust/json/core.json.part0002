unnel_shifts)]\nlet a = 0xaa00000000006e1usize;\nlet b = 0x2fe78e45983acd98usize;\nlet m = 0x6e12fe78e45983ac;\n\nassert_eq!(a.funnel_shr(b, 12), m);\n```","links":{"Self::rotate_right":50767},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 145686, is_soft: false}, feature: \"funnel_shifts\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 145686, is_soft: false}, feature: \"funnel_shifts\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}],["n",{"primitive":"u32"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"11024":{"id":11024,"crate_id":0,"name":"Error","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[356,1],"end":[356,49]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"resolved_path":{"path":"TryFromIntError","id":672,"args":null}}}}},"32822":{"id":32822,"crate_id":0,"name":"vreinterpretq_u32_u16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[45755,1],"end":[45757,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpretq_u32_u16)","links":{},"attrs":[{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aa