"public","docs":"Creates a new `Duration` from the specified number of nanoseconds.\n\n# Panics\n\nPanics if the given number of nanoseconds is greater than [`Duration::MAX`].\n\n# Examples\n\n```\n#![feature(duration_from_nanos_u128)]\nuse std::time::Duration;\n\nlet nanos = 10_u128.pow(24) + 321;\nlet duration = Duration::from_nanos_u128(nanos);\n\nassert_eq!(10_u64.pow(15), duration.as_secs());\nassert_eq!(321, duration.subsec_nanos());\n```","links":{"`Duration::MAX`":30510},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 139201, is_soft: false}, feature: \"duration_from_nanos_u128\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 139201, is_soft: false}, feature: \"duration_from_nanos_u128\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["nanos",{"primitive":"u128"}]],"output":{"resolved_path":{"path":"Duration","id":8927,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"12569":{"id":12569,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\types.rs","begin":[1,1],"end":[76,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[doc(cfg(target_arch = \"loongarch64\"))]"},{"other":"#[allow(non_camel_case_types)]"},{"other":"#[allow(clippy :: missing_inline_in_public_items)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Copy","id