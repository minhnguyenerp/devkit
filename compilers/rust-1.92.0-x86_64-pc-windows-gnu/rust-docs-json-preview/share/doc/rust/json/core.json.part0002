o the [null pointer optimization],\n`NonZeroI16` and `Option<NonZeroI16>`\nare guaranteed to have the same size and alignment:\n\n```\nuse std::num::NonZeroI16;\n\nassert_eq!(size_of::<NonZeroI16>(), size_of::<Option<NonZeroI16>>());\nassert_eq!(align_of::<NonZeroI16>(), align_of::<Option<NonZeroI16>>());\n```\n\n# Compile-time creation\n\nSince both [`Option::unwrap()`] and [`Option::expect()`] are `const`, it is possible to\ndefine a new\n`NonZeroI16`\nat compile time via:\n```\nuse std::num::NonZeroI16;\n\nconst TEN: NonZeroI16 = NonZeroI16::new(10).expect(\"ten is non-zero\");\n```\n\n[null pointer optimization]: crate::option#representation","links":{"crate::option#representation":816,"`Option::unwrap()`":1938,"`i16`":218,"`Option::expect()`":1939},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 34, patch: 0})}, feature: \"signed_nonzero\"}}]"}],"deprecation":null,"inner":{"type_alias":{"type":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"23745":{"id":23745,"crate_id":0,"name":"try_fold","span":{"filename":"library\\core\\src\\iter\\adapters\\enumerate.rs","begin":[106,5],"end":[126,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["init",{"generic":"Acc"}],["fold",{"generic":"Fold"}]],"output":{"generic":"R"},"is_c_variadic":false},"generics":{"params":[{"name":"Acc","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"Fold","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"R","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"Self"},"bounds":[