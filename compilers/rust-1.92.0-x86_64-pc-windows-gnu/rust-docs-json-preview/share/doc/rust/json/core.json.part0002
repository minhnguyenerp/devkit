, and code should not assume that it is equivalent to `[i16; 64]`.","links":{},"attrs":[{"other":"#[allow(non_camel_case_types)]"}],"deprecation":null,"inner":{"type_alias":{"type":{"resolved_path":{"path":"$crate::simd::Mask","id":9461,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}},{"const":{"expr":"$num_elements","value":null,"is_literal":true}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"7118":{"id":7118,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\iter\\traits\\accum.rs","begin":[204,1],"end":[204,77]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 14, patch: 0})}, feature: \"wrapping_iter_arith\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"'a","kind":{"lifetime":{"outlives":[]}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Sum","id":4285,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":"'a","is_mutable":false,"type":{"resolved_path":{"path":"Wrapping","id":4335,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4335,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}},"items":[7117],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"28916":{"id":28916,"crate_id":0,"name":"fmt","span":{"filename":"library\\core\\src\\alloc\\mod.rs","begin":[44,5],"end":[46,6]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["f",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"resolved_path":{"path":"fmt::Formatter","id":709,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"}],"constraints":[]}}}}}}]],"output":{"resolved_path":{"path":"fmt::Result","id":710,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"50714":{"id":50714,"crate_id":0,"name":"div_euclid","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[420,5],"end":[439,6]},"visibility":"public","docs":"Calculates the quotient of Euclidean division of `self` by `rhs`.\n\nThis computes the integer `q` such that `self = q * rhs + r`, with\n`r = self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.\n\nIn other words, the result is `self / rhs` rounded to the integer `q`\nsuch that `self >= q * rhs`.\nIf `self > 0`, this is equal to rounding towards zero (the default in Rust);\nif `self < 0`, this is equal to rounding away from zero (towards +/- infinity).\nIf `rhs > 0`, this is equal to rounding towards -infinity;\nif `rhs < 0`, this is equal to rounding towards +infinity.\n\n# Panics\n\nThis function will panic if `rhs` is zero or if `self` is `Self::MIN`\nand `rhs` is -1. This behavior is not affected by the `overflow-checks` flag.\n\n# Examples\n\n```\nlet a: isize = 7; // or any other integer type\nlet b = 4;\n\nassert_eq!(a.div_euclid(b), 1); // 7 >= 4 * 1\nassert_eq!(a.div_euclid(-b), -1); // 7 >= -4 * -1\nassert_eq!((-a).div_euclid(b), -2); // -7 >= 4 * -2\nassert_eq!((-a).div_euclid(-b), 2); // -7 >= -4 * 2\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 52, patch: 0})}, feature: \"const_euclidean_int_methods\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 38, patch: 0})}, feature: \"euclidean_division\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10969":{"id":10969,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\vendor\\x86.rs","begin":[60,5],"end":[60,50]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"__m128i","id":9274,"args":null}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"isizex2","id":10966,"args":null}},"items":[10968],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"32767":{"id":32767,"crate_id":0,"name":"vreinterpret_s8_s64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[44600,1],"end":[44602,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpret_s8_s64)","links":{},"attrs":[{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(nop))]"},{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVers