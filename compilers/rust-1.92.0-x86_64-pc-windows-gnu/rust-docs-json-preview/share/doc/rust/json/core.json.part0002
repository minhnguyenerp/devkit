]},"visibility":"public","docs":"Scatter 32-bit integers from a into memory using 32-bit indices. 32-bit elements are stored at addresses starting at base_addr and offset by each 32-bit element in vindex (each index is scaled by the factor in scale). scale should be 1, 2, 4 or 8.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_i32scatter_epi32&expand=3032)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpscatterdd, SCALE = 1))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["slice",{"raw_pointer":{"is_mutable":true,"type":{"primitive":"i32"}}}],["offsets",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}],["src",{"resolved_path":{"path":"__m512i","id":9292,"args":null}}],["SCALE",{"primitive":"i32"}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"18890":{"id":18890,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u128"},"trait":{"path":"Shr","id":4650,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}}}}}}},"40688":{"id":40688,"crate_id":0,"name":"_mm512_fmsub_ph","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[5734,1],"end":[5736,2]},"visibility":"public","docs":"Multiply packed half-precision (16-bit) floating-point elements in a and b, subtract packed elements\nin c from the intermediate result, and store the results in dst.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_fmsub_ph)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfmsub))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512h","id":9316,"args":null}}],["b",{"resolved_path":{"path":"__m512h","id":9316,"args":null}}],["c",{"resolved_path":{"path":"__m512h","id":9316,"args":null}}]],"output":{"resolved_path":{"path":"__m512h","id":9316,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"943":{"id":943,"crate_id":0,"name":"trailing_zeros","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2257,1],"end":[2267,2]},"visibility":"public","docs":"Returns the number of trailing zeros in the binary representation\nof `self`.\n\nOn many architectures, this function can perform better than `trailing_zeros()` on the underlying integer type, as special handling of zero can be avoided.\n\n# Examples\n\n```\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet n = NonZero::<u64>::new(0b0101000)?;\n\nassert_eq!(n.trailing_zeros(), 3);\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 53, patch: 0})}, feature: \"nonzero_leading_trailing_zeros\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {le