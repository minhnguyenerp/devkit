nding element in `min` if the element is less\nthan `min`.  Otherwise returns the element in `self`.","links":{},"attrs":[{"must_use":{"reason":"method returns a new vector and does not mutate the original value"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["min",{"generic":"Self"}],["max",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":false}}},"8645":{"id":8645,"crate_id":0,"name":"SkipWhile","span":{"filename":"library\\core\\src\\iter\\adapters\\skip_while.rs","begin":[17,1],"end":[21,2]},"visibility":"public","docs":"An iterator that rejects elements while `predicate` returns `true`.\n\nThis `struct` is created by the [`skip_while`] method on [`Iterator`]. See its\ndocumentation for more.\n\n[`skip_while`]: Iterator::skip_while\n[`Iterator`]: trait.Iterator.html","links":{"Iterator::skip_while":24221},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"must_use":{"reason":"iterators are lazy and do nothing unless consumed"}}],"deprecation":null,"inner":{"struct":{"kind":{"plain":{"fields":[],"has_stripped_fields":true}},"generics":{"params":[{"name":"I","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"P","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"impls":[11888,12653,13098,13523,24222,24223,24224,24225,24226,24227,24228,24229,24230,24231,24232,8646,24234,24240,24241]}}},"30443":{"id":30443,"crate_id":0,"name":"invalid","span":{"filename":"library\\core\\src\\str\\lossy.rs","begin":[103,5],"end":[105,6]},"visibility":"public","docs":"Returns the invalid sequence that caused a failure.\n\nThe returned slice will have a maximum length of 3 and starts after the\nsubstring given by [`valid`]. Decoding will resume after this sequence.\n\nIf empty, this is the last chunk in the string. If non-empty, an\nunexpected byte was encountered or the end of the input was reached\nunexpectedly.\n\nLossy decoding would replace this sequence with [`U+FFFD REPLACEMENT\nCHARACTER`].\n\n[`valid`]: Self::valid\n[`U+FFFD REPLACEMENT CHARACTER`]: crate::char::REPLACEMENT_CHARACTER","links":{"crate::char::REPLACEMENT_CHARACTER":23125,"Self::valid":30442},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 79, patch: 0})}, feature: \"utf8_chunks\"}}]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"borrowed_ref":{"lifetime":"'a","is_mutable":false,"type":{"slice":{"primitive":"u8"}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"12496":{"id":12496,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\mod.rs","begin":[749,10],"end":[749,14]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 136306, is_soft: false}, feature: \"stdarch_neon_f16\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Copy","id":1,"args":null},"for":{"resolved_path":{"path":"float16x4x2_t","id":9184,"args":null}},"items":[],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"34294":{"id":34294,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\clone.rs","begin":[515,1],"end":[521,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation