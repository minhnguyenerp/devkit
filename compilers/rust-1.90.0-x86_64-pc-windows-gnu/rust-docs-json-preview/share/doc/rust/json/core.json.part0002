 {reason: None,\nissue: 136909, is_soft: false},\nfeature: \"isolate_most_least_significant_one\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10957":{"id":10957,"crate_id":0,"name":"from","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\vendor\\x86.rs","begin":[60,5],"end":[60,50]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["value",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}]],"output":{"resolved_path":{"path":"isizex2","id":10955,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"32755":{"id":32755,"crate_id":0,"name":"vreinterpretq_p8_u16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[50651,1],"end":[50653,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpretq_p8_u16)","links":{},"attrs":[{"other":"#[<cfg>(target_endian = \"little\")]"},{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(nop))]"},{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"uint16x8_t","id":9007,"args":null}}]],"output":{"resolved_path":{"path":"poly8x16_t","id":9001,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"14808":{"id":14808,"crate_id":0,"name":"div","span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[526,1],"end":[526,37]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"f32"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"f32"},"trait":{"path":"Div","id":1404,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"f32"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"36606":{"id":36606,"crate_id":0,"name":"_mm512_mask_cvtusepi64_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[14177,1],"end":[14179,2]},"visibility":"public","docs":"Convert packed unsigned 64-bit integers in a to packed unsigned 32-bit integers with unsigned saturation, and store the results in dst using writemask k (elements are copied from src when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask_cvtusepi64_epi32&expand=2088)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpmovusqd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m256i","id":9280,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m512i","id":9289,"args":null}}]],"output":{"resolved_path":{"path":"__m256i","id":9280,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18659":{"id":18659,"crate_id":0,"name":"shr","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i8"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u32"},"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"40457":{"id":40457,"crate_id":0,"name":"_mm_maskz_mul_pch","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[2618,1],"end":[2620,2]},"visibility":"public","docs":"Multiply packed complex numbers in a and b, and store the results in dst using zeromask k (the element\nis zeroed out when corresponding mask bit is not set). Each complex number is composed of two adjacent\nhalf-precision (16-bit) floating-point elements, which defines the complex number `complex = vec.fp16[0] + i * vec.fp16[1]`.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_maskz_mul_pch)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfmulcph))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}]],"output":{"resolved_path":{"path":"__m128h","id":9307,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22510":{"id":22510,"crate_id":0,"name":"CommercialAt","span":{"filename":"library\\core\\src\\ascii\\ascii_char.rs","begin":[256,5],"end":[256,22]},"visibility":"default","docs":"U+0040","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 110998, is_soft: false}, feature: \"ascii_char_variants\"}}]"}],"deprecation":null,"inner":{"variant":{"kind":"plain","discriminant":{"expr":"64","value":"64"}}}},"712":{"id":712,"crate_id":0,"name":"Debug","span":{"filename":"library\\core\\src\\fmt\\mod.rs","begin":[872,1],"end":[904,2]},"visibility":"public","docs":"`?` formatting.\n\n`Debug` should format the output in a programmer-facing, debugging context.\n\nGenerally speaking, you should just `derive` a `Debug` implementation.\n\nWhen used with the alternate format specifier `#?`, the output is pretty-printed.\n\nFor more information on formatters, see [the module-level documentation][module].\n\n[module]: ../../std/fmt/index.html\n\nThis trait can be used with `#[derive]` if all fields implement `Debug`. When\n`derive`d for structs, it will use the name of the `struct`, then `{`, then a\ncomma-separated list of each field's name and `Debug` value, then `}`. For\n`enum`s, it will use the name of the variant and, if applicable, `(`, then the\n`Debug` values of the fields, then `)`.\n\n# Stability\n\nDerived `Debug` formats are not stable, and so may change with future Rust\nversions. Additionally, `Debug` implementations of types provided by the\nstandard library (`std`, `core`, `alloc`, etc.) are not stable, and\nmay also change with future Rust versions.\n\n# Examples\n\nDeriving an implementation:\n\n```\n#[derive(Debug)]\nstruct Point {\n    x: i32,\n    y: i32,\n}\n\nlet origin = Point { x: 0, y: 0 };\n\nassert_eq!(\n    format!(\"The origin is: {origin:?}\"),\n    \"The origin is: Point { x: 0, y: 0 }\",\n);\n```\n\nManually implementing:\n\n```\nuse std::fmt;\n\nstruct Point {\n    x: i32,\n    y: i32,\n}\n\nimpl fmt::Debug for Point {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.debug_struct(\"Point\")\n         .field(\"x\", &self.x)\n         .field(\"y\", &self.y)\n         .finish()\n    }\n}\n\nlet origin = Point { x: 0, y: 0 };\n\nassert_eq!(\n    format!(\"The origin is: {origin:?}\"),\n    \"The origin is: Point { x: 0, y: 0 }\",\n);\n```\n\nThere are a number of helper methods on the [`Formatter`] struct to help you with manual\nimplementations, such as [`debug_struct`].\n\n[`debug_struct`]: Formatter::debug_struct\n\nTypes that do not wish to use the standard suite of debug representations\nprovided by the `Formatter` trait (`debug_struct`, `debug_tuple`,\n`debug_list`, `debug_set`, `debug_map`) can do something totally custom by\nmanually writing an arbitrary representation to the `Formatter`.\n\n```\n# use std::fmt;\n# struct Point {\n#     x: i32,\n#     y: i32,\n# }\n#\nimpl fmt::Debug for Point {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"Point [{} {}]\", self.x, self.y)\n    }\n}\n```\n\n`Debug` implementations using either `derive` or the debug builder API\non [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`.\n\nPretty-printing with `#?`:\n\n```\n#[derive(Debug)]\nstruct Point {\n    x: i32,\n    y: i32,\n}\n\nlet origin = Point { x: 0, y: 0 };\n\nlet expected = \"The origin is: Point {\n    x: 0,\n    y: 0,\n}\";\nassert_eq!(format!(\"The origin is: {origin:#?}\"), expected);\n```","links":{"`Formatter`":709,"Formatter::debug_struct":27937},"attrs":[{"other":"#[rustc_on_unimplemented(on(crate_local, note =\n\"add `#[derive(Debug)]` to `{Self}` or manually `impl {This} for {Self}`\"),\non(from_desugaring = \"FormatLiteral\", label =\n\"`{Self}` cannot be formatted using `{{:?}}` because it doesn't implement `{This}`\"),\nmessage = \"`{Self}` doesn't implement `{This}`\")]"},{"other":"#[doc(alias = \"{:?}\")]"},{"other":"#[rustc_diagnostic_item = \"Debug\"]"},{"other":"#[rustc_trivial_field_reads]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"trait":{"is_auto":false,"is_unsafe":false,"is_dyn_compatible":true,"items":[27936],"generics":{"params":[],"where_predicates":[]},"bounds":[{"trait_bound":{"trait":{"path":"PointeeSized","id":7292,"args":null},"generic_params":[],"modifier":"none"}}],"implementations":[711,752,782,1336,2230,4616,7276,7581,7949,8011,8051,8089,8132,8167,8211,8328,28242,9918,9941,11317,11615,11636,11676,11700,11724,11744,11767,11790,13864,21555,21585,21745,21824,21906,21965,22025,22100,22159,22273,28244,28246,28248,22376,22422,22442,28250,22617,226