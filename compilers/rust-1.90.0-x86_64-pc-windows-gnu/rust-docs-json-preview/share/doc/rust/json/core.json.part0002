{"id":30796,"crate_id":0,"name":"ready","span":{"filename":"library\\core\\src\\task\\ready.rs","begin":[50,1],"end":[57,2]},"visibility":"public","docs":"Extracts the successful type of a [`Poll<T>`].\n\nThis macro bakes in propagation of [`Pending`] signals by returning early.\n\n[`Poll<T>`]: crate::task::Poll\n[`Pending`]: crate::task::Poll::Pending\n\n# Examples\n\n```\nuse std::task::{ready, Context, Poll};\nuse std::future::{self, Future};\nuse std::pin::Pin;\n\npub fn do_poll(cx: &mut Context<'_>) -> Poll<()> {\n    let mut fut = future::ready(42);\n    let fut = Pin::new(&mut fut);\n\n    let num = ready!(fut.poll(cx));\n    # let _ = num;\n    // ... use num\n\n    Poll::Ready(())\n}\n```\n\nThe `ready!` call expands to:\n\n```\n# use std::task::{Context, Poll};\n# use std::future::{self, Future};\n# use std::pin::Pin;\n#\n# pub fn do_poll(cx: &mut Context<'_>) -> Poll<()> {\n    # let mut fut = future::ready(42);\n    # let fut = Pin::new(&mut fut);\n    #\nlet num = match fut.poll(cx) {\n    Poll::Ready(t) => t,\n    Poll::Pending => return Poll::Pending,\n};\n    # let _ = num; // to silence unused warning\n    # // ... use num\n    #\n    # Poll::Ready(())\n# }\n```","links":{"crate::task::Poll::Pending":30602,"crate::task::Poll":8936},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 64, patch: 0})}, feature: \"ready_macro\"}}]"},{"other":"#[attr = MacroTransparency(SemiOpaque)]"}],"deprecation":null,"inner":{"macro":"macro ready($e:expr) {\n    ...\n}"}},"12849":{"id":12849,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Sync","id":9,"args":null},"for":{"resolved_path":{"path":"int64x1x3_t","id":9220,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"346