own and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask_mul_round_pd&expand=3935)","links":{"`_MM_FROUND_TO_POS_INF`":35081,"`_MM_SET_ROUNDING_MODE`":34821,"`_MM_FROUND_TO_NEAREST_INT`":35079,"`_MM_FROUND_NO_EXC`":35085,"`_MM_FROUND_TO_NEG_INF`":35080,"`_MM_FROUND_TO_ZERO`":35082,"`_MM_FROUND_CUR_DIRECTION`":35083},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vmulpd, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m512d","id":9295,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m512d","id":9295,"args":null}}],["b",{"resolved_path":{"path":"__m512d","id":9295,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512d","id":9295,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18300":{"id":18300,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr =