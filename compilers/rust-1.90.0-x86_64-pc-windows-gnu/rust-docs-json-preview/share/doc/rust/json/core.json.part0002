}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"isize"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"11024":{"id":11024,"crate_id":0,"name":"try_from","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[357,1],"end":[357,55]},"visibility":"default","docs":"Tries to create the target number type from a source\nnumber type. This returns an error if the source value\nis outside of the range of the target type.","links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["u",{"primitive":"i128"}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"generic":"Self"}},{"type":{"qualified_path":{"name":"Error","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":163,"args":null}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"32822":{"id":32822,"crate_id":0,"name":"vreinterpret_u8_p16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[53862,1],"end":[53864,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpret_u8_p16)","links":{},"attrs":[{"other":"#[<cfg>(target_endian = \"little\")]"},{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(nop))]"},{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable