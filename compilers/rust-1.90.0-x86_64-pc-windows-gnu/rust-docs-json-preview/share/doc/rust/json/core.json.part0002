 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["slice",{"raw_pointer":{"is_mutable":true,"type":{"primitive":"f64"}}}],["offsets",{"resolved_path":{"path":"__m512i","id":9289,"args":null}}],["src",{"resolved_path":{"path":"__m512d","id":9295,"args":null}}],["SCALE",{"primitive":"i32"}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"18811":{"id":18811,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u64"},"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}}],"constraints":[]}}}}}}}},"40609":{"id":40609,"crate_id":0,"name":"_mm_mask3_fmadd_round_sh","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[5567,1],"end":[5583,2]},"visibility":"public","docs":"Multiply the lower half-precision (16-bit) floating-point elements in a and b, and add the intermediate\nresult to the lower element in c. Store the result in the lower element of dst using writemask k (the element\nis copied from c when the mask bit 0 is not set), and copy the upper 7 packed elements from c to the\nupper elements of dst.\n\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_mask3_fmadd_round_sh)","links":{"`_MM_FROUND_TO_POS_INF`":35081,"`_MM_SET_ROUNDING_MODE`":34821,"`_MM_FROUND_TO_NEAREST_INT`":35079,"`_MM_FROUND_NO_EXC`":35085,"`_MM_FROUND_TO_NEG_INF`":35080,"`_MM_FROUND_TO_ZERO`":35082,"`_MM_FROUND_CUR_DIRECTION`":35083},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfmadd, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["c",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9307,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"864":{"id":864,"crate_id":0,"name":"leading_zeros","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2218,1],"end":[2228,2]},"visibility":"public","docs":"Returns the number of leading zeros in the binary representation of `self`.\n\nOn many architectures, this function can perform better than `leading_zeros()` on the underlying integer type, as special handling of zero can be avoided.\n\n# Examples\n\n```\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet n = NonZero::<u16>::new(u16::MAX)?;\n\nassert_eq!(n.leading_zeros(), 0);\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 53, patch: 0})}, feature: \"nonzero_leading_trailing_zeros\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 53, patch: 0})}, feature: \"nonzero_leading_trailing_zeros\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"primitive":"u32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44460":{"id":44460,"crate_id":0,"name":"vsx","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\powerpc\\vsx.rs","begin":[1,1],"end":[240,2]},"visibility":{"restricted":{"parent":34642,"path":"::core_arch::powerpc"}},"docs":"PowerPC Vector Scalar eXtensions (VSX) intrinsics.\n\nThe references are: [POWER ISA v2.07B (for POWER8 & POWER8 with NVIDIA\nNVlink)] and [POWER ISA v3.0B (for POWER9)].\n\n[POWER ISA v2.07B (for POWER8 & POWER8 with NVIDIA NVlink)]: https://ibm.box.com/s/jd5w15gz301s5b5dt375mshpq9c3lh4u\n[POWER ISA v3.0B (for POWER9)]: https://ibm.box.com/s/1hzcwkwf8rbju5h9iyf44wm94amnlcrv","links":{},"attrs":[{"other":"#[allow(non_camel_case_types)]"}],"deprecation":null,"inner":{"module":{"is_crate":false,"items":[9379,9382,9385,9388,44457,44458,44459],"is_stripped":true}}},"4715":{"id":4715,"crate_id":0,"name":"shr","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[227,1],"end":[227,69]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr 