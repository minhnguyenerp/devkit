e(result_option_map_or_default)]\n\nlet x: Option<&str> = Some(\"hi\");\nlet y: Option<&str> = None;\n\nassert_eq!(x.map_or_default(|x| x.len()), 2);\nassert_eq!(y.map_or_default(|y| y.len()), 0);\n```\n\n[default value]: Default::default","links":{"Default::default":11324,"`Some`":83,"`None`":81},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143956, is_soft: false}, feature: \"const_option_ops\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 138099, is_soft: false}, feature: \"result_option_map_or_default\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["f",{"generic":"F"}]],"output":{"generic":"U"},"is_c_variadic":false},"generics":{"params":[{"name":"U","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"F","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"U"},"bounds":[{"trait_bound":{"trait":{"path":"Default","id":65,"args":null},"generic_params":[],"modifier":"maybe_const"}}],"generic_params":[]}},{"bound_predicate":{"type":{"generic":"F"},"bounds":[{"trait_bound":{"trait":{"path":"FnOnce","id":19,"args":{"parenthesized":{"inputs":[{"generic":"T"}],"output":{"generic":"U"}}}},"generic_params":[],"modifier":"maybe_const"}}],"generic_params":[]}}]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"47867":{"id":47867,"crate_id":0,"name":"reduce_or","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\simd\\num\\uint.rs","begin":[262,1],"end":[262,72]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"qualified_path":{"name":"Scalar","a