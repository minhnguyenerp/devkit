he LHS\nbeing returned to the other end. The primitive integer\ntypes all implement a [`rotate_right`](Self::rotate_right) function,\nwhich may be what you want instead.\n\n# Examples\n\n```\nassert_eq!(128usize.wrapping_shr(7), 1);\nassert_eq!(128usize.wrapping_shr(128), 128);\n```","links":{"Self::rotate_right":50708},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"const_wrapping_math\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 2, patch: 0})}, feature: \"num_wrapping\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"u32"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"11036":{"id":11036,"crate_id":0,"name":"try_from","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[360,1],"end":[360,39]},"visibility":"default","docs":"Tries to create the target number type from a source\nnumber type. This returns an error if the source value\nis outside of the range of the target type.","links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["u",{"primitive":"u8"}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"generic":"Self"}},{"type":{"qualified_path":{"name":"Error","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":163,"args":null}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"32834":{"id":32834,"crate_id":0,"name":"vreinterpretq_u32_p16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[54443,1],"end":[54445,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpretq_u32_p16)","links":{},"attrs":[{"other":"#[<cfg>(target_endian = \"little\")]"},{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(nop))]"},{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"poly16x8_t","id":9010,"args":null}}]],"output":{"resolved_path":{"path":"uint32x4_t","id":9016,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"14887":{"id":14887,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[613,1],"end":[616,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"usize"},"trait":{"path":"Rem","id":1411,"args":null}}}}}},"36685":{"id":36685,"crate_id":0,"name":"_mm512_maskz_cvtt_roundps_epu32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[15681,1],"end":[15688,2]},"visibility":"public","docs":"Convert packed single-precision (32-bit) floating-point elements in a to packed unsigned 32-bit integers with truncation, and store the results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\\\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_maskz_cvtt_roundps_epu32&expand=1924)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vcvttps2udq, SAE = 8))]"},{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask16","id":35708,"args":null}}],["a",{"resolved_path":{"path":"__m512","id":9292,"args":null}}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512i","id":9289,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18738":{"id":18738,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u64"}}},"items":[18736,18737],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"40536":{"id":40536,"crate_id":0,"name":"_mm512_conj_pch","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[4019,1],"end":[4021,2]},"visibility":"public","docs":"Compute the complex conjugates of complex numbers in a, and store the results in dst. Each complex number\nis composed of two adjacent half-precision (16-bit) floating-point elements, which defines the complex\nnumber `complex = vec.fp16[0] + i * vec.fp16[1]`, or the complex conjugate `conjugate = vec.fp16[0] - i * vec.fp16[1]`.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_conj_pch)","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512h","id":9313,"args":null}}]],"output":{"resolved_path":{"path":"__m512h","id":9313,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22589":{"id":22589,"crate_id":0,"name":"is_uppercase","span":{"filename":"library\\core\\src\\ascii\\ascii_char.rs","begin":[760,5],"end":[762,6]},"visibility":"public","docs":"Checks if the value is an uppercase character:\n0x41 'A' ..= 0x5A 'Z'.\n\n# Examples\n\n```\n#![feature(ascii_char, ascii_char_variants)]\nuse std::ascii;\n\nlet uppercase_a = ascii::Char::CapitalA;\nlet uppercase_g = ascii::Char::CapitalG;\nlet a = ascii::Char::SmallA;\nlet g = ascii::Char::SmallG;\nlet zero = ascii::Char::Digit0;\nlet percent = ascii::Char::PercentSign;\nlet space = ascii::Char::Space;\nlet lf = ascii::Char::LineFeed;\nlet esc = ascii::Char::Escape;\n\nassert!(uppercase_a.is_uppercase());\nassert!(uppercase_g.is_uppercase());\nassert!(!a.is_uppercase());\nassert!(!g.is_uppercase());\nassert!(!zero.is_uppercase());\nassert!(!percent.is_uppercase());\nassert!(!space.is_uppercase());\nassert!(!lf.is_uppercase());\nassert!(!esc.is_uppercase());\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 110998, is_soft: false}, feature: \"ascii_char\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"primitive":"bool"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"791":{"id":791,"crate_id":0,"name":"Hasher","span":{"filename":"library\\core\\src\\hash\\mod.rs","begin":[313,1],"end":[555,2]},"visibility":"public","docs":"A trait for hashing an arbitrary stream of bytes.\n\nInstances of `Hasher` usually represent state that is changed while hashing\ndata.\n\n`Hasher` provides a fairly basic interface for retrieving the generated hash\n(with [`finish`]), and writing integers as well as slices of bytes into an\ninstance (with [`write`] and [`write_u8`] etc.). Most of the time, `Hasher`\ninstances are used in conjunction with the [`Hash`] trait.\n\nThis trait provides no guarantees about how the various `write_*` methods are\ndefined and implementations of [`Hash`] should not assume that they work one\nway or another. You cannot assume, for example, that a [`write_u32`] call is\nequivalent to four calls of [`write_u8`].  Nor can you assume that adjacent\n`write` calls are merged, so it's possible, for example, that\n```\n# fn foo(hasher: &mut impl std::hash::Hasher) {\nhasher.write(&[1, 2]);\nhasher.write(&[3, 4, 5, 6]);\n# }\n```\nand\n```\n# fn foo(hasher: &mut impl std::hash::Hasher) {\nhasher.write(&[1, 2, 3, 4]);\nhasher.write(&[5, 6]);\n# }\n```\nend up producing different hashes.\n\nThus to produce the same hash value, [`Hash`] implementations must ensure\nfor equivalent items that exactly the same sequence of calls is made -- the\nsame methods with the same parameters in the same order.\n\n# Examples\n\n```\nuse std::hash::{DefaultHasher, Hasher};\n\nlet mut hasher = DefaultHasher::new();\n\nhasher.write_u32(1989);\nhasher.write_u8(11);\nhasher.write_u8(9);\nhasher.write(b\"Huh?\");\n\nprintln!(\"Hash is {:x}!\", hasher.finish());\n```\n\n[`finish`]: Hasher::finish\n[`write`]: Hasher::write\n[`write_u8`]: Hasher::write_u8\n[`write_u32`]: Hasher::write_u32","links":{"`Hash`":793,"Hasher::write":29149,"Hasher::write_u8":29152,"Hasher::finish":29150,"Hasher::write_u32":29154},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"trait":{"is_auto":false,"is_unsafe":false,"is_dyn_compatible":true,"items":[29150,29149,29152,29153,29154,29155,29156,29157,29158,29159,29160,29161,29162,29163,29151,29164],"generics":{"params":[],"where_predicates":[]},"bounds":[],"implementations":[29071,29181]}}},"44387":{"id":44387,"crate_id":0,"name":"vec_all_eq","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\powerpc\\altivec.rs","begin":[4284,1],"end":[4289,2]},"visibility":"public","docs":"Vector All Elements Equal","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: U