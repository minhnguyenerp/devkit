RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"int16x8_t","id":9004,"args":null}}],["b",{"resolved_path":{"path":"int16x8_t","id":9004,"args":null}}],["N",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"int16x8_t","id":9004,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"15167":{"id":15167,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[729,1],"end":[729,57]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Neg","id":1486,"args":null},"for":{"primitive":"f32"},"items":[15165,15166],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"36965":{"id":36965,"crate_id":0,"name":"_mm_maskz_srl_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[20422,1],"end":[20427,2]},"visibility":"public","docs":"Shift packed 32-bit integers in a right by count while shifting in zeros, and store the results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_maskz_srl_epi32&expand=5485)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpsrld))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}],["count",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}]],"output":{"resolved_path":{"path":"__m128i","id":9271,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19018":{"id":19018,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"usize"},"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}}}}}}},"40816":{"id":40816,"crate_id":0,"name":"_mm256_maskz_getmant_ph","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[9318,1],"end":[9328,2]},"visibility":"public","docs":"Normalize the mantissas of packed half-precision (16-bit) floating-point elements in a, and store\nthe results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\nThis intrinsic essentially calculates `±(2^k)*|x.significand|`, where k depends on the interval range defined\nby norm and the sign depends on sign and the source sign.\n\nThe mantissa is normalized to the interval specified by interv, which can take the following values:\n\n    _MM_MANT_NORM_1_2     // interval [1, 2)\n    _MM_MANT_NORM_p5_2    // interval [0.5, 2)\n    _MM_MANT_NORM_p5_1    // interval [0.5, 1)\n    _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\n\nThe sign is determined by sc which can take the following values:\n\n    _MM_MANT_SIGN_src     // sign = sign(src)\n    _MM_MANT_SIGN_zero    // sign = 0\n    _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm256_maskz_getmant_ph)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantph, NORM = 0, SIGN = 0))]"},{"other":"#[rustc_legacy_const_generics(2, 3)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask16","id":35708,"args":null}}],["a",{"resolved_path":{"path":"__m256h","id":9310,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36212,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36213,"args":null}}]],"output":{"resolved_path":{"path":"__m256h","id":9310,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1071":{"id":1071,"crate_id":0,"name":"from_le","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2305,1],"end":[2315,2]},"visibility":"public","docs":"Converts an integer from little endian to the target's endianness.\n\nOn little endian this is a no-op. On big endian the bytes are\nswapped.\n\n# Examples\n\n```\n#![feature(nonzero_bitwise)]\n# use std::num::NonZero;\nuse std::num::NonZeroI8;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet n = NonZero::new(0x1Ai8)?;\n\nif cfg!(target_endian = \"little\") {\n    assert_eq!(NonZeroI8::from_le(n), n)\n} else {\n    assert_eq!(NonZeroI8::from_le(n), n.swap_bytes())\n}\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 128281, is_soft: false}, feature: \"nonzero_bitwise\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22869":{"id":22869,"crate_id":0,"name":"replace","span":{"filename":"library\\core\\src\\cell.rs","begin":[896,5],"end":[898,6]},"visibility":"public","docs":"Replaces the wrapped value with a new one, returning the old value,\nwithout deinitializing either one.\n\nThis function corresponds to [`std::mem::replace`](../mem/fn.replace.html).\n\n# Panics\n\nPanics if the value is currently borrowed.\n\n# Examples\n\n```\nuse std::cell::RefCell;\nlet cell = RefCell::new(5);\nlet old_value = cell.replace(6);\nassert_eq!(old_value, 5);\nassert_eq!(cell, RefCell::new(6));\n```","links":{},"attrs":[{"other":"#[attr = Confusables {symbols: [\"swap\"]}]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 137844, is_soft: false}, feature: \"const_ref_cell\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 24, patch: 0})}, feature: \"refcell_replace\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["t",{"generic":"T"}]],"output":{"generic":"T"},"is_c_vari