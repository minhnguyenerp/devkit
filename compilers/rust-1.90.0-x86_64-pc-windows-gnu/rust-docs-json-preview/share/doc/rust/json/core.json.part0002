egative":false,"is_synthetic":false,"blanket_impl":null}}},"36673":{"id":36673,"crate_id":0,"name":"_mm512_cvtph_ps","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[15476,1],"end":[15485,2]},"visibility":"public","docs":"Convert packed half-precision (16-bit) floating-point elements in a to packed single-precision (32-bit) floating-point elements, and store the results in dst.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_cvtph_ps&expand=1723)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vcvtph2ps))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m256i","id":9280,"args":null}}]],"output":{"resolved_path":{"path":"__m512","id":9292,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18726":{"id":18726,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u64"}}},"items":[18724,18725],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"40524":{"id":40524,"crate_id":0,"name":"_mm_fcmul_round_sch","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[3833,1],"end":[3836,2]},"visibility":"public","docs":"Multiply the lower complex numbers in a by the complex conjugates of the lower complex numbers in b,\nand store the results in dst. Each complex number is composed of two adjacent half-precision (16-bit)\nfloating-point elements, which defines the complex number `complex = vec.fp16[0] + i * vec.fp16[1]`,\n\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_fcmul_round_sch)","links":{"`_MM_FROUND_TO_POS_INF`":35081,"`_MM_SET_ROUNDING_MODE`":34821,"`_MM_FROUND_TO_NEAREST_INT`":35079,"`_MM_FROUND_NO_EXC`":35085,"`_MM_FROUND_TO_NEG_INF`":35080,"`_MM_FROUND_TO_ZERO`":35082,"`_MM_FROUND_CUR_DIRECTION`":35083},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfcmulcsh, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{