ts of IMM8 specifies the operation control:\n    00 = min, 01 = max, 10 = absolute min, 11 = absolute max.\nUpper 2 bits of IMM8 specifies the sign control:\n    00 = sign from a, 01 = sign from compare result, 10 = clear sign bit, 11 = set sign bit.\n\n[Intel's Documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_maskz_range_sd&ig_expand=5221)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vrangesd, IMM8 = 5))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512dq"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m128d","id":9277,"args":null}}],["b",{"resolved_path":{"path":"__m128d","id":9277,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128d","id":9277,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"55":{"id":55,"crate_id":0,"name":"PartialOrd","span":{"filename":"library\\core\\src\\cmp.rs","begin":[1522,1],"end":[1524,2]},"visibility":"public","docs":"Derive macro generating an impl of the trait [`PartialOrd`].\nThe behavior of this macro is described in detail [here](PartialOrd#derivable).","links":{"PartialOrd#derivable":53,"`PartialOrd`":53},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 38, patch: 0})}, feature: \"builtin_macro_prelude\"}}]"},{"other":"#[attr = AllowInternalUnstable([\"core_intrinsics\"])]"},{"other":"#[attr = RustcBuiltinMacro {helper_attrs: []}]"}],"deprecation":null,"inner":{"proc_macro":{"kind":"