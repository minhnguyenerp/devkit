solved_path":{"path":"uint64x1_t","id":8989,"args":null}}]],"output":{"resolved_path":{"path":"uint64x1_t","id":8989,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1947":{"id":1947,"crate_id":0,"name":"NonZeroI64","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2341,1],"end":[2351,2]},"visibility":"public","docs":"An [`i64`] that is known not to equal zero.\n\nThis enables some memory layout optimization.\nFor example, `Option<NonZeroI64>` is the same size as `i64`:\n\n```rust\nassert_eq!(size_of::<Option<core::num::NonZeroI64>>(), size_of::<i64>());\n```\n\n# Layout\n\n`NonZeroI64` is guaranteed to have the same layout and bit validity as `i64`\nwith the exception that `0` is not a valid instance.\n`Option<NonZeroI64>` is guaranteed to be compatible with `i64`,\nincluding in FFI.\n\nThanks to the [null pointer optimization],\n`NonZeroI64` and `Option<NonZeroI64>`\nare guaranteed to have the same size and alignment:\n\n```\nuse std::num::NonZeroI64;\n\nassert_eq!(size_of::<NonZeroI64>(), size_of::<Option<NonZeroI64>>());\nassert_eq!(align_of::<NonZeroI64>(), align_of::<Option<NonZeroI64>>());\n```\n\n[null pointer optimization]: crate::option#representation","links":{"crate::option#representation":816,"`i64`":230},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 34, patch: 0})}, feature: \"signed_nonzero\"}}]"}],"deprecation":null,"inner":{"type_alias":{"type":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"23745":{"id":23745,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[785,1],"end":[791,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Filter","id":8600,"args":{"angle_bracketed":{"args":[{"type":{"generic":"I"}},{"type":{"generic":"P"}}],"constraints":[]}}}},"items":[693],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"45543":{"id":45543,"crate_id":0,"name":"lsx_vmul_b","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lsx\\generated.rs","begin":[3055,1],"end":[3057,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9403,"args":null}}],["b",{"resolved_path":{"path":"m128i","id":9403,"args":null}}]],"output":{"resolved_path":{"path":"m128i","id":9403,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5798":{"id":5798,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"RemAssign","id":1414,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Wrapping","id":4333,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4333,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}},"items":[5797],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"27596":{"id":27596,"crate_id":0,"name":"update","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3713,1],"end":[3730,2]},"visibility":"public","docs":"Fetches the value, applies a function to it that it return a new value.\nThe new value is stored and the old value is returned.\n\nSee also: [`try_update`](`AtomicU16::try_update`).\n\nNote: This may call the function multiple times if the value has been changed from other threads in\nthe meantime, but the function will have been applied only once to the stored value.\n\n`update` takes two [`Ordering`] arguments to describe the memory ordering of this operation.\nThe first describes the required ordering for when the operation finally succeeds while the second\ndescribes the required ordering for loads. These correspond to the success and failure orderings of\n[`AtomicU16::compare_exchange`]\nrespectively.\n\nUsing [`Acquire`] as success ordering makes the store part\nof this operation [`Relaxed`], and using [`Release`] makes the final successful load\n[`Relaxed`]. The (failed) load ordering can only be [`SeqCst`], [`Acquire`] or [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic operations on\n[`u16`].\n\n# Considerations\n\n[CAS operation]: https://en.wikipedia.org/wiki/Compare-and-swap\nThis method is not magic; it is not provided by the hardware, and does not act like a\ncritical section or mutex.\n\nIt is implemented on top of an atomic [compare-and-swap operation], and thus is subject to\nthe usual drawbacks of CAS operations. In particular, be careful of the [ABA problem]\nif this atomic integer is an index or more generally if knowledge of only the *bitwise value*\nof the atomic is not in and of itself sufficient to ensure any required preconditions.\n\n[ABA Problem]: https://en.wikipedia.org/wiki/ABA_problem\n[compare-and-swap operation]: https://en.wikipedia.org/wiki/Compare-and-swap\n\n# Examples\n\n```rust\n#![feature(atomic_try_update)]\nuse std::sync::atomic::{AtomicU16, Ordering};\n\nlet x = AtomicU16::new(7);\nassert_eq!(x.update(Ordering::SeqCst, Ordering::SeqCst, |x| x + 1), 7);\nassert_eq!(x.update(Ordering::SeqCst, Ordering::SeqCst, |x| x + 1), 8);\nassert_eq!(x.load(Ordering::SeqCst), 9);\n```","links":{"`SeqCst`":27392,"`AtomicU16::try_update`":27597,"`Acquire`":27393,"`Relaxed`":27394,"`Release`":27395,"`u16`":254,"`AtomicU16::compare_exchange`":27587,"`Ordering`":8755},"attrs":[{"other":"#[<cfg>(target_has_atomic = \"16\")]"},{"other":"#[<cfg_attr>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 135894, is_soft: false}, feature: \"atomic_try_update\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["set_order",{"resolved_path":{"path":"Ordering","id":8755,"args":null}}],["fetch_order",{"resolved_path":{"path":"Ordering","id":8755,"args":null}}],["f",{"impl_trait":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u16"}],"output":{"primitive":"u16"}}}},"generic_params":[],"modifier":"none"}}]}]],"output":{"primitive":"u16"},"is_c_variadic":false},"generics":{"params":[{"name":"impl FnMut(u16) -> u16","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u16"}],"output":{"primitive":"u16"}}}},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":true}}}],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49394":{"id":49394,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[785,1],"end":[791,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"primitive":"i16"},"items":[693],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"9649":{"id":9649,"crate_id":0,"name":"eq","span":{"filename":"library\\core\\src\\bstr\\traits.rs","begin":[139,1],"end":[139,33]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"ByteStr","id":8391,"args":null}}}}]],"output":{"primitive":"bool"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31447":{"id":31447,"crate_id":0,"name":"vcvt_n_f16_u16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[8500,1],"end":[8514,2]},"visibility":"public","docs":"Fixed-point convert to floating-point\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vc