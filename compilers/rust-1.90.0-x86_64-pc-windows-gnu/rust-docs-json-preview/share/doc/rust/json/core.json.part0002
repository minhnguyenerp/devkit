tel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_fpclass_sh_mask)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfpclasssh, IMM8 = 0))]"},{"other":"#[rustc_legacy_const_generics(1)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__mmask8","id":35711,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1156":{"id":1156,"crate_id":0,"name":"swap_bytes","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2329,1],"end":[2339,2]},"visibility":"public","docs":"Reverses the byte order of the integer.\n\n# Examples\n\n```\n#![feature(nonzero_bitwise)]\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet n = NonZero::new(0x12345678i32)?;\nlet m = n.swap_bytes();\n\nassert_eq!(m, NonZero::new(0x78563412)?);\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 128281, is_soft: false}, feature: \"nonzero_bitwise\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22954":{"id":22954,"crate_id":0,"name":"leak","span":{"filename":"library\\core\\src\\cell.rs","begin":[1898,5],"end":[1907,6]},"visibility":"public","docs":"Converts into a mutable reference to the underlying data.\n\nThe underlying `RefCell` can not be borrowed from again and will always appear already\nmutably borrowed, making the returned reference the only to the interior.\n\nThis is an associated function that needs to be used as\n`RefMut::leak(...)`. A method would interfere with methods of the\nsame name on the contents of a `RefCell` used through `Deref`.\n\n# Examples\n\n```\n#![feature(cell_leak)]\nuse std::cell::{RefCell, RefMut};\nlet cell = RefCell::new(0);\n\nlet value = RefMut::leak(cell.borrow_mut());\nassert_eq!(*value, 0);\n*value = 1;\n\nassert!(cell.try_borrow_mut().is_err());\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 137844, is_soft: false}, feature: \"const_ref_cell\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 69099, is_soft: false}, feature: \"cell_leak\"}}]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["orig",{"resolved_path":{"path":"RefMut","id":11832,"args":{"angle_bracketed":{"args":[{"lifetime":"'b"},{"type":{"generic":"T"}}],"constraints":[]}}}}]],"output":{"borrowed_ref":{"lifetime":"'b","is_mutable":true,"type":{"generic":"T"}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44752":{"id":44752,"crate_id":0,"name":"lasx_xvssub_du","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[3032,1],"end":[3034,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inlin