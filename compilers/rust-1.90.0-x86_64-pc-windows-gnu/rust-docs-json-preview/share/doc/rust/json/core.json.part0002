`","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 52, patch: 0})}, feature: \"const_wrapping_int_methods\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 2, patch: 0})}, feature: \"num_wrapping\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10458":{"id":10458,"crate_id":0,"name":"from","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[96,1],"end":[96,25]},"visibility":"default","docs":"Converts a [`bool`] to [`i128`] losslessly.\nThe resulting value is `0` for `false` and `1` for `true` values.\n\n# Examples\n\n```\nassert_eq!(i128::from(true), 1);\nassert_eq!(i128::from(false), 0);\n```","links":{"`i128`":212,"`bool`":10437},"attrs":[{"other":"#[attr = Inline(Always)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["small",{"primitive":"bool"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"32256":{"id":32256,"crate_id":0,"name":"vmull_laneq_u32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[33762,1],"end":[33765,2]},"visibility":"public","docs":"Vector long multiply by scalar\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vmull_laneq_u32)","links":{},"