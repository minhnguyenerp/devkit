does not mutate the original value"}},{"other":"#[attr = AllowIncoherentImpl]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"f16"}]],"output":{"primitive":"f16"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9211":{"id":9211,"crate_id":0,"name":"float32x4x3_t","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\mod.rs","begin":[858,1],"end":[858,77]},"visibility":"public","docs":"Arm-specific type containing three `float32x4_t` vectors.","links":{},"attrs":[{"other":"#[<cfg_attr>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"repr":{"kind":"c","align":null,"packed":null,"int":null}}],"deprecation":null,"inner":{"struct":{"kind":{"tuple":[34352,34353,34354]},"generics":{"params":[],"where_predicates":[]},"impls":[12124,12846,13314,13730,26434,26742,34355,34356,34357,34358,34359,34360,34361,34362,12490,9212,28628]}}},"31009":{"id":31009,"crate_id":0,"name":"clmul","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\riscv_shared\\zb.rs","begin":[74,1],"end":[84,2]},"visibility":"public","docs":"Carry-less multiply (low-part)\n\nclmul produces the lower half of the 2·XLEN carry-less product.\n\nSource: RISC-V Bit-Manipulation ISA-extensions\n\nVersion: v1.0.0\n\nSection: 2.11","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(clmul))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 114544, is_soft: false}, feature: \"riscv_ext_intrin