ntrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"uint64x2_t","id":9025,"args":null}}],["b",{"resolved_path":{"path":"uint64x2_t","id":9025,"args":null}}],["N",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"uint64x2_t","id":9025,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"15179":{"id":15179,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[729,1],"end":[729,57]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Neg","id":1486,"args":null},"for":{"primitive":"f128"},"items":[15177,15178],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"36977":{"id":36977,"crate_id":0,"name":"_mm256_maskz_srl_epi64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[20584,1],"end":[20589,2]},"visibility":"public","docs":"Shift packed 64-bit integers in a right by count while shifting in zeros, and store the results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_maskz_srl_epi64&expand=5497)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpsrlq))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m256i","id":9280,"args":null}}],["count",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}]],"output":{"resolved_path":{"path":"__m256i","id":9280,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19030":{"id":19030,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"usize"},"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}}}}}}},"40828":{"id":40828,"crate_id":0,"name":"_mm_maskz_getmant_round_sh","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[9781,1],"end":[9794,2]},"visibility":"public","docs":"Normalize the mantissas of the lower half-precision (16-bit) floating-point element in b, store\nthe result in the lower element of dst using zeromask k (the element is zeroed out when mask bit 0 is not set),\nand copy the upper 7 packed elements from a to the upper elements of dst. This intrinsic essentially calculates\n`±(2^k)*|x.significand|`, where k depends on the interval range defined by norm and the sign depends on sign and\nthe source sign. Exceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter\n\nThe mantissa is normalized to the interval specified by interv, which can take the following values:\n\n    _MM_MANT_NORM_1_2     // interval [1, 2)\n    _MM_MANT_NORM_p5_2    // interval [0.5, 2)\n    _MM_MANT_NORM_p5_1    // interval [0.5, 1)\n    _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\n\nThe sign is determined by sc which can take the following values:\n\n    _MM_MANT_SIGN_src     // sign = sign(src)\n    _MM_MANT_SIGN_zero    // sign = 0\n    _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_maskz_getmant_round_sh)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantsh, NORM = 0, SIGN = 0, SAE = 8))]"},{"other":"#[rustc_legacy_const_generics(3, 4, 5)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9307,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36212,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36213,"args":null}}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9307,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1083":{"id":1083,"crate_id":0,"name":"wrapping_abs","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[247,5],"end":[266,6]},"visibility":"public","docs":"Wrapping (modular) absolute value. Computes `self.abs()`, wrapping around at\nthe boundary of the type.\n\nThe only case where such wrapping can occur is when one takes the absolute value of the negative\nminimal value for the type; this is a positive value that is too large to represent in the type. In\nsuch a case, this function returns `MIN` itself.\n\n# Examples\n\n```\nassert_eq!(100i8.wrapping_abs(), 100);\nassert_eq!((-100i8).wrapping_abs(), 100);\nassert_eq!(i8::MIN.wrapping_abs(), i8::MIN);\nassert_eq!((-128i8).wrapping_abs() as u8, 128);\n```","links":{},"attrs":[{"other":"#[allow(unused_attributes)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"const_int_methods\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 13, patch: 0})}, feature: \"no_panic_abs\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22881":{"id":22881,"crate_id":0,"name":"take","span":{"filename":"library\\core\\src\\cell.rs","begin":[1295,5],"end":[1297,6]},"visibility":"public","docs":"Takes the wrapped value, leaving `Default::default()` in its place.\n\n# Panics\n\nPanics if the value is currently borrowed.\n\n# Examples\n\n```\nuse std::cell::RefCell;\n\nlet c = RefCell::new(5);\nlet five = c.take();\n\nassert_eq!(five, 5);\nassert_eq!(c.into_inner(), 0);\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 50, patch: 0})}, feature: \"refcell_take\"}}]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"generic":"T"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44679":{"id":44679,"crate_id":0,"name":"lasx_xvslt_w","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[2473,1],"end":[2475,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m256i","id":9394,"args":null}}],["b",{"resolved_path":{"path":"m256i","id":9394,"args":null}}]],"output":{"resolved_path":{"path":"m256i","id":9394,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"4934":{"id":4934,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[227,1],"end":[227,69]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"i