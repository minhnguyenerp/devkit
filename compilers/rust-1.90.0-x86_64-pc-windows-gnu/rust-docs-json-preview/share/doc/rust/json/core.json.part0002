nerics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Display","id":723,"args":null},"for":{"primitive":"char"},"items":[28836],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"50635":{"id":50635,"crate_id":0,"name":"carrying_add","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[420,5],"end":[439,6]},"visibility":"public","docs":"Calculates `self` + `rhs` + `carry` and checks for overflow.\n\nPerforms \"ternary addition\" of two integer operands and a carry-in\nbit, and returns a tuple of the sum along with a boolean indicating\nwhether an arithmetic overflow would occur. On overflow, the wrapped\nvalue is returned.\n\nThis allows chaining together multiple additions to create a wider\naddition, and can be useful for bignum addition. This method should\nonly be used for the most significant word; for the less significant\nwords the unsigned method\n[`usize::carrying_add`]\nshould be used.\n\nThe output boolean returned by this method is *not* a carry flag,\nand should *not* be added to a more significant word.\n\nIf the input carry is false, this method is equivalent to\n[`overflowing_add`](Self::overflowing_add).\n\n# Examples\n\n```\n#![feature(bigint_helper_methods)]\n// Only the most significant word is signed.\n//\n//   10  MAX    (a = 10 × 2^64 + 2^64 - 1)\n// + -5    9    (b = -5 × 2^64 + 9)\n// ---------\n//    6    8    (sum = 6 × 2^64 + 8)\n\nlet (a1, a0): (isize, usize) = (10, usize::MAX);\nlet (b1, b0): (isize, usize) = (-5, 9);\nlet carry0 = false;\n\n// usize::carrying_add for the less significant words\nlet (sum0, carry1) = a0.carrying_add(b0, carry0);\nassert_eq!(carry1, true);\n\n// isize::carrying_add for the most significant word\nlet (sum1, overflow) = a1.carrying_add(b1, carry1);\nassert_eq!(overflow, false);\n\nassert_eq!((sum1, sum0), (6, 8));\n```","links":{"Self::overflowing_add":50633,"`usize::carrying_add`":50634},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 85532, is_soft: false}, feature: \"bigint_helper_methods\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}],["carry",{"primitive":"bool"}]],"output":{"tuple":[{"generic":"Self"},{"primitive":"bool"}]},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10890":{"id":10890,"crate_id":0,"name":"f32x16","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\alias.rs","begin":[55,1],"end":[175,2]},"visibility":"public","docs":"A SIMD vector with 16 elements of type [`f32`].","links":{"`f32`":406},"attrs":[{"other":"#[allow(non_camel_case_types)]"}],"deprecation":null,"inner":{"type_alias":{"type":{"resolved_path":{"path":"$crate::simd::Simd","id":9462,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"f32"}},{"const":{"expr":"$num_elements","value":null,"is_literal":true}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"32688":{"id":32688,"crate_id":0,"name":"vreinterpretq_s8_s32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[47433,1],"end":[47435,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpretq_s8_s32)","links":{},"attrs":[{"other":"#[<cfg>(target_endian = \"little\")]"},{"other":"#[<cfg_attr>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr>(all(test, any(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(nop))]"},{"other":"#[<cfg_attr>(