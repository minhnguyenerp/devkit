let b: [u32; 0] = [];\n\nassert_eq!(a.into_iter().min(), Some(1));\nassert_eq!(b.into_iter().min(), None);\n```","links":{"`Iterator::reduce`":25256,"`f32`":406,"`f64`":476,"`Ord`":45,"`None`":81},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":77,"args":null}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[{"bound_predicate":{"type":{"generic":"Self"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}},{"bound_predicate":{"type":{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":77,"args":null}}},"bounds":[{"trait_bound":{"trait":{"path":"Ord","id":45,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"47064":{"id":47064,"crate_id":0,"name":"from_ne_bytes","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\to_bytes.rs","begin":[126,1],"end":[126,25]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["bytes",{"qualified_path":{"name":"Bytes","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":47046,"args":null}}}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"