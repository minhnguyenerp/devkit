,"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Neg","id":1486,"args":null},"for":{"primitive":"f64"},"items":[15171,15172],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"36971":{"id":36971,"crate_id":0,"name":"_mm_mask_sll_epi64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[20503,1],"end":[20508,2]},"visibility":"public","docs":"Shift packed 64-bit integers in a left by count while shifting in zeros, and store the results in dst using writemask k (elements are copied from src when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_mask_sll_epi64&expand=5281)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vpsllq))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}],["count",{"resolved_path":{"path":"__m128i","id":9271,"args":null}}]],"output":{"resolved_path":{"path":"__m128i","id":9271,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19024":{"id":19024,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"usize"},"trait":{"path":"Shr","id":4648,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}}}}}}},"40822":{"id":40822,"crate_id":0,"name":"_mm512_maskz_getmant_round_ph","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[9544,1],"end":[9556,2]},"visibility":"public","docs":"Normalize the mantissas of packed half-precision (16-bit) floating-point elements in a, and store\nthe results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\nThis intrinsic essentially calculates `±(2^k)*|x.significand|`, where k depends on the interval range defined\nby norm and the sign depends on sign and the source sign. Exceptions can be suppressed by passing _MM_FROUND_NO_EXC\nin the sae parameter\n\nThe mantissa is normalized to the interval specified by interv, which can take the following values:\n\n    _MM_MANT_NORM_1_2     // interval [1, 2)\n    _MM_MANT_NORM_p5_2    // interval [0.5, 2)\n    _MM_MANT_NORM_p5_1    // interval [0.5, 1)\n    _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\n\nThe sign is determined by sc which can take the following values:\n\n    _MM_MANT_SIGN_src     // sign = sign(src)\n    _MM_MANT_SIGN_zero    // sign = 0\n    _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_maskz_getmant_round_ph)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantph, NORM = 0, SIGN = 0, SAE = 8))]"},{"other":"#[rustc_legacy_const_generics(2, 3, 4)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask32","id":38589,"args":null}}],["a",{"resolved_path":{"path":"__m512h","id":9313,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36212,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36213,"args":null}}],["SAE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512h","id":9313,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1077":{"id":1077,"crate_id":0,"name":"abs","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2305,1],"end":[2315,2]},"visibility":"public","docs":"Computes the absolute value of self.\nSee [`i8::abs`]\nfor documentation on overflow behavior.\n\n# Example\n\n```\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet pos = NonZero::new(1i8)?;\nlet neg = NonZero::new(-1i8)?;\n\nassert_eq!(pos, pos.abs());\nassert_eq!(pos, neg.abs());\n# Some(())\n# }\n```","links":{"`i8::abs`":1076},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 64, patch: 0})}, feature: \"const_nonzero_checked_ops\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 64, patch: 0})}, feature: \"nonzero_checked_ops\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22875":{"id":22875,"crate_id":0,"name":"try_borrow_mut","span":{"filename":"library\\core\\src\\cell.rs","begin":[1120,5],"end":[1139,6]},"visibility":"public","docs":"Mutably borrows the wrapped value, returning an error if the value is currently borrowed.\n\nThe borrow lasts until the returned `RefMut` or all `RefMut`s derived\nfrom it exit scope. The value cannot be borrowed while this borrow is\nactive.\n\nThis is the non-panicking variant of [`borrow_mut`](#method.borrow_mut).\n\n# Examples\n\n```\nuse std::cell::RefCell;\n\nlet c = RefCell::new(5);\n\n{\n    let m = c.borrow();\n    assert!(c.try_borrow_mut().is_err());\n}\n\nassert!(c.try_borrow_mut().is_ok());\n```","links":{},"attrs":[{"other":"#[<cfg_attr>(feature = \"debug_refcell\", track_caller)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 137844, is_soft: false}, feature: \"const_ref_cell\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 13, patch: 0})}, feature: \"try_borrow\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"RefMut","id":11832,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"},{"type":{"generic":"T"}}],"constraints":[]}}}}},{"type":{"resolved_path":{"path":"BorrowMutError","id":11580,"args":null}}}],"constraints":[]}}}},"is_