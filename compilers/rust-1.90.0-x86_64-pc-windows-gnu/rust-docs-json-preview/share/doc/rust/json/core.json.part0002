kz_cvt_roundsd_ss&expand=1363)","links":{"`_MM_FROUND_TO_POS_INF`":35081,"`_MM_SET_ROUNDING_MODE`":34821,"`_MM_FROUND_TO_NEAREST_INT`":35079,"`_MM_FROUND_NO_EXC`":35085,"`_MM_FROUND_TO_NEG_INF`":35080,"`_MM_FROUND_TO_ZERO`":35082,"`_MM_FROUND_CUR_DIRECTION`":35083},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vcvtsd2ss, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35711,"args":null}}],["a",{"resolved_path":{"path":"__m128","id":9274,"args":null}}],["b",{"resolved_path":{"path":"__m128d","id":9277,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128","id":9274,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"20338":{"id":20338,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[905,1],"end":[905,81]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"BitXorAssign","id":2369,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u128"}}}}],"cons