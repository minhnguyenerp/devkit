ich can take the following values:\\\n   _MM_MANT_SIGN_src     // sign = sign(src)\\\n   _MM_MANT_SIGN_zero    // sign = 0\\\n   _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\\\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=mm_getmant_sd&expand=2895)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vgetmantsd, NORM = 0, SIGN = 0))]"},{"other":"#[rustc_legacy_const_generics(2, 3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128d","id":9277,"args":null}}],["b",{"resolved_path":{"path":"__m128d","id":9277,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36212,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36213,"args":null}}]],"output":{"resolved_path":{"path":"__m128d","id":9277,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"20180":{"id":20180,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[755,1],"end":[755,81]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"w