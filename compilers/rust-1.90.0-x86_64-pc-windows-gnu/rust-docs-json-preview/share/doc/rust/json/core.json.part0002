alse,"blanket_impl":null}}},"27882":{"id":27882,"crate_id":0,"name":"as_ptr","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3911,1],"end":[3915,2]},"visibility":"public","docs":"Returns a mutable pointer to the underlying integer.\n\nDoing non-atomic reads and writes on the resulting integer can be a data race.\nThis method is mostly useful for FFI, where the function signature may use\n`*mut usize` instead of `&AtomicUsize`.\n\nReturning an `*mut` pointer from a shared reference to this atomic is safe because the\natomic types work with interior mutability. All modifications of an atomic change the value\nthrough a shared reference, and can do so safely as long as they use atomic operations. Any\nuse of the returned raw pointer requires an `unsafe` block and still has to uphold the\nrequirements of the [memory model].\n\n# Examples\n\n```ignore (extern-declaration)\n# fn main() {\nuse std::sync::atomic::AtomicUsize;\n\nextern \"C\" {\n    fn my_atomic_op(arg: *mut usize);\n}\n\nlet atomic = AtomicUsize::new(1);\n\n// SAFETY: Safe as long as `my_atomic_op` is atomic.\nunsafe {\n    my_atomic_op(atomic.as_ptr());\n}\n# }\n```\n\n[memory model]: self#memory-model-for-atomic-accesses","links":{"self#memory-model-for-atomic-accesses":7590},"attrs":[{"other":"#[rustc_never_returns_null_ptr]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 70, patch: 0})}, feature: \"atomic_as_ptr\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 70, patch: 0})}, feature: \"atomic_as_ptr\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"raw_pointer":{"is_mutable":true,"type":{"primitive":"usize"}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49680":{"id":49680,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[212,1],"end":[217,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Borrow","id":684,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"primitive":"i64"},"items":[682],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"9935":{"id":9935,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\any.rs","begin":[138,1],"end":[142,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"outlives":"'static"},{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Any","id":707,"args":null},"for":{"resolved_path":{"path":"Reverse","id":8453,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"items":[704],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"31733":{"id":31733,"crate_id":0,"name":"vld1q_lane_u32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[16253,1],"end":[16256,2]},"visibility":"public","docs":"Load o