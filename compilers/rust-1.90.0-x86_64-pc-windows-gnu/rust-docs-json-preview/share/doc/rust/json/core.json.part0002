"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"40682":{"id":40682,"crate_id":0,"name":"_mm_maskz_fnmsub_round_sh","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[7091,1],"end":[7108,2]},"visibility":"public","docs":"Multiply the lower half-precision (16-bit) floating-point elements in a and b, and subtract the intermediate\nresult from the lower element in c. Store the result in the lower element of dst using zeromask k (the element\nis zeroed out when the mask bit 0 is not set), and copy the upper 7 packed elements from a to the upper\nelements of dst.\n\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_maskz_fnmsub_round_sh)","links":{"`_MM_FROUND_TO_POS_INF`":35081,"`_MM_SET_ROUNDING_MODE`":34821,"`_MM_FROUND_TO_NEAREST_INT`":35079,"`_MM_FROUND_NO_EXC`":35085,"`_MM_FROUND_TO_NEG_INF`":35080,"`_MM_FROUND_TO_ZERO`":35082,"`_MM_FROUND_CUR_DIRECTION`":35083},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vfnmsub, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":nul