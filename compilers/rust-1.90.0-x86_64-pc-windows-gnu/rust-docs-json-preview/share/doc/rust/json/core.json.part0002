f `k` is greater than the length of the\nslice. Note that `k == self.len()` does _not_ panic and is a no-op\nrotation.\n\n# Complexity\n\nTakes linear (in `self.len()`) time.\n\n# Examples\n\n```\nlet mut a = ['a', 'b', 'c', 'd', 'e', 'f'];\na.rotate_right(2);\nassert_eq!(a, ['e', 'f', 'a', 'b', 'c', 'd']);\n```\n\nRotating a subslice:\n\n```\nlet mut a = ['a', 'b', 'c', 'd', 'e', 'f'];\na[1..5].rotate_right(1);\nassert_eq!(a, ['a', 'e', 'b', 'c', 'd', 'f']);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143812, is_soft: false}, feature: \"const_slice_rotate\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 26, patch: 0})}, feature: \"slice_rotate\"}}]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["k",{"primitive":"usize"}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9071":{"id":9071,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\mod.rs","begin":[252,16],"end":[252,21]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":["clone_from"],"trait":{"path":"Clone","id":37,"args":null},"for":{"resolved_path":{"path":"uint8x16x4_t","id":9070,"args":null}},"items":[9069],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"30869":{"id":30869,"crate_id":0,"name":"Allocator","span":{"filename":"library\\core\\src\\alloc\\mod.rs","begin":[105,1],"end":[368,2]},"visibility":"public","docs":"An implementation of `Allocator` can allocate, grow, shrink, and deallocate arbitrary blocks of\ndata described via [`Layout`][].\n\n`Allocator` is designed to be implemented on ZSTs, references, or smart pointers.\nAn allocator for `MyAlloc([u8; N])` cannot be moved, without updating the pointers to the\nallocated memory.\n\nIn contrast to [`GlobalAlloc`][], `Allocator` allows zero-sized allocations. If an underlying\nallocator does not support this (like jemalloc) or responds by returning a null pointer\n(such as `libc::malloc`), this must be caught by the implementation.\n\n### Currently allocated memory\n\nSome of the methods require that a memory block is *currently allocated* by an allocator.\nThis means that:\n * the starting address for that memory block was previously\n   returned by [`allocate`], [`grow`], or [`shrink`], and\n * the memory block has not subsequently been deallocated.\n\nA memory block is deallocated by a call to [`deallocate`],\nor by a call to [`grow`] or [`shrink`] that returns `Ok`.\nA call to `grow` or `shrink` that returns `Err`,\ndoes not deallocate the memory block passed to it.\n\n[`allocate`]: Allocator::allocate\n[`grow`]: Allocator::grow\n[`shrink`]: Allocator::shrink\n[`deallocate`]: Allocator::deallocate\n\n### Memory fitting\n\nSome of the methods require that a `layout` *fit* a memory block or vice versa. This means that the\nfollowing conditions must hold:\n * the memory block must be *currently allocated* with alignment of [`layout.align()`], and\n * [`layout.size()`] must fall in the range `min ..= max`, where:\n   - `min` is the size of the layout used to allocate the block, and\n   - `max` is the actual size returned from [`allocate`], [`grow`], or [`shrink`].\n\n[`layout.align()`]: Layout::align\n[`layout.size()`]: Layout::size\n\n# Safety\n\nMemory blocks that are [*currently allocated*] by an allocator,\nmust point to valid memory, and retain their validity until either:\n - the memory block is deallocated, or\n - the allocator is dropped.\n\nCopying, cloning, or moving the allocator must not invalidate memory blocks returned from it.\nA copied or cloned allocator must behave like the original allocator.\n\nA memory block which is [*currently allocated*] may be passed to\nany method of the allocator that accepts such an argument.\n\n[*currently allocated*]: #currently-allocated-memory","links":{"`Layout`":8195,"Allocator::shrink":30867,"Allocator::grow":30865,"`GlobalAlloc`":30811,"Allocator::allocate":30862,"Allocator::deallocate":30864,"Layout::size":30817,"Layout::align":30818},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 32838, is_soft: false}, feature: \"allocator_api\"}}]"}],"deprecation":null,"inner":{"trait":{"is_auto":false,"is_unsafe":true,"is_dyn_compatible":true,"items":[30862,30863,30864,30865,30866,30867,30868],"generics":{"params":[],"where_predicates":[]},"bounds":[],"implementations":[30876]}}},"12922":{"id":12922,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Sync","id":9,"args":null},"for":{"resolved_path":{"path":"vector_signed_long_long","id":9439,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"34720":{"id":34720,"crate_id":0,"name":"_mm_cmpeq_ss","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\sse.rs","begin":[324,1],"end":[326,2]},"visibility":"public","docs":"Compares the lowest `f32` of both inputs for equality. The lowest 32 bits of\nthe result will be `0xffffffff` if the two inputs are equal, or `0`\notherwise. The upper 96 bits of the result are the upper 96 bits of `a`.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_cmpeq_ss)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(cmpeqss))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},{"target_feature":{"enable":["sse"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128","id":9274,"args":null}}],["b",{"resolved_path":{"path":"__m128","id":9274,"args":null}}]],"output":{"resolved_path":{"path":"__m128","id":9274,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"16773":{"id":16773,"crate_id":0,"name":"shl","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"i16"}]],"output":{"primitive":"u32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"38571":{"id":38571,"crate_id":0,"name":"_MM_PERM_DDAB","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[42319,1],"end":[42319,47]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"}],"deprecation":null,"inner":{"constant":{"type":{"resolved_path":{"path":"_MM_PERM_ENUM","id":37207,"args":null}},"const":{"expr":"0xF1","value":"241i32","is_literal":true}}}},"20624":{"id":20624,"crat