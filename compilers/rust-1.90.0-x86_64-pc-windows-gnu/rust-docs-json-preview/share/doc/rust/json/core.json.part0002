     unsafe { worker(); }\n#     }\n# }\n```\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_unpacklo_epi64)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vunpcklpd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},{"target_feature":{"enable":["avx2"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m256i","id":9280,"args":null}}],["b",{"resolved_path":{"path":"__m256i","id":9280,"args":null}}]],"output":{"resolved_path":{"path":"__m256i","id":9280,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"17649":{"id":17649,"crate_id":0,"name":"shl","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"i32"}]],"output":{"primitive":"i32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"39447":{"id":39447,"crate_id":0,"name":"_mm_mask_lzcnt_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512cd.rs","begin":[403,1],"end":[408,2]},"visibility":"public","docs":"Counts the number of leading zero bits in each packed 32-bit integer in a, and store the results in dst using writemask k (elements are copied from src when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.htm