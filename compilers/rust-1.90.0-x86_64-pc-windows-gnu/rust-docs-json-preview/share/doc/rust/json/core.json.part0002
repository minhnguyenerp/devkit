"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49753":{"id":49753,"crate_id":0,"name":"strict_abs","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[343,5],"end":[364,6]},"visibility":"public","docs":"Strict absolute value. Computes `self.abs()`, panicking if\n`self == MIN`.\n\n# Panics\n\n## Overflow behavior\n\nThis function will always panic on overflow, regardless of whether overflow checks are enabled.\n\n# Examples\n\n```\nassert_eq!((-5i128).strict_abs(), 5);\n```\n\nThe following panics because of overflow:\n\n```should_panic\nlet _ = i128::MIN.strict_abs();\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"strict_overflow_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"strict_overflow_ops\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10008":{"id":10008,"crate_id":0,"name":"cmp","span":{"filename":"library\\core\\src\\marker\\variance.rs","begin":[178,1],"end":[230,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["_",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"Ordering","id":1374,"