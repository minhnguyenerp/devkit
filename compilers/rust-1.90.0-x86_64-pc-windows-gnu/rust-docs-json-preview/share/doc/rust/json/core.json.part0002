ot set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_maskz_mov_epi16&expand=3796)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(vmovdqu16))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512bw"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask32","id":38589,"args":null}}],["a",{"resolved_path":{"path":"__m512i","id":9289,"args":null}}]],"output":{"resolved_path":{"path":"__m512i","id":9289,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"21281":{"id":21281,"crate_id":0,"name":"shr_assign","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[1077,1],"end":[1077,77]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["other",{"primitive":"isize"}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"43079":{"id":43079,"crate_id":0,"name":"vsqrt_f64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\aarch64\\neon\\generated.rs","begin":[24830,1],"end":[24832,2]},"visibility":"public","docs":"Calculates the square root of each lane.\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vsqrt_f64)","links":{},"attrs":[{"other":"#[<cfg_attr>(test, assert_instr(fsqrt))]"},{"other":"#[attr = Stabi