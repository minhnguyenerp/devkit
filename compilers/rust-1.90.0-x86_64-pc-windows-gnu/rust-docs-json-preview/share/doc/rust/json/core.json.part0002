333,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}},"items":[6027,6028],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"27827":{"id":27827,"crate_id":0,"name":"from_mut","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3911,1],"end":[3915,2]},"visibility":"public","docs":"Get atomic access to a `&mut isize`.\n\n**Note:** This function is only available on targets where `AtomicIsize` has the same alignment as `isize`.\n\n# Examples\n\n```\n#![feature(atomic_from_mut)]\nuse std::sync::atomic::{AtomicIsize, Ordering};\n\nlet mut some_int = 123;\nlet a = AtomicIsize::from_mut(&mut some_int);\na.store(100, Ordering::Relaxed);\nassert_eq!(some_int, 100);\n```\n","links":{},"attrs":[{"other":"#[<cfg>(target_has_atomic_equal_alignment = \"ptr\")]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 76314, is_soft: false}, feature: \"atomic_from_mut\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["v",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"primitive":"isize"}}}]],"output":{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49625":{"id":49625,"crate_id":0,"name":"wrapping_shr","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[319,5],"end":[338,6]},"visibility":"public","docs":"Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`\nremoves any high-order bits of `rhs` that would cause the shift to exceed the bitwidth of the type.\n\nNote that this is *not* the same as a rotate-right; the RHS of a wrapping shift-right is restricted\nto the range of the type, rather than the bits shifted out of the LHS being returned to the other\nend. The primitive integer types all implement a [`rotate_right`](Self::rotate_right) function,\nwhich may be what you want instead.\n\n# Examples\n\n```\nassert_eq!((-128i64).wrapping_shr(7), -1);\nassert_eq!((-128i16).wrapping_shr(64), -128);\n```","links":{"Self::rotate_right":49559},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"const_int_methods\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 2, patch: 0})}, feature: \"num_wrapping\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"u32"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9880":{"id":9880,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\alloc\\mod.rs","begin":[31,34],"end":[31,36]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 32838, is_soft: false}, feature: \"allocator_api\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":["assert_receiver_is_total_eq"],"trait":{"path":"Eq","id":41,"args":null},"for":{"resolved_path":{"path":"AllocError","id":8956,"args":null}},"items":[],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"31678":{"id":31678,"crate_id":0,"name":"vld1_dup_p16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[14323,1],"end":[14325,2]},"visibility":"public","docs":"Load one s