Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"BitAndAssign","id":2419,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}},"items":[6387],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"49984":{"id":49984,"crate_id":0,"name":"shl_exact","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[343,5],"end":[364,6]},"visibility":"public","docs":"Exact shift left. Computes `self << rhs` as long as it can be reversed losslessly.\n\nReturns `None` if any bits that would be shifted out differ from the resulting sign bit\nor if `rhs` >=\n`i128::BITS`.\nOtherwise, returns `Some(self << rhs)`.\n\n# Examples\n\n```\n#![feature(exact_bitshifts)]\n\nassert_eq!(0x1i128.shl_exact(4), Some(0x10));\nassert_eq!(0x1i128.shl_exact(i128::BITS - 2), Some(1 << i128::BITS - 2));\nassert_eq!(0x1i128.shl_exact(i128::BITS - 1), None);\nassert_eq!((-0x2i128).shl_exact(i128::BITS - 2), Some(-0x2 << i128::BITS - 2));\nassert_eq!((-0x2i128).shl_exact(i128::BITS - 1), None);\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 144336, is_soft: false}, feature: \"exact_bitshifts\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"u32"}]],"output":{"resolved_path":{"path":"O