it) floating-point elements in a and b, alternatively subtract and add packed elements in c from/to the intermediate result, and store the results in dst using writemask k (elements are copied from c when the corresponding mask bit is not set).\\\n\nRounding is done according to the rounding\\[3:0\\] parameter, which can be one of:\\\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask3_fmsubadd_round_pd&expand=2697)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vfmsubadd, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512d","id":9332,"args":null}}],["b",{"resolved_path":{"path":"__m512d","id":9332,"args":null}}],["c",{"resolved_path":{"path":"__m512d","id":9332,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512d","id":9332,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18580":{"id":18580,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u8"},"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}}],"constraints":[]}}}}}}}},"40378":{"id":40378,"crate_id":0,"name":"_mm512_maskz_popcnt_epi8","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512bitalg.rs","begin":[213,1],"end":[221,2]},"visibility":"public","docs":"For each packed 8-bit integer maps the value to the number of logical 1 bits.\n\nUses the writemask in k - elements are zeroed in the result if the corresponding mask bit is not set.\nOtherwise the computation result is written into the result.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_maskz_popcnt_epi8)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vpopcntb))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512bitalg"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"crate::core_arch::x86::__mmask64","id":38832,"args":null}}],["a",{"resolved_path":{"path":"crate::core_arch::x86::__m512i","id":9326,"args":null}}]],"output":{"resolved_path":{"path":"crate::core_arch::x86::__m512i","id":9326,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22431":{"id":22431,"crate_id":0,"name":"from_residual","span":{"filename":"library\\core\\src\\option.rs","begin":[2691,5],"end":[2693,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["ops::Yeet",{"resolved_path":{"path":"ops::Yeet","id":11998,"args":{"angle_bracketed":{"args":[{"type":{"tuple":[]}}],"constraints":[]}}}}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44229":{"id":44229,"crate_id":0,"name":"memory_grow","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\wasm32\\memory.rs","begin":[53,1],"end":[58,2]},"visibility":"public","docs":"Corresponding intrinsic to wasm's [`memory.grow` instruction][instr]\n\nThis function, when called, will attempt to grow the default linear memory\nby the specified `delta` of pages. The current WebAssembly page size is\n65536 bytes (64 KB). If memory is successfully grown then the previous size\nof memory, in pages, is returned. If memory cannot be grown then\n`usize::MAX` is returned.\n\nThe argument `MEM` is the numerical index of which memory to return the\nsize of. Note that currently the WebAssembly specification only supports one\nmemory, so it is required that zero is passed in. The argument is present to\nbe forward-compatible with future WebAssembly revisions. If a nonzero\nargument is passed to this function it will currently unconditionally abort.\n\n[instr]: http://webassembly.github.io/spec/core/exec/instructions.html#exec-memory-grow","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(\"memory.grow\", MEM = 0))]"},{"other":"#[rustc_legacy_const_generics(0)]"},{"other":"#[doc(alias(\"memory.grow\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 33, patch: 0})}, feature: \"simd_wasm32\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["MEM",{"primitive":"u32"}],["delta",{"primitive":"usize"}]],"output":{"primitive":"usize"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"4484":{"id":4484,"crate_id":0,"name":"pow","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[940,1],"end":[940,75]},"visibility":"public","docs":"Raises self to the power of `exp`, using exponentiation by squaring.\n\n# Examples\n\nBasic usage:\n\n```\n#![feature(wrapping_int_impl)]\nuse std::num::Wrapping;\n\nassert_eq!(Wrapping(3i16).pow(4), Wrapping(81));\n```\n\nResults that are too large are wrapped:\n\n```\n#![feature(wrapping_int_impl)]\nuse std::num::Wrapping;\n\nassert_eq!(Wrapping(3i8).pow(5), Wrapping(-13));\nassert_eq!(Wrapping(3i8).pow(6), Wrapping(-39));\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 32463, is_soft: false}, feature: \"wrapping_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["exp",{"primitive":"u32"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"26282":{"id":26282,"crate_id":0,"name":"take","span":{"filename":"library\\core\\src\\option.rs","begin":[1841,5],"end":[1844,6]},"visibility":"public","docs":"Takes the value out of the option, leaving a [`None`] in its place.\n\n# Examples\n\n```\nlet mut x = Some(2);\nlet y = x.take();\nassert_eq!(x, None);\nassert_eq!(y, Some(2));\n\nlet mut x: Option<u32> = None;\nlet y = x.take();\nassert_eq!(x, None);\nassert_eq!(y, None);\n```","links":{"`None`":81},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 83, patch: 0})}, feature: \"const_option\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"48080":{"id":48080,"crate_id":0,"name":"leading_zeros","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\simd\\num\\uint.rs","begin":[262,1],"end":[262,72]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"8335":{"id":8335,"crate_id":0,"name":"get_unchecked_mut","span":{"filename":"library\\core\\src\\ptr\\non_null.rs","begin":[1636,5],"end":[1643,6]},"visibility":"public","docs":"Returns a raw pointer to an element or subslice, without doing bounds\nchecking.\n\nCalling this method with an out-of-bounds index or when `self` is not dereferenceable\nis *[undefined behavior]* even if the resulting pointer is not used.\n\n[undefined behavior]: https://doc.rust-lang.org/reference/behavior-considered-undefined.html\n\n# Examples\n\n```\n#![feature(slice_ptr_get)]\nuse std::ptr::NonNull;\n\nlet x = &mut [1, 2, 4];\nlet x = NonNull::slice_from_raw_parts(NonNull::new(x.as_mut_ptr()).unwrap(), x.len());\n\nunsafe {\n    assert_eq!(x.get_unchecked_mut(1).as_ptr(), x.as_non_null_ptr().as_ptr().add(1));\n}\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143775, is_soft: false}, feature: \"const_index\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 74265, is_soft: false}, feature: \"slice_ptr_get\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["index",{"generic":"I"}]],"output":{"resolved_path":{"path":"NonNull","id":8263,"args":{"angle_bracketed":{"args":[{"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"generic":"I"},"trait":{"path":"","id":8336,"args":null}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[{"name":"I","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"I"},"bounds":[{"trait_bound":{"trait":{"path":"SliceIndex","id":8336,"args":{"angle_bracketed":{"args":[{"type":{"slice":{"generic":"T"}}}],"constraints":[]}}},"generic_params":[],"modifier":"maybe_const"}}],"generic_params":[]}}]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"12186":{"id":12186,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"'a","kind":{"lifetime":{"outlives":[]}}},{"name":"P","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"qualified_path":{"name":"Searcher","ar