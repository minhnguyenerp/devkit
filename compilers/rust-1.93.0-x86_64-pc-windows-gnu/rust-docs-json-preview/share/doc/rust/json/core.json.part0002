press exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_cvt_roundi64_sh)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vcvtsi2sh, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["b",{"primitive":"i64"}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9344,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"2026":{"id":2026,"crate_id":0,"name":"MIN","span":{"filename":"library\\core\\src\\num\\saturating.rs","begin":[891,1],"end":[891,77]},"visibility":"public","docs":"Returns the smallest value that can be represented by this integer type.\n\n# Examples\n\n```\nuse std::num::Saturating;\n\nassert_eq!(<Saturating<u64>>::MIN, Saturating(u64::MIN));\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\"}}]"}],"deprecation":null,"inner":{"assoc_const":{"type":{"generic":"Self"},"value":"_"}}},"23824":{"id":23824,"crate_id":0,"name":"len","span":{"filename":"library\\core\\src\\iter\\adapters\\cloned.rs","begin":[107,5],"end":[109