: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"UpperHex","id":1356,"args":null},"for":{"primitive":"u128"},"items":[29189],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"50988":{"id":50988,"crate_id":0,"name":"unchecked_disjoint_bitor","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[1269,5],"end":[1290,6]},"visibility":"public","docs":"Same value as `self | other`, but UB if any bit position is set in both inputs.\n\nThis is a situational micro-optimization for places where you'd rather\nuse addition on some platforms and bitwise or on other platforms, based\non exactly which instructions combine better with whatever else you're\ndoing.  Note that there's no reason to bother using this for places\nwhere it's clear from the operations involved that they can't overlap.\nFor example, if you're combining `u16`s into a `u32` with\n`((a as u32) << 16) | (b as u32)`, that's fine, as the backend will\nknow those sides of the `|` are disjoint without needing help.\n\n# Examples\n\n```\n#![feature(disjoint_bitor)]\n\n// SAFETY: `1` and `4` have no bits in common.\nunsafe {\n    assert_eq!(1_usize.unchecked_disjoint_bitor(4), 5);\n}\n```\n\n# Safety\n\nRequires that `(self & other) == 0`, otherwise it's immediate UB.\n\nEquivalently, requires that `(self | other) == (self + other)`.","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 135758, is_soft: false}, feature: \"disjoint_bitor\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 135758, is_soft: false}, feature: \"disjoint_bitor\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"11243":{"id":11243,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[437,5],"end":[437,55]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143773, is_soft: false}, feature: \"const_convert\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 34, patch: 0})}, feature: \"try_from\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"TryFrom","id":163,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"isize"}}],"constraints":[]}}},"for":{"primitive":"u8"},"items":[11241,11242],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"33041":{"id":33041,"crate_id":0,"name":"vreinterpret_p16_p8","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[53071,1],"end":[53073,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpret_p16_p8)","links":{},"attrs":[{"other":"#[<cfg_trace>(target_endian = \"little\")]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr_trace>(all(test, target_arch = \"arm\"), assert_instr(nop))]"},{"other":"#[<cfg_attr_trace>(all(test,\nany(target_arch = \"aarch64\", target_arch = \"arm64ec\")), assert_instr(nop))]"},{"other":"#[<cfg_attr_trace>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\",\nunstable(feature = \"