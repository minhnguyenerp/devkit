ing mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_mask_cmpgt_epu32_mask&expand=930)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vpcmp))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k1",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128i","id":9308,"args":null}}],["b",{"resolved_path":{"path":"__m128i","id":9308,"args":null}}]],"output":{"resolved_path":{"path":"__mmask8","id":35946,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19967":{"id":19967,"crate_id":0,"name":"shr","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"usize"}]],"output":{"primitive":"i128"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"41765":{"id":41765,"crate_id":0,"name":"_bittest64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86_64\\bt.rs","begin":[27,1],"end":[38,2]},"visibility":"public","docs":"Returns the bit in position `b` of the memory addressed by `p`.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_bittest64)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(bt))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 55, patch: 0})}, feature: \"simd_x86_bittest\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["p",{"raw_pointer":{"is_mutable":false,"type":{"primitive":"i64"}}}],["b",{"primitive":"i64"}]],"output":{"primitive":"u8"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"2020":{"id":2020,"crate_id":0,"name":"from_be","span":{"filename":"library\\core\\src\\num\\saturating.rs","begin":[891,1],"end":[891,77]},"visibility":"public","docs":"Converts an integer from big endian to the target's endianness.\n\nOn big endian this is a no-op. On little endian the bytes are\nswapped.\n\n# Examples\n\n```\nuse std::num::Saturating;\n\nlet n = Saturating(0x1Au32);\n\nif cfg!(target_endian = \"big\") {\n    assert_eq!(<Saturating<u32>>::from_be(n), n)\n} else {\n    assert_eq!(<Saturating<u32>>::from_be(n), n.swap_bytes())\n}\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23818":{"id":23818,"crate_id":0,"name":"fold","span":{"filename":"library\\core\\src\\iter\\adapters\\cloned.rs","begin":[57,5],"end":[62,6]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["init",{"generic":"Acc"}],["f",{"generic":"F"}]],"output":{"generic":"Acc"},"is_c_variadic":false},"generics":{"params":[{"name":"Acc","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"F","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"F"},"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"generic":"Acc"},{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":77,"args":null}}}],"output":{"generic":"Acc"}}}},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"45616":{"id":45616,"crate_id":0,"name":"lsx_vbitset_h","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lsx\\generated.rs","begin":[1850,1],"end":[1852,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9440,"args":null}}],["b",{"resolved_path":{"path":"m128i","id":9440,"args":null}}]],"output":{"resolved_path":{"path":"m128i","id":9440,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5871":{"id":5871,"crate_id":0,"name":"bitand_assign","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}}}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"27669":{"id":27669,"crate_id":0,"name":"fetch_or","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[2409,5],"end":[2412,6]},"visibility":"public","docs":"Performs a bitwise \"or\" operation on the address of the current pointer,\nand the argument `val`, and stores a pointer with provenance of the\ncurrent pointer and the resulting address.\n\nThis is equivalent to using [`map_addr`] to atomically perform\n`ptr = ptr.map_addr(|a| a | val)`. This can be used in tagged\npointer schemes to atomically set tag bits.\n\n**Caveat**: This operation returns the previous value. To compute the\nstored value without losing provenance, you may use [`map_addr`]. For\nexample: `a.fetch_or(val).map_addr(|a| a | val)`.\n\n`fetch_or` takes an [`Ordering`] argument which describes the memory\nordering of this operation. All ordering modes are possible. Note that\nusing [`Acquire`] makes the store part of this operation [`Relaxed`],\nand using [`Release`] makes the load part [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic\noperations on [`AtomicPtr`].\n\nThis API and its claimed semantics are part of the Strict Provenance\nexperiment, see the [module documentation for `ptr`][crate::ptr] for\ndetails.\n\n[`map_addr`]: pointer::map_addr\n\n# Examples\n\n```\nuse core::sync::atomic::{AtomicPtr, Ordering};\n\nlet pointer = &mut 3i64 as *mut i64;\n\nlet atom = AtomicPtr::<i64>::new(pointer);\n// Tag the bottom bit of the pointer.\nassert_eq!(atom.fetch_or(1, Ordering::Relaxed).addr() & 1, 0);\n// Extract and untag.\nlet tagged = atom.load(Ordering::Relaxed);\nassert_eq!(tagged.addr() & 1, 1);\nassert_eq!(tagged.map_addr(|p| p & !1), pointer);\n```","links":{"crate::ptr":7868,"`Acquire`":27624,"`Relaxed`":27625,"pointer::map_addr":8286,"`AtomicPtr`":8410,"`Ordering`":8789,"`Release`":27626},"attrs":[{"other":"#[<cfg_trace>(target_has_atomic = \"ptr\")]"},{"other":"#[<cfg_attr_trace>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"strict_provenance_atomic_ptr\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = RustcShouldNotBeCalledOnConstItems]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["val",{"primitive":"usize"}],["order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}]],"output":{"raw_pointer":{"is_mutable":true,"type":{"generic":"T"}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49467":{"id":49467,"crate_id":0,"name":"to_ne_bytes","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[247,5],"end":[266,6]},"visibility":"public","docs":"Returns the memory representation of this integer as a byte array in\nnative byte order.\n\nAs the target platform's native endianness is used, portable code\nshould use [`to_be_bytes`] or [`to_le_bytes`], as appropriate,\ninstead.\n\n\n**Note**: This function is meaningless on `i8`. Byte order does not exist as a\nconcept for byte-sized integers. This function is only provided in symmetry\nwith larger integer types. You can cast from and to `u8` using\n[`cast_signed`](u8::cast_signed) and [`cast_unsigned`](Self::cast_unsigned).\n\n[`to_be_bytes`]: Self::to_be_bytes\n[`to_le_bytes`]: Self::to_le_bytes\n\n# Examples\n\n```\nlet bytes = 0x12i8.to_ne_bytes();\nassert_eq!(\n    bytes,\n    if cfg!(target_endian = \"big\") {\n        [0x12]\n    } else {\n        [0x12]\n    }\n);\n```","links":{"Self::to_be_bytes":49361,"Self::to_le_bytes":49363,"Self::cast_unsigned":49352,"u8::cast_signed":49466},"attrs":[{"other":"#[allow(unnecessary_transmutes)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 44, patch: 0})}, feature: \"const_int_conversion\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"int_to_from_bytes\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"array":{"type":{"primitive":"u8"},"len":"1"}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9722":{"id":9722,"crate_id":0,"name":"eq","span":{"filename":"library\\core\\src\\ffi\\c_str.rs","begin":[125,23],"end":[125,32]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"FromBytesWithNulError","id":8605,"args":null}}}}]],"output":{"primitive":"bool"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31520":{