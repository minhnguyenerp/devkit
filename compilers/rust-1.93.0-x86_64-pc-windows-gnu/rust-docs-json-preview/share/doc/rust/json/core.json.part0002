n[`from_u32`]: #method.from_u32\n\n# Examples\n\nBasic usage:\n\n```\nlet c = unsafe { char::from_u32_unchecked(0x2764) };\n\nassert_eq!('❤', c);\n```","links":{"`u32`":260},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 81, patch: 0})}, feature: \"const_char_from_u32_unchecked\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 52, patch: 0})}, feature: \"assoc_char_funcs\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["i",{"primitive":"u32"}]],"output":{"primitive":"char"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"5354":{"id":5354,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 8, patch: 0})}, feature: \"op_assign_traits\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"BitAndAssign","id":2419,"args":null},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}}},"items":[5353],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"27152":{"id":27152,"crate_id":0,"name":"panic_nounwind_fmt","span":{"filename":"library\\core\\src\\panicking.rs","begin":[95,1],"end":[125,2]},"visibility":"p