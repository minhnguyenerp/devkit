:false,"is_synthetic":false,"blanket_impl":null}}},"51061":{"id":51061,"crate_id":0,"name":"from_ne_bytes","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[1269,5],"end":[1290,6]},"visibility":"public","docs":"Creates a native endian integer value from its memory representation\nas a byte array in native endianness.\n\nAs the target platform's native endianness is used, portable code\nlikely wants to use [`from_be_bytes`] or [`from_le_bytes`], as\nappropriate instead.\n\n[`from_be_bytes`]: Self::from_be_bytes\n[`from_le_bytes`]: Self::from_le_bytes\n\n\n**Note**: This function takes an array of length 2, 4 or 8 bytes\ndepending on the target pointer size.\n\n# Examples\n\n```\nlet value = usize::from_ne_bytes(if cfg!(target_endian = \"big\") {\n    [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]\n} else {\n    [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]\n});\nassert_eq!(value, 0x1234567890123456);\n```\n\nWhen starting from a slice rather than an array, fallible conversion APIs can be used:\n\n```\nfn read_ne_usize(input: &mut &[u8]) -> usize {\n    let (int_bytes, rest) = input.split_at(size_of::<usize>());\n    *input = rest;\n    usize::from_ne_bytes(int_bytes.try_into().unwrap())\n}\n```","links":{"Self::from_le_bytes":51060,"Self::from_be_bytes":51059},"attrs":[{"other":"#[allow(unnecessary_transmutes)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 44, patch: 0})}, feature: \"const_int_conversion\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"int_to_from_bytes\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["bytes",{"array":{"type":{"primitive":"u8"},"len":"8"}}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"11316":{"id":11316,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[827,1],"end":[837,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143773, is_soft: false}, feature: \"const_convert\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 34, patch: 0})}, feature: \"try_from\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"U","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"U"},"bounds":[{"trait_bound":{"trait":{"path":"Into","id":63,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"generic_params":[],"modifier":"maybe_const"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"TryFrom","id":163,"args":{"angle_bracketed":{"args":[{"type":{"generic":"U"}}],"constraints":[]}}},"for":{"generic":"T"},"items":[700,702],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"33114":{"id":33114,"crate_id":0,"name":"vreinterpret_u32_p64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[56547,1],"end":[56549,2]},"visibility":"public","docs":"Vector reinterpret cast operation\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vreinterpret_u32_p64)","links":{},"attrs":[{"other":"#[<cfg_trace>(target_endian = \"little\")]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_feature(enable = \"v8\"))]"},{"other":"#[<cfg_attr_trace>(all(test, target_arch = \"arm\"), a