 as it can be reversed losslessly.\n\nReturns `None` if any non-zero bits would be shifted out or if `rhs` >=\n`u64::BITS`.\nOtherwise, returns `Some(self >> rhs)`.\n\n# Examples\n\n```\n#![feature(exact_bitshifts)]\n\nassert_eq!(0x10u64.shr_exact(4), Some(0x1));\nassert_eq!(0x10u64.shr_exact(5), None);\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 144336, is_soft: false}, feature: \"exact_bitshifts\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"u32"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10823":{"id":10823,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\masks.rs","begin":[648,1],"end":[648,42]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"N","kind":{"const":{"type":{"primitive":"usize"},"default":null}}}],"where_predicates":[{"bound_predicate":{"type":{"resolved_path":{"path":"LaneCount","id":9493,"args":{"angle_bracketed":{"args":[{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}},"bounds":[{"trait_bound":{"trait":{"path":"SupportedLaneCount","id":9494,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"Mask","id":9495,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}},{"const":{"expr":"N"