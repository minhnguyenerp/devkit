sibility":"public","docs":"Convert the exponent of each packed half-precision (16-bit) floating-point element in a to a half-precision\n(16-bit) floating-point number representing the integer exponent, and store the results in dst using writemask k\n(elements are copied from src when the corresponding mask bit is not set). This intrinsic essentially calculates\n`floor(log2(x))` for each element.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_mask_getexp_ph)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vgetexpph))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}],["k",{"resolved_path":{"path":"__mmask32","id":38824,"args":null}}],["a",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}]],"output":{"resolved_path":{"path":"__m512h","id":9350,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1290":{"id":1290,"crate_id":0,"name":"lowest_one","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2438,1],"end":[2448,2]},"visibility":"public","docs":"Returns the index of the lowest bit set to one in `self`.\n\n# Examples\n\n```\n#![feature(int_lowest_highest_one)]\n\n# use core::num::NonZero;\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nassert_eq!(NonZero::<isize>::new(0b1)?.lowest_one(), 0);\nassert_eq!(NonZero::<isize>::new(0b1_0000)?.lowest_one(), 4);\nassert_eq!(NonZero::<isize>::new(0b1_1111)?.lowest_one(), 0);\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstab