f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["c",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}]],"output":{"resolved_path":{"path":"__m128h","id":9344,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1071":{"id":1071,"crate_id":0,"name":"count_ones","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2351,1],"end":[2361,2]},"visibility":"public","docs":"Returns the number of ones in the binary representation of `self`.\n\n# Examples\n\n```\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet a = NonZero::<i8>::new(0b100_0000)?;\nlet b = NonZero::<i8>::new(0b100_0011)?;\n\nassert_eq!(a.count_ones(), NonZero::new(1)?);\nassert_eq!(b.count_ones(), NonZero::new(3)?);\n# Some(())\n# }\n```\n","links":{},"attrs":[{"other":"#[doc(alias = \"popcount\")]"},{"other":"#[doc(alias = \"popcnt\")]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 86, patch: 0})}, feature: \"non_zero_count_ones\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 86, patch: 0})}, feature: \"non_zero_count_ones\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"prim