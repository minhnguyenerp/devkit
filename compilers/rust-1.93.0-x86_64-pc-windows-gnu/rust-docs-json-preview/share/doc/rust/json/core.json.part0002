{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"resolved_path":{"path":"Simd","id":9499,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}},{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}}}}},"38352":{"id":38352,"crate_id":0,"name":"_mm_maskz_rcp14_sd","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[36879,1],"end":[36881,2]},"visibility":"public","docs":"Compute the approximate reciprocal of the lower double-precision (64-bit) floating-point element in b, store the result in the lower element of dst using zeromask k (the element is zeroed out when mask bit 0 is not set), and copy the upper element from a to the upper element of dst. The maximum relative error for this approximation is less than 2^-14.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=mm_maskz_rcp14_sd&expand=4504)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vrcp14sd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128d","id":9314,"args":null}}],["b",{"resolved_path":{"path":"__m128d","id":9314,"args":null}}]],"output":{"resolved_path":{"path":"__m128d","id":9314,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"20405":{"id":20405,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[755,1],"end":[755,81]},"visibility":"default","docs":n