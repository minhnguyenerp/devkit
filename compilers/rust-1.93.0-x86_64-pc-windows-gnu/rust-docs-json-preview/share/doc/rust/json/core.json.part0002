\n# fn test() -> Option<()> {\nlet pos_five = NonZero::new(5i64)?;\nlet neg_five = NonZero::new(-5i64)?;\nlet min = NonZero::new(i64::MIN)?;\nlet min_plus_one = NonZero::new(i64::MIN + 1)?;\nlet max = NonZero::new(i64::MAX)?;\n\nassert_eq!(pos_five.saturating_neg(), neg_five);\nassert_eq!(min.saturating_neg(), max);\nassert_eq!(max.saturating_neg(), min_plus_one);\n# Some(())\n# }\n```","links":{"`NonZero::<i64>::MAX`":841},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 71, patch: 0})}, feature: \"nonzero_negation_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 71, patch: 0})}, feature: \"nonzero_negation_ops\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23027":{"id":23027,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\cell.rs","begin":[537,1],"end":[582,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"Copy","id":1,"args":null},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":null,"for":{"resolved_path":{"path":"Cell","id":8569,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"items":[23025,23026],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"44825":{"id":44825,"crate_id":0,"name":"lasx_xvbitclr_b","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\