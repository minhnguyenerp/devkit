X), Some(i16::MIN));\nassert_eq!((i16::MAX as u16 + 1).checked_signed_diff(0), None);\nassert_eq!(u16::MAX.checked_signed_diff(u16::MAX), Some(0));\n```","links":{"`i16`":218},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"unsigned_signed_diff\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"unsigned_signed_diff\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10525":{"id":10525,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[107,1],"end":[107,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143773, is_soft: false}, feature: \"const_convert\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 26, patch: 0})}, feature: \"i128\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}},"for":{"primitive":"u128"},"items":[10524],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"32323":{"id":32323,"crate_id":0,"name":"vmlal_n_s32","span":{"filename":"library\\core\\src\\..\\..\\stdarch