 nearest, and suppress exceptions\n * [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`]     // round down, and suppress exceptions\n * [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`]     // round up, and suppress exceptions\n * [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`]        // truncate, and suppress exceptions\n * [`_MM_FROUND_CUR_DIRECTION`] | [`_MM_FROUND_NO_EXC`]  // use MXCSR.RC and suppress exceptions; see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask_cvt_roundps_ph&expand=1355)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_CUR_DIRECTION`":35318,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_NO_EXC`":35320},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vcvtps2ph, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m256i","id":9317,"args":null}}],["k",{"resolved_path":{"path":"__mmask16","id":35943,"args":null}}],["a",{"resolved_path":{"path":"__m512","id":9329,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m256i","id":9317,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18945":{"id":18945,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u64"}}}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u64"}}},"items":[18943,18944],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"40743":{"id":40743,"crate_id":0,"name":"_mm_maskz_cmul_round_sch","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[3626,1],"end":[3633,2]},"visibility":"public","docs":"Multiply the lower complex numbers in a by the complex conjugates of the lower complex numbers in b,\nand store the results in dst using zeromask k (the element is zeroed out when mask bit 0 is not set).\nEach complex number is composed of two adjacent half-precision (16-bit) floating-point elements, which\ndefines the complex number `complex = vec.fp16[0] + i * vec.fp16[1]`, or the complex conjugate `conjugate = vec.fp16[0] - i * vec.fp16[1]`.\n\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_maskz_cmul_round_sch)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vfcmulcsh, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9344,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"998":{"id":998,"crate_id":0,"name":"to_be","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2300,1],"end":[2310,2]},"visibility":"public","docs":"Converts `self` to big endian from the target's endianness.\n\nOn big endian this is a no-op. On little endian the bytes are\nswapped.\n\n# Examples\n\n```\n#![feature(nonzero_bitwise)]\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet n = NonZero::new(0x1Au128)?;\n\nif cfg!(target_endian = \"big\") {\n    assert_eq!(n.to_be(), n)\n} else {\n    assert_eq!(n.to_be(), n.swap_bytes())\n}\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 128281, is_soft: false}, feature: \"nonzero_bitwise\"}}]"},{"other":"#[attr = Inline(