}}},"46139":{"id":46139,"crate_id":0,"name":"lsx_vmaddwev_q_du_d","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lsx\\generated.rs","begin":[5721,1],"end":[5723,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9440,"args":null}}],["b",{"resolved_path":{"path":"m128i","id":9440,"args":null}}],["c",{"resolved_path":{"path":"m128i","id":9440,"args":null}}]],"output":{"resolved_path":{"path":"m128i","id":9440,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"6394":{"id":6394,"crate_id":0,"name":"neg","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"28192":{"id":28192,"crate_id":0,"name":"finish","span":{"filename":"library\\core\\src\\fmt\\builders.rs","begin":[431,5],"end":[441,6]},"visibility":"public","docs":"Finishes output and returns any error encountered.\n\n# Examples\n\n```\nuse std::fmt;\n\nstruct Foo(i32, String);\n\nimpl fmt::Debug for Foo {\n    fn fmt(&self, fmt: &mut fmt::Formatter<'_>) -> fmt::Result {\n        fmt.debug_tuple(\"Foo\")\n           .field(&self.0)\n           .field(&self.1)\n           .finish() // You need to call it to \"finish\"