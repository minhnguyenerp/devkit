r {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"SuperError is here!\")\n    }\n}\n\nimpl Error for SuperError {\n    fn source(&self) -> Option<&(dyn Error + 'static)> {\n        Some(&self.source)\n    }\n}\n\n#[derive(Debug)]\nstruct SuperErrorSideKick;\n\nimpl fmt::Display for SuperErrorSideKick {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"SuperErrorSideKick is here!\")\n    }\n}\n\nimpl Error for SuperErrorSideKick {}\n\nfn get_super_error() -> Result<(), SuperError> {\n    Err(SuperError { source: SuperErrorSideKick })\n}\n\nfn main() {\n    match get_super_error() {\n        Err(e) => {\n            println!(\"Error: {e}\");\n            println!(\"Caused by: {}\", e.source().unwrap());\n        }\n        _ => println!(\"No error\"),\n    }\n}\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 30, patch: 0})}, feature: \"error_source\"}}]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"dyn_trait":{"traits":[{"trait":{"path":"Error","id":725,"args":null},"generic_params":[]}],"lifetime":"'static"}}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"33412":{"id":33412,"crate_id":0,"name":"vst1q_s64_x2","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[65450,1],"end":[65459,2]},"visibility":"public","docs":"Store multiple single-element structures from one, two, three, or four registers\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vst1q_s64_x2)\n## Safety\n  * Neon instrinsic unsafe","links":{},"attrs":[{"other":"#[<cfg_trace>(not(target_arch = \"arm\"))]"},{"other":"#[<cfg_attr_trace>(test, assert_instr(st1))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"raw_pointer":{"is_mutable":true,"type":{"primitive":"i64"}}}],["b",{"resolved_path":{"path":"int64x2x2_t","id":9263,"args":null}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"15465":{"id":15465,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[800,1],"end":[800,90]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 8, patch: 0})}, feature: \"op_assign_traits\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"AddAssign","id":2264,"args":null},"for":{"primitive":"f32"},"items":[15464],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"37263":{"id":37263,"crate_id":0,"name":"_mm512_rolv_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[21174,1],"end":[21182,2]},"visibility":"public","docs":"Rotate the bits in each packed 32-bit integer in a to the left by the number of bits specified in the corresponding element of b, and store the results in dst.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_rolv_epi32&expand=4703)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vprolvd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512i","id":9326,"args":null}}],["b",{"resolved_path":{"path":"__m512i","id":9326,"args":null}}]],"output":{"resolved_path":{"path":"__m512i","id":9326,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"19316":{"id":19316,"crate_id":0,"name":"shr","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i128"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"usize"},"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"41114":{"id":41114,"crate_id":0,"name":"_mm_maskz_reduce_sh","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[11017,1],"end":[11020,2]},"visibility":"public","docs":"Extract the reduced argument of the lower half-precision (16-bit) floating-point element in b by\nthe number of bits specified by imm8, store the result in the lower element of dst using zeromask k\n(the element is zeroed out when mask bit 0 is not set), and copy the upper 7 packed elements from a\nto the upper elements of dst.\n\nRounding is done according to the imm8 parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] : round to nearest\n* [`_MM_FROUND_TO_NEG_INF`] : round down\n* [`_MM_FROUND_TO_POS_INF`] : round up\n* [`_MM_FROUND_TO_ZERO`] : truncate\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_maskz_reduce_sh)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_CUR_DIRECTION`":35318,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vreducesh, IMM8 = 0))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128h","id":9344,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1369":{"id":1369,"crate_id":0,"name":"clone","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[191,5],"end":[193,6]},"visibility":"default","docs":null,