itespace) represent an error. Underscores (which are accepted in Rust literals)\nalso represent an error.\n\n# Examples\n\n```\n#![feature(int_from_ascii)]\n\nassert_eq!(u64::from_ascii(b\"+10\"), Ok(10));\n```\nTrailing space returns error:\n```\n# #![feature(int_from_ascii)]\n#\nassert!(u64::from_ascii(b\"1 \").is_err());\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 134821, is_soft: false}, feature: \"int_from_ascii\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"slice":{"primitive":"u8"}}}}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}},{"type":{"resolved_path":{"path":"ParseIntError","id":733,"args":null}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10884":{"id":10884,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\vendor\\x86.rs","begin":[18,1],"end":[18,45]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"__m512i","id":9326,"args":null}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"u16x32","id":10881,"args":null}},"items":[10883],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"32682":{"id":32682,"crate_id":0,"name":"vqrdmulh_n_s32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[38739,1],"end":[38741,2]},"visibility":"public","docs":"Vector saturating rounding doublin