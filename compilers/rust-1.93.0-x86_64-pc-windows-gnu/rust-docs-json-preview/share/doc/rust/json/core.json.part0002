s_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23246":{"id":23246,"crate_id":0,"name":"decode_utf16","span":{"filename":"library\\core\\src\\char\\methods.rs","begin":[150,5],"end":[152,6]},"visibility":"public","docs":"Creates an iterator over the native endian UTF-16 encoded code points in `iter`,\nreturning unpaired surrogates as `Err`s.\n\n# Examples\n\nBasic usage:\n\n```\n// 𝄞mus<invalid>ic<invalid>\nlet v = [\n    0xD834, 0xDD1E, 0x006d, 0x0075, 0x0073, 0xDD1E, 0x0069, 0x0063, 0xD834,\n];\n\nassert_eq!(\n    char::decode_utf16(v)\n        .map(|r| r.map_err(|e| e.unpaired_surrogate()))\n        .collect::<Vec<_>>(),\n    vec![\n        Ok('𝄞'),\n        Ok('m'), Ok('u'), Ok('s'),\n        Err(0xDD1E),\n        Ok('i'), Ok('c'),\n        Err(0xD834)\n    ]\n);\n```\n\nA lossy decoder can be obtained by replacing `Err` results with the replacement character:\n\n```\n// 𝄞mus<invalid>ic<invalid>\nlet v = [\n    0xD834, 0xDD1E, 0x006d, 0x0075, 0x0073, 0xDD1E, 0x0069, 0x0063, 0xD834,\n];\n\nassert_eq!(\n    char::decode_utf16(v)\n       .map(|r| r.unwrap_or(char::REPLACEMENT_CHARACTER))\n       .collect::<String>(),\n    \"𝄞mus�ic�\"\n);\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 52, patch: 0})}, feature: \"assoc_char_funcs\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["iter",{"generic":"I"}]],"output":{"resolved_path":{"path":"DecodeUtf16","id":8581,"args":{"angle_bracketed":{"args":[{"type":{"qualified_path":{"name":"IntoIter","args":null,"self_type":{"generic":"I"},"trait":{"path":"","id":75,"args":null}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[{"name":"I","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"IntoIterator","id":75,"args":{"angle_bracketed":{"args":[],"constraints":[{"name":"Item","args":null,"binding":{"equality":{"type":{"primitive":"u16"}}}}