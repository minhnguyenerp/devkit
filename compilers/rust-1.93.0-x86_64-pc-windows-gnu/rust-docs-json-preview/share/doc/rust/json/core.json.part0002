lue of self\nwithout any wrapping or panicking.\n\n# Example\n\n```\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet u_pos = NonZero::new(1u64)?;\nlet i_pos = NonZero::new(1i64)?;\nlet i_neg = NonZero::new(-1i64)?;\nlet i_min = NonZero::new(i64::MIN)?;\nlet u_max = NonZero::new(u64::MAX / 2 + 1)?;\n\nassert_eq!(u_pos, i_pos.unsigned_abs());\nassert_eq!(u_pos, i_neg.unsigned_abs());\nassert_eq!(u_max, i_min.unsigned_abs());\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 64, patch: 0})}, feature: \"const_nonzero_checked_ops\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 64, patch: 0})}, feature: \"nonzero_checked_ops\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23021":{"id":23021,"crate_id":0,"name":"swap","span":{"filename":"library\\core\\src\\cell.rs","begin":[466,5],"end":[492,6]},"visibility":"public","docs":"Swaps the values of two `Cell`s.\n\nThe difference with `std::mem::swap` is that this function doesn't\nrequire a `&mut` reference.\n\n# Panics\n\nThis function will panic if `self` and `other` are different `Cell`s that partially overlap.\n(Using just standard library methods, it is impossible to create such partially overlapping `Cell`s.\nHowever, unsafe code is allowed to e.g. create two `&Cell<[i32; 2]>` that partially overlap.)\n\n# Examples\n\n```\nuse std::cell::Cell;\n\nlet c1 = Cell::new(5i32);\nlet c2 = Cell::new(10i32);\nc1.swap(&c2);\nassert_eq!(10, c1.get());\nassert_eq!(5, c2.get());\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 17, patch: 0})}, feature: \"move_cell\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = RustcShouldNotBeCalledOnConstItems]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44819":{"id":44819,"crate_id":0,"name":"lasx_xvsrlr_w","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[1769,1],"end":[1771,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m256i","id":9431,"args":null}}],["b",{"resolved_path":{"path":"m256i","id":9431,"args":null}}]],"output":{"resolved_path":{"path":"m256i","id":9431,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5074":{"id":5074,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability 