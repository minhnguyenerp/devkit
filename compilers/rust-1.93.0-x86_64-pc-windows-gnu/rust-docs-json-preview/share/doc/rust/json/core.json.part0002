me":"library\\core\\src\\any.rs","begin":[138,1],"end":[142,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"outlives":"'static"},{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Any","id":707,"args":null},"for":{"resolved_path":{"path":"vector_signed_long_long","id":9476,"args":null}},"items":[704],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"6954":{"id":6954,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"SubAssign","id":2286,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i128"}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}},"items":[6953],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"28752":{"id":28752,"crate_id":0,"name":"fmt","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\mod.rs","begin":[228,23],"end":[228,28]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["f",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"resolved_path":{"path":"$crate::fmt::Formatter","id":709,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"}],"constraints":[]}}}}}}]],"output":{"resolved_path":{"path":"$crate::fmt::Result","id":710,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"50550":{"id":50550,"crate_id":0,"name":"strict_rem_euclid","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[1160,5],"end":[1181,6]},"visibility":"public","docs":"Strict Euclidean modulo. Computes `self.rem_euclid(rhs)`.\n\nStrict modulo calculation on unsigned types is just the regular\nremainder calculation. There's no way overflow could ever happen.\nThis function exists so that all operations are accounted for in the\nstrict operations. Since, for the positive integers, all common\ndefinitions of division are equal, this is exactly equal to\n`self.strict_rem(rhs)`.\n\n# Panics\n\nThis function will panic if `rhs` is zero.\n\n# Examples\n\n```\nassert_eq!(100u64.strict_rem_euclid(10), 0);\n```\n\nThe following panics because of division by zero:\n\n```should_panic\nlet _ = 5u64.strict_rem_euclid(0);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"strict_overflow_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 91, patch: 0})}, feature: \"strict_overflow_ops\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10805":{"id":10805,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\masks.rs","begin":[646,1],"end":[646,42]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"N","kind":{"const":{"type":{"primitive":"usize"},"default":null}}}],"where_predicates":[{"bound_predicate":{"type":{"resolved_path":{"path":"LaneCount","id":9493,"args":{"angle_bracketed":{"args":[{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}},"bounds":[{"trait_bound":{"trait":{"path":"SupportedLaneCount","id":9494,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"Mask","id":9495,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}},{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Mask","id":9495,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i32"}},{"const":{"expr":"N","value":null,"is_literal":false}}],"constraints":[]}}}},"items":[10804],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"32603":{"id":32603,"crate_id":0,"name":"vpmin_u16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[36748,1],"end":[36758,2]},"visibility":"public","docs":"Folding minimum of adjacent pairs\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vpmin_u16)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr_trace>(all(test, target_arch = \"arm\"), assert_instr(vpmin))]"},{"other":"#[<cfg_attr_trace>(all(test,\nany(target_arch = \"aarch64\", target_arch = \"arm64ec\")), assert_instr(uminp))]"},{"other":"#[<cfg_attr_trace>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"uint16x4_t","id":9008,"args":null}}],["b",{"resolved_path":{"path":"uint16x4_t","id":9008,"args":null}}]],"output":{"resolved_path":{"path":"uint16x4_t","id":9008,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"14656":{"id":14656,"crate_id":0,"name":"mul","span":{"filename":"library\\core\\src\\ops\\arith.rs","begin":[361,1],"end":[361,83]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"isize"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"isize"},"trait":{"path":"Mul","id":2296,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"isize"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"36454":{"id":36454,"crate_id":0,"name":"_mm_getmant_ps","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[7260,1],"end":[7270,2]},"visibility":"public","docs":"Normalize the mantissas of packed single-precision (32-bit) floating-point elements in a, and store the results in dst. This intrinsic essentially calculates ±(2^k)*|x.significand|, where k depends on the interval range defined by interv and the sign depends on sc and the source sign.\nThe mantissa is normalized to the interval specified by interv, which can take the following values:\n   _MM_MANT_NORM_1_2     // interval [1, 2)\n   _MM_MANT_NORM_p5_2    // interval [0.5, 2)\n   _MM_MANT_NORM_p5_1    // interval [0.5, 1)\n   _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\nThe sign is determined by sc which can take the following values:\n   _MM_MANT_SIGN_src     // sign = sign(src)\n   _MM_MANT_SIGN_zero    // sign = 0\n   _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_getmant_ps&expand=2874)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vgetmantps, NORM = 0, SIGN = 0))]"},{"other":"#[rustc_legacy_const_generics(1, 2)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128","id":9311,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36447,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36448,"args":null}}]],"output":{"resolved_path":{"path":"__m128","id":9311,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18507":{"id":18507,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u8"}}},"items":[18505,18506],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"40305":{"id":40305,"crate_id":0,"name":"_mm256_maskz_dpwssd_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512vnni.rs","begin":[89,1],"end":[94,2]},"visibility":"public","docs":"Multiply groups of 2 adjacent pairs of signed 16-bit integers in a with corresponding 16-bit integers in b, producing 2 intermediate signed 32-bit results. Sum these 2 results with the corresponding 32-bit integer in src, and store the packed 32-bit results in dst using zeromask k (elements are zeroed out when the corresponding mask bit is not set).\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_maskz_dpwssd_epi32&expand=2218)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vpdpwssd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512vnni","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["src",{"resolved_path":{"path":"__m256i","id":9317,"args":null}}],["a",{"resolved_path":{"path":"__m256i","id":9317,"args":null}}],["b",{"resolved_path":{"path":"__m256i","id":9317,"args":null}}]],"output":{"resolved_path":{"path":"__m256i","id":9317,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22358":{"id":22358,"crate_id":0,"name":"start_bound","span":{"filename":"library\\core\\src\\range.rs","begin":[360,5],"end":[362,6]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"Bound","id":8543,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"T"}}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44156":{"id":44156,"crate_id":0,"name":"i64x2_extmul_high_u32x4","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\wasm32\\simd128.rs","begin":[3695,1],"end":[3709,2]},"visibility":"public","docs":"Lane-wise integer extended multiplication producing twice wider result than\nthe inputs.\n\nEquivalent of `i64x2_mul(i64x2_extend_high_i32x4_u(a), i64x2_extend_high_i32x4_u(b))`","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(i64x2.extmul_high_i32x4_u))]"},{"other":"#[doc(alias(\"i64x2.extmul_high_i32x4_u\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 54, patch: 0})}, feature: \"wasm_simd\"}}]"},{"target_feature":{"enable":["simd128"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"v128","id":9383,"args":null}}],["b",{"resolved_path":{"path":"v128","id":9383,"args":null}}]],"output":{"resolved_path":{"path":"v128","id":9383,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"4411":{"id":4411,"crate_id":0,"name":"trailing_zeros","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[940,1],"end":[940,75]},"visibility":"public","docs":"Returns the number of trailing zeros in the binary representation of `self`.\n\n# Examples\n\nBasic usage:\n\n```\n#![feature(wrapping_int_impl)]\nuse std::num::Wrapping;\n\nlet n = Wrapping(0b0101000u64);\n\nassert_eq!(n.trailing_zeros(), 3);\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 32463, is_soft: false}, feature: \"wrapping_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"primitive":"u32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"26209":{"id":26209,"crate_id":0,"name":"flowinfo","span":{"filename":"library\\core\\src\\net\\socket_addr.rs","begin":[526,5],"end":[528,6]},"visibility":"public","docs":"Returns the flow information associated with this address.\n\nThis information corresponds to the `sin6_flowinfo` field in C's `netinet/in.h`,\nas specified in [IETF RFC 2553, Section 3.3].\nIt combines information about the flow label and the traffic class as specified\nin [IETF RFC 2460], respectively [Section 6] and [Section 7].\n\n[IETF RFC 2553, Section 3.3]: https://tools.ietf.org/html/rfc2553#section-3.3\n[IETF RFC 2460]: https://tools.ietf.org/html/rfc2460\n[Section 6]: https://tools.ietf.org/html/rfc2460#section-6\n[Section 7]: https://tools.ietf.org/html/rfc2460#section-7\n\n# Examples\n\n```\nuse std::net::{SocketAddrV6, Ipv6Addr};\n\nlet socket = SocketAddrV6::new(Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 1), 8080, 10, 0);\nassert_eq!(socket.flowinfo(), 10);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 69, patch: 0})}, feature: \"const_socketaddr\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"primitive":"u32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"48007":{"id":48007,"crate_id":0,"name":"trailing_ones","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\simd\\num\\int.rs","begin":[411,1],"end":[411,72]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"qualified_path":{"name":"Unsigned","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":47893,"args":null}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"8262":{"id":8262,"crate_id":0,"name":"PhantomData","span":{"filename":"library\\core\\src\\marker.rs","begin":[819,1],"end":[819,41]},"visibility":"public","docs":"Zero-sized type used to mark things that \"act like\" they own a `T`.\n\nAdding a `PhantomData<T>` field to your type tells the compiler that your\ntype acts as though it stores a value of type `T`, even though it doesn't\nreally. This information is used when computing certain safety properties.\n\nFor a more in-depth explanation of how to use `PhantomData<T>`, please see\n[the Nomicon](../../nomicon/phantom-data.html).\n\n# A ghastly note 👻👻👻\n\nThough they both have scary names, `PhantomData` and 'phantom types' are\nrelated, but not identical. A phantom type parameter is simply a type\nparameter which is never used. In Rust, this often causes the compiler to\ncomplain, and the solution is to add a \"dummy\" use by way of `PhantomData`.\n\n# Examples\n\n## Unused lifetime parameters\n\nPerhaps the most common use case for `PhantomData` is a struct that has an\nunused lifetime parameter, typically as part of some unsafe code. For\nexample, here is a struct `Slice` that has two pointers of type `*const T`,\npresumably pointing into an array somewhere:\n\n```compile_fail,E0392\nstruct Slice<'a, T> {\n    start: *const T,\n    end: *const T,\n}\n```\n\nThe intention is that the underlying data is only valid for the\nlifetime `'a`, so `Slice` should not outlive `'a`. However, this\nintent is not expressed in the code, since there are no uses of\nthe lifetime `'a` and hence it is not clear what data it applies\nto. We can correct this by telling the compiler to act *as if* the\n`Slice` struct contained a reference `&'a T`:\n\n```\nuse std::marker::PhantomData;\n\n# #[allow(dead_code)]\nstruct Slice<'a, T> {\n    start: *const T,\n    end: *const T,\n    phantom: PhantomData<&'a T>,\n}\n```\n\nThis also in turn infers the lifetime bound `T: 'a`, indicating\nthat any references in `T` are valid over the lifetime `'a`.\n\nWhen initializing a `Slice` you simply provide the value\n`PhantomData` for the field `phantom`:\n\n```\n# #![allow(dead_code)]\n# use std::marker::PhantomData;\n# struct Slice<'a, T> {\n#     start: *const T,\n#     end: *const T,\n#     phantom: PhantomData<&'a T>,\n# }\nfn borrow_vec<T>(vec: &Vec<T>) -> Slice<'_, T> {\n    let ptr = vec.as_ptr();\n    Slice {\n        start: ptr,\n        end: unsafe { ptr.add(vec.len()) },\n        phantom: PhantomData,\n    }\n}\n```\n\n## Unused type parameters\n\nIt sometimes happens that you have unused type parameters which\nindicate what type of data a struct is \"tied\" to, even though that\ndata is not actually found in the struct itself. Here is an\nexample where this arises with [FFI]. The foreign interface uses\nhandles of type `*mut ()` to refer to Rust values of different\ntypes. We track the Rust type using a phantom type parameter on\nthe struct `ExternalResource` which wraps a handle.\n\n[FFI]: ../../book/ch19-01-unsafe-rust.html#using-extern-functions-to-call-external-code\n\n```\n# #![allow(dead_code)]\n# trait ResType { }\n# struct ParamType;\n# mod foreign_lib {\n#     pub fn new(_: usize) -> *mut () { 42 as *mut () }\n#     pub fn do_stuff(_: *mut (), _: usize) {}\n# }\n# fn convert_params(_: ParamType) -> usize { 42 }\nuse std::marker::PhantomData;\n\nstruct ExternalResource<R> {\n   resource_handle: *mut (),\n   resource_type: PhantomData<R>,\n}\n\nimpl<R: ResType> ExternalResource<R> {\n    fn new() -> Self {\n        let size_of_res = size_of::<R>();\n        Self {\n            resource_handle: foreign_lib::new(size_of_res),\n            resource_type: PhantomData,\n        }\n    }\n\n    fn do_stuff(&self, param: ParamType) {\n        let foreign_params = convert_params(param);\n        foreign_lib::do_stuff(self.resource_handle, foreign_params);\n    }\n}\n```\n\n## Ownership and the drop check\n\nThe exact interaction of `PhantomData` with drop check **may change in the future**.\n\nCurrently, adding a field of type `PhantomData<T>` indicates that your type *owns* data of type\n`T` in very rare circumstances. This in turn has effects on the Rust compiler's [drop check]\nanalysis. For the exact rules, see the [drop check] documentation.\n\n## Layout\n\nFor all `T`, the following are guaranteed:\n* `size_of::<PhantomData<T>>() == 0`\n* `align_of::<PhantomData<T>>() == 1`\n\n[drop check]: Drop#drop-check","links":{"Drop#drop-check":13},"attrs":[{"other":"#[lang = \"phantom_data\"]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"struct":{"kind":"unit","generics":{"params":[{"name":"T","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"PointeeSized","id":7300,"args":null},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"impls":[11984,12759,13181,13182,13183,13184,13185,13186,13187,13188,13189,13190,13191,13193,9634,9860,10272,10057,12544,8514,11432,12466,13194,13195,13197]}}},"30060":{"id":30060,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[221,1],"end":[225,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"BorrowMut","id":687,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Chars","id":8864,"args":{"angle_bracketed":{"args":[{"lifetime":"'a"}],"constraints":[]}}}},"items":