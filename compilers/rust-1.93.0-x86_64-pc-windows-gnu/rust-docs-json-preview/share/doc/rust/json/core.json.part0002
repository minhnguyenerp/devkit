nstraints":[]}}}}}}}},"41041":{"id":41041,"crate_id":0,"name":"_mm_mask_getexp_sh","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[9132,1],"end":[9134,2]},"visibility":"public","docs":"Convert the exponent of the lower half-precision (16-bit) floating-point element in b to a half-precision\n(16-bit) floating-point number representing the integer exponent, store the result in the lower element\nof dst using writemask k (the element is copied from src when mask bit 0 is not set), and copy the upper 7\npacked elements from a to the upper elements of dst. This intrinsic essentially calculates `floor(log2(x))`\nfor the lower element.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_mask_getexp_sh)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vgetexpsh))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["b",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}]],"output":{"resolved_path":{"path":"__m128h","id":9344,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1296":{"id":1296,"crate_id":0,"name":"from_be","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2438,1],"end":[2448,2]},"visibility":"public","docs":"Converts an integer from big endian to the target's endianness.\n\nOn big endian this is a no-op. On little endian the bytes are\nswapped.\n\n# Examples\n\n```\n#![feature(nonzero_bitwise)]\n# use std::num::NonZero;\nuse std::num::NonZeroIsize;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet n = NonZero::new(0x1Aisize)?;\n\nif cfg!(target_endian = \"big\") {\n    assert_eq!(NonZeroIsize::from_be(n), n)\n} else {\n    assert_eq!(NonZeroIsize::from_be(n), n.swap_bytes())\n}\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 128281, is_soft: false}, feature: \"nonzero_bitwise\"}}]"},{"other":"#[attr = Inline(Always)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23094":{"id":23094,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[212,1],"end":[217,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Borrow","id":684,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"BorrowError","id":11628,"args":null}},"items":[682],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"44892":{"id":44892,"crate_id":0,"name":"lasx_xvmin_du","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[2352,1],"end":[2354,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":