e_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"items":[7987],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"11839":{"id":11839,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"'a","kind":{"lifetime":{"outlives":[]}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"UnwindSafe","id":679,"args":null},"for":{"resolved_path":{"path":"PhantomCovariantLifetime","id":8496,"args":{"angle_bracketed":{"args":[{"lifetime":"'a"}],"constraints":[]}}}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"33637":{"id":33637,"crate_id":0,"name":"vtrn_u32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[73158,1],"end":[73164,2]},"visibility":"public","docs":"Transpose elements\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vtrn_u32)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr_trace>(all(test, target_arch = \"arm\"), assert_instr(vtrn))]"},{"other":"#[<cfg_attr_trace>(all(test,\nany(target_arch = \"aarch64\", target_arch = \"arm64ec\")), assert_instr(zip1))]"},{"other":"#[<cfg_attr_trace>(all(test,\nany(target_arch = \"aarch64\", target_arch = \"arm64ec\")), assert_instr(zip2))]"},{"other":"#[<cfg_attr_trace>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation"