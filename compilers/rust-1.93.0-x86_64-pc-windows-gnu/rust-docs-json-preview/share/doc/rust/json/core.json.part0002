:{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"f32"}}}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"f32"}}},"items":[14739,14740],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"36539":{"id":36539,"crate_id":0,"name":"_mm512_mask3_fnmsub_round_ps","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[9617,1],"end":[9628,2]},"visibility":"public","docs":"Multiply packed single-precision (32-bit) floating-point elements in a and b, subtract packed elements in c from the negated intermediate result, and store the results in dst using writemask k (elements are copied from c when the corresponding mask bit is not set).\\\n\nRounding is done according to the rounding\\[3:0\\] parameter, which can be one of:\\\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_mask3_fnmsub_round_ps&expand=2781)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vfnmsub, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m512","id":9329,"args":null}}],["b",{"resolved_path":{"path":"__m512","id":9329,"args":null}}],["c",{"resolved_path":{"path":"__m512","id":9329,"args":null}}],["k",{"resolved_path":{"path":"__mmask16","id":35943,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512","id":9329,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18592":{"id":18592,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u8"},"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}}}}}},"40390":{"id":40390,"crate_id":0,"name":"_mm_bitshuffle_epi64_mask","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512bitalg.rs","begin":[412,1],"end":[414,2]},"visibility":"public","docs":"Considers the input `b` as packed 64-bit integers and `c` as packed 8-bit integers.\nThen groups 8 8-bit values from `c`as indices into the bits of the corresponding 64-bit integer.\nIt then selects these bits and packs them into the output.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm_bitshuffle_epi64_mask)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vpshufbitqmb))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, pa