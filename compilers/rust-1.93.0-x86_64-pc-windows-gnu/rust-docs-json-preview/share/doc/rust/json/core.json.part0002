it is not set). This intrinsic essentially calculates\n`floor(log2(x))` for each element.\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm_mask_getexp_ph)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vgetexpph))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128h","id":9344,"args":null}}]],"output":{"resolved_path":{"path":"__m128h","id":9344,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1284":{"id":1284,"crate_id":0,"name":"BITS","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2438,1],"end":[2448,2]},"visibility":"public","docs":"The size of this non-zero integer type in bits.\n\nThis value is equal to [`isize::BITS`].\n\n# Examples\n\n```\n# use std::num::NonZero;\n#\nassert_eq!(NonZero::<isize>::BITS, isize::BITS);\n```","links":{"`isize::BITS`":1283},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 67, patch: 0})}, feature: \"nonzero_bits\"}}]"}],"deprecation":null,"inner":{"assoc_const":{"type":{"primitive":"u32"},"value":"isize::BITS"}}},"23082":{"id":23082,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\clone.rs","begin":[547,1],"end":[553,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null