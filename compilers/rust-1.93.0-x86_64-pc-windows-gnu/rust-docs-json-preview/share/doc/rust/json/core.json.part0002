soon as\n`self + rhs > u128::MAX`.\n\n# Examples\n\n```\n#![feature(nonzero_ops)]\n\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet one = NonZero::new(1u128)?;\nlet two = NonZero::new(2u128)?;\n\nassert_eq!(two, unsafe { one.unchecked_add(1) });\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 84186, is_soft: false}, feature: \"nonzero_ops\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"u128"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"22802":{"id":22802,"crate_id":0,"name":"fmt","span":{"filename":"library\\core\\src\\ascii\\ascii_char.rs","begin":[1195,5],"end":[1197,6]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["f",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"resolved_path":{"path":"fmt::Formatter","id":709,"args":{"angle_bracketed":{"args":[{"lifetime":"'_"}],"constraints":[]}}}}}}]],"output":{"resolved_path":{"path":"fmt::Result","id":710,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"44600":{"id":44600,"crate_id":0,"name":"vec_add","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\powerpc\\altivec.rs","begin":[4039,1],"end":[4044,2]},"visibility":"public","docs":"Vector add.","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {l