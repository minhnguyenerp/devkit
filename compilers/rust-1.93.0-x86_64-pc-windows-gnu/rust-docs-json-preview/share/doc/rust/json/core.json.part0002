"begin":[551,1],"end":[551,73]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["other",{"resolved_path":{"path":"Saturating","id":1961,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"24256":{"id":24256,"crate_id":0,"name":"next_if_map_mut","span":{"filename":"library\\core\\src\\iter\\adapters\\peekable.rs","begin":[450,5],"end":[461,6]},"visibility":"public","docs":"Gives a mutable reference to the next value of the iterator and applies a function `f` to it,\nreturning the result and advancing the iterator if `f` returns `Some`.\n\nOtherwise, if `f` returns `None`, the next value is kept for the next iteration.\n\nIf `f` panics, the item that is consumed from the iterator as if `Some` was returned from `f`.\nThe value will be dropped.\n\nThis is similar to [`next_if_map`](Self::next_if_map), except ownership of the item is not given to `f`.\nThis can be preferable if `f` would copy the item anyway.\n\n# Examples\n\nParse the leading decimal number from an iterator of characters.\n```\n#![feature(peekable_next_if_map)]\nlet mut iter = \"125 GOTO 10\".chars().peekable();\nlet mut line_num = 0_u32;\nwhile let Some(digit) = iter.next_if_map_mut(|c| c.to_digit(10)) {\n    line_num = line_num * 10 + digit;\n}\nassert_eq!(line_num, 125);\nassert_eq!(iter.collect::<String>(), \" GOTO 10\");\n```","links":{"Self::next_if_map":24257},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 143702, is_soft: false}, feature: \"peekable_next_if_map\"}}]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["f",{"impl_trait":[{"trait_bound":{"trait":{"path":"FnOnce","id":19,"args":{"parenthesized":{"inputs":[{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"I"},"trait":{"path":"","id":77,"args":null}}}}}],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"generic":"R"}}],"constraints":[]}}}}}}},"generic_params":[],"modifier":"none"}}]}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"generic":"R"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[{"name":"R","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"impl FnOnce(&mut I::Item) -> Option<R>","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"FnOnce","id":19,"args":{"parenthesized":{"inputs":[{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"I"},"trait":{"path":"","id":77,"args":null}}}}}],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"generic":"R"}}],"constraints":[]}}}}}}},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":true}}}],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"46054":{"id":46054,"crate_id":0,"name":"lsx_vaddwod_h_b","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lsx\\generated.rs","begin":[5126,1],"end":[5128,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9440,"args":null}}],["b",{"resolved_path":{"path":"m128i","id":9440,"args":null}}]],"output":{"resolved_path":{"path":"m128i","id":9440,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"6309":{"id":6309,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 7, patch: 0})}, feature: \"wrapping_impls\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Rem","id":1417,"args":null},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}},"items":[6307,6308],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"28107":{"id":28107,"crate_id":0,"name":"fetch_xor","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3970,1],"end":[3974,2]},"visibility":"public","docs":"Bitwise \"xor\" with the current value.\n\nPerforms a bitwise \"xor\" operation on the current value and the argument `val`, and\nsets the new value to the result.\n\nReturns the previous value.\n\n`fetch_xor` takes an [`Ordering`] argument which describes the memory ordering\nof this operation. All ordering modes are possible. Note that using\n[`Acquire`] makes the store part of this operation [`Relaxed`], and\nusing [`Release`] makes the load part [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic operations on\n[`usize`].\n\n# Examples\n\n```\nuse std::sync::atomic::{AtomicUsize, Ordering};\n\nlet foo = AtomicUsize::new(0b101101);\nassert_eq!(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);\nassert_eq!(foo.load(Ordering::SeqCst), 0b011110);\n```","links":{"`usize`":278,"`Acquire`":27624,"`Relaxed`":27625,"`Ordering`":8789,"`Release`":27626},"attrs":[{"other":"#[<cfg_trace>(target_has_atomic = \"ptr\")]"},{"other":"#[<cfg_attr_trace>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = RustcShouldNotBeCalledOnConstItems]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["val",{"primitive":"usize"}],["order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}]],"output":{"primitive":"usize"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49905":{"id":49905,"crate_id":0,"name":"from_ne_bytes","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[319,5],"end":[338,6]},"visibility":"public","docs":"Creates an integer value from its memory representation as a byte\narray in native endianness.\n\nAs the target platform's native endianness is used, portable code\nlikely wants to use [`from_be_bytes`] or [`from_le_bytes`], as\nappropriate instead.\n\n[`from_be_bytes`]: Self::from_be_bytes\n[`from_le_bytes`]: Self::from_le_bytes\n\n\n\n# Examples\n\n```\nlet value = i64::from_ne_bytes(if cfg!(target_endian = \"big\") {\n    [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]\n} else {\n    [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]\n});\nassert_eq!(value, 0x1234567890123456);\n```\n\nWhen starting from a slice rather than an array, fallible conversion APIs can be used:\n\n```\nfn read_ne_i64(input: &mut &[u8]) -> i64 {\n    let (int_bytes, rest) = input.split_at(size_of::<i64>());\n    *input = rest;\n    i64::from_ne_bytes(int_bytes.try_into().unwrap())\n}\n```","links":{"Self::from_le_bytes":49800,"Self::from_be_bytes":49798},"attrs":[{"other":"#[allow(unnecessary_transmutes)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 44, patch: 0})}, feature: \"const_int_conversion\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"int_to_from_bytes\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["bytes",{"array":{"type":{"primitive":"u8"},"len":"8"}}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10160":{"id":10160,"crate_id":0,"name":"lt","span":{"filename":"library\\core\\src\\cmp.rs","begin":[1978,5],"end":[1978,43]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Always)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"primitive":"bool"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31958":{"id":31958,"crate_id":0,"name":"vld1_lane_u64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[16090,1],"end":[16093,2]},"visibility":"public","docs":"Load one single-element structure to one lane of one register.\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vld1_lane_u64)\n## Safety\n  * Neon instrinsic unsafe","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[<cfg_attr_trace>(all(test, target_arch = \"arm\"),\nassert_instr(vldr, LANE = 0))]"},{"other":"#[<cfg_attr_trace>(all(test,\nany(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(ldr, LANE = 0))]"},{"other":"#[<cfg_attr_trace>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["ptr",{"raw_pointer":{"is_mutable":false,"type":{"primitive":"u64"}}}],["src",{"resolved_path":{"path":"uint64x1_t","id":9026,"args":null}}],["LANE",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"uint64x1_t","id":9026,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"14011":{"id":14011,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Unpin","id":11,"args":null},"for":{"primitive":"char"},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"35809":{"id":35809,"crate_id":0,"name":"_mm256_srli_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx2.rs","begin":[3084,1],"end":[3093,2]},"visibility":"public","docs":"Shifts packed 32-bit integers in `a` right by `IMM8` while shifting in\nzeros\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_srli_epi32)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vpsrld, IMM8 = 7))]"},{"other":"#[rustc_legacy_const_generics(1)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},{"target_feature":{"enable":["avx2"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m256i","id":9317,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m256i","id":9317,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"17862":{"id":17862,"crate_id":0,"name":"shl","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"primitive":"isize"}]],"output":{"primitive":"i32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"39660":{"id":39660,"crate_id":0,"name":"_mm256_conflict_epi32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512cd.rs","begin":[119,1],"end":[121,2]},"visibility":"public","docs":"Test each 32-bit element of a for equality with all other elements in a closer to the least significant bit. Each element's comparison forms a zero extended bit vector in dst.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_conflict_epi32&expand=1245)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vpconflictd))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512cd","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m256i","id":9317,"args":null}}]],"output":{"resolved_path":{"path":"__m256i","id":9317,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"21713":{"id":21713,"crate_id":0,"name":"break_ok","span":{"filename":"library\\core\\src\\ops\\control_flow.rs","begin":[268,5],"end":[273,6]},"visibility":"public","docs":"Converts the `ControlFlow` into an `Result` which is `Ok` if the\n`ControlFlow` was `Break` and `Err` if otherwise.\n\n# Examples\n\n```\n#![feature(control_flow_ok)]\n\nuse std::ops::ControlFlow;\n\nstruct TreeNode<T> {\n    value: T,\n    left: Option<Box<TreeNode<T>>>,\n    right: Option<Box<TreeNode<T>>>,\n}\n\nimpl<T> TreeNode<T> {\n    fn find<'a>(&'a self, mut predicate: impl FnMut(&T) -> bool) -> Result<&'a T, ()> {\n        let mut f = |t: &'a T| -> ControlFlow<&'a T> {\n            if predicate(t) {\n                ControlFlow::Break(t)\n            } else {\n                ControlFlow::Continue(())\n            }\n        };\n\n        self.traverse_inorder(&mut f).break_ok()\n    }\n\n    fn traverse_inorder<'a, B>(\n        &'a self,\n        f: &mut impl FnMut(&'a T) -> ControlFlow<B>,\n    ) -> ControlFlow<B> {\n        if let Some(left) = &self.left {\n            left.traverse_inorder(f)?;\n        }\n        f(&self.value)?;\n        if let Some(right) = &self.right {\n            right.traverse_inorder(f)?;\n        }\n        ControlFlow::Continue(())\n    }\n\n    fn leaf(value: T) -> Option<Box<TreeNode<T>>> {\n        Some(Box::new(Self {\n            value,\n            left: None,\n            right: None,\n        }))\n    }\n}\n\nlet node = TreeNode {\n    value: 0,\n    left: TreeNode::leaf(1),\n    right: Some(Box::new(TreeNode {\n        value: -1,\n        left: TreeNode::leaf(5),\n        right: TreeNode::leaf(2),\n    })),\n};\n\nlet res = node.find(|val: &i32| *val > 3);\nassert_eq!(res, Ok(&5));\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 148738, is_soft: false}, feature: \"min_const_control_flow\",\npromotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 140266, is_soft: false}, feature: \"control_flow_ok\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"generic":"B"}},{"type":{"generic":"C"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"43511":{"id":43511,"crate_id":0,"name":"vtrn2q_u64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\aarch64\\neon\\generated.rs","begin":[27838,1],"end":[27840,2]},"visibility":"public","docs":"Transpose vectors\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vtrn2q_u64)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(all(test, not(target_env = \"msvc\")), assert_instr(zip2))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\