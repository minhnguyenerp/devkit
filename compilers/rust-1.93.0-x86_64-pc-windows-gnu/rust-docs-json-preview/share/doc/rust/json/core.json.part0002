ng the square root of the number `a`.\n\nThis method is useful when targeting `no_std` and is equivalent to [`std::f64::sqrt()`].\n\n[`std::f64::sqrt()`]: https://doc.rust-lang.org/std/primitive.f64.html#method.sqrt\n[`f64.sqrt`]: https://webassembly.github.io/spec/core/syntax/instructions.html#syntax-instr-numeric","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(f64.sqrt))]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 133908, is_soft: false}, feature: \"wasm_numeric_instr\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"method returns a new number and does not mutate the original value"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"primitive":"f64"}]],"output":{"primitive":"f64"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"4496":{"id":4496,"crate_id":0,"name":"from_be","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[940,1],"end":[940,75]},"visibility":"public","docs":"Converts an integer from big endian to the target's endianness.\n\nOn big endian this is a no-op. On little endian the bytes are\nswapped.\n\n# Examples\n\nBasic usage:\n\n```\n#![feature(wrapping_int_impl)]\nuse std::num::Wrapping;\n\nlet n = Wrapping(0x1Ai32);\n\nif cfg!(target_endian = \"big\") {\n    assert_eq!(<Wrapping<i32>>::from_be(n), n)\n} else {\n    assert_eq!(<Wrapping<i32>>::from_be(n), n.swap_bytes())\n}\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 32463, is_soft: false}, feature: \"wrapping_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"26294":{"id":26294,"crate_id":0,"name":"copied","span":{"filename":"library\\core\\src\\option.rs","begin":[2105,5],"end":[2113,6]},"visibility":"public","docs":"Maps an `Option<&mut T>` to an `Option<T>` by copying the contents of the\noption.\n\n# Examples\n\n```\nlet mut x = 12;\nlet opt_x = Some(&mut x);\nassert_eq!(opt_x, Some(&mut 12));\nlet copied = opt_x.copied();\nassert_eq!(copied, Some(12));\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 83, patch: 0})}, feature: \"const_option\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 35, patch: 0})}, feature: \"copied\"}}]"},{"must_use":{"reason":"`self` will be dropped if the result is not used"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Copy","id":1,"args":null},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"48092":{"id":48092,"crate_id":0,"name":"reduce_sum","span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\simd\\num\\uint.rs","begin":[262,1],"end":[262,72]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"qualified_path":{"name":"Scalar","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":47274,"args":null}}},"is_c_varia