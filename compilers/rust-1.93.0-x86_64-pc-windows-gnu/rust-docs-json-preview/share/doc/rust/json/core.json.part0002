":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i128"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u32"},"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i128"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"40682":{"id":40682,"crate_id":0,"name":"_mm512_mask_div_round_ph","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[2483,1],"end":[2494,2]},"visibility":"public","docs":"Divide packed half-precision (16-bit) floating-point elements in a by b, and store the results in dst using\nwritemask k (elements are copied from src when the corresponding mask bit is not set).\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_mask_div_round_ph)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vdivph, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}],["k",{"resolved_path":{"path":"__mmask32","id":38824,"args":null}}],["a",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}],["b",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512h","id":9350,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"937":{"id":937,"crate_id":0,"name":"unchecked_mul","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2276,1],"end":[2286,2]},"visibility":"public","docs":"Multiplies two non-zero integers together,\nassuming overflow cannot occur.\nOverflow is unchecked, and it is undefined behavior to overflow\n*even if the result would wrap to a non-zero value*.\nThe behavior is undefined as soon as\n`self * rhs > u32::MAX`.\n\n# Examples\n\n```\n#![feature(nonzero_ops)]\n\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet two = NonZero::new(2u32)?;\nlet four = NonZero::new(4u32)?;\n\nassert_eq!(four, unsafe { two.unchecked_mul(two) });\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 84186, is_soft: false}, feature: \"nonzero_ops\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"22735":{"id":22735,"crate_id":0,"name":"SmallE","span":{"filename":"library\\core\\src\\ascii\\ascii_char.rs","begin":[367,5],"end":[367,17]},"visibility":"default","docs":"U+0065","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 110998, is_soft: false}, feature: \"ascii_char_variants\"}}]"}],"deprecation":null,"inner":{"variant":{"kind":"plain","discriminant":{"expr":"101","value":"101"}}}},"44533":{"id":44533,"crate_id":0,"name":"vec_insert","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\powerpc\\altivec.rs","begin":[3248,1],"end":[3253,2]},"visibility":"public","docs":"Vector Insert\n\n## Purpose\nReturns a copy of vector b with element c replaced by the value of a.\n\n## Result value\nr contains a copy of vector b with element c replaced by the value of a.\nThis function uses modular arithmetic on c to determine the element number.\nFor example, if c is out of range, the compiler uses c modulo the number of\nelements in the vector to determine the element position.","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 111145, is_soft: false}, feature: \"stdarch_powerpc\"}}]"},{"target_feature":{"enable":["altivec"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"generic":"T"}],["b",{"qualified_path":{"name":"Scalar","args":null,"self_type":{"generic":"T"},"trait":{"path":"sealed::VectorInsert","id":44250,"args":null}}}]],"output":{"generic":"T"},"is_c_variadic":false},"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"IDX","kind":{"const":{"type":{"primitive":"u32"},"default":null}}}],"where_predicates":[{"