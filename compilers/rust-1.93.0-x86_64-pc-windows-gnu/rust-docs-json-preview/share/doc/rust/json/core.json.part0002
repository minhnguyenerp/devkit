id_sequence_length) = error.error_len() {\n                    input = &after_valid[invalid_sequence_length..]\n                } else {\n                    break\n                }\n            }\n        }\n    }\n}\n```","links":{"super::from_utf8":30022,"`u8`":272},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"struct":{"kind":{"plain":{"fields":[],"has_stripped_fields":true}},"generics":{"params":[],"where_predicates":[]},"impls":[30036,12172,12902,13371,13795,26529,26837,30037,30038,30039,30040,30041,30042,30043,30044,12584,9911,12507,9792,8859,28585,29066,11641]}}},"30656":{"id":30656,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\str\\mod.rs","begin":[53,42],"end":[53,47]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"use":{"source":"iter::Split","name":"Split","id":8875,"is_glob":false}}},"12709":{"id":12709,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\mod.rs","begin":[403,1],"end":[447,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[doc(cfg(any(target_arch = \"x86\", target_arch = \"x86_64\")))]"},{"other":"#[allow(non_camel_case_types)]"},{"other":"#[allow(clippy :: missing_inline_in_public_items)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},"automatically_derived"],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Copy","id":1,"args":null},"for":{"resolved_path":{"path":"__m256h","id":9347,"args":null}},"items