\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m256i","id":9431,"args":null}}],["b",{"resolved_path":{"path":"m256i","id":9431,"args":null}}]],"output":{"resolved_path":{"path":"m256i","id":9431,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5439":{"id":5439,"crate_id":0,"name":"div_assign","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["other",{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u16"}}],"constraints":[]}}}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"27237":{"id":27237,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\pin\\unsafe_pinned.rs","begin":[160,1],"end":[164,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 125735, is_soft: false}, feature: \"unsafe_pinned\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Debug","id":712,"args":null},"for":{"resolved_path":{"path":"UnsafePinned","id":10727,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}},"items":[27236],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"49035":{"id":49035,"crate_id":0,"name":"total_cmp","span":{"filename":"library\\core\\src\\num\\f64.rs","begin":[1366,5],"end":[1396,6]},"visibility":"public","docs":"Returns the ordering between `self` and `other`.\n\nUnlike the standard partial comparison between floating point numbers,\nthis comparison always produces an ordering in accordance to\nthe `totalOrder` predicate as defined in the IEEE 754 (2008 revision)\nfloating point standard. The values are ordered in the following sequence:\n\n- negative quiet NaN\n- negative signaling NaN\n- negative infinity\n- negative numbers\n- negative subnormal numbers\n- negative zero\n- positive zero\n- positive subnormal numbers\n- positive numbers\n- positive infinity\n- positive signaling NaN\n- positive quiet NaN.\n\nThe ordering established by this function does not always agree with the\n[`PartialOrd`] and [`PartialEq`] implementations of `f64`. For example,\nthey consider negative and positive zero equal, while `total_cmp`\ndoesn't.\n\nThe interpretation of the signaling NaN bit follows the definition in\nthe IEEE 754 standard, which may not match the interpretation by some of\nthe older, non-conformant (e.g. MIPS) hardware implementations.\n\n# Example\n\n```\nstruct GoodBoy {\n    name: String,\n    weight: f64,\n}\n\nlet mut bois = vec![\n    GoodBoy { name: \"Pucci\".to_owned(), weight: 0.1 },\n    GoodBoy { name: \"Woofer\".to_owned(), weight: 99.0 },\n    GoodBoy { name: \"Yapper\".to_owned(), weight: 10.0 },\n    GoodBoy { name: \"Chonk\".to_owned(), weight: f64::INFINITY },\n    GoodBoy { name: \"Abs. Unit\".to_owned(), weight: f64::NAN },\n    GoodBoy { name: \"Floaty\".to_owned(), weight: -5.0 },\n];\n\nbois.sort_by(|a, b| a.weight.total_cmp(&b.weight));\n\n// `f64::NAN` could be positive or negative, which will affect the sort order.\nif f64::NAN.is_sign_negative() {\n    assert!(bois.into_iter().map(|b| b.weight)\n        .zip([f64::NAN, -5.0, 0.1, 10.0, 99.0, f64::INFINITY].iter())\n        .all(|(a, b)| a.to_bits() == b.to_bits()))\n} else {\n    assert!(bois.into_iter().map(|b| b.weight)\n        .zip([-5.0, 0.1, 10.0, 99.0, f64::INFINITY, f64::NAN].iter())\n        .all(|(a, b)| a.to_bits() == b.to_bits()))\n}\n```","links":{"`PartialEq`":49,"`PartialOrd`":53},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143800, is_soft: false}, feature: \"const_cmp\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 62, patch: 0})}, feature: \"total_cmp\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"crate::cmp::Ordering","id":1380,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9290":{"id":9290,"crate_id":0,"name":"poly64x1x2_t","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\mod.rs","begin":[1046,1],"end":[1046,57]},"visibility":"public","docs":"Arm-specific type containing two `poly64x1_t` vectors.","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: