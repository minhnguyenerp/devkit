gn(src)\\\n   _MM_MANT_SIGN_zero    // sign = 0\\\n   _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\\\nExceptions can be suppressed by passing _MM_FROUND_NO_EXC in the sae parameter.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=mm_maskz_getmant_sd&expand=2897)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vgetmantsd, NORM = 0, SIGN = 0))]"},{"other":"#[rustc_legacy_const_generics(3, 4)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m128d","id":9314,"args":null}}],["b",{"resolved_path":{"path":"__m128d","id":9314,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36447,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36448,"args":null}}]],"output":{"resolved_path":{"path":"__m128d","id":9314,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"20417":{"id":20417,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\masks.rs","begin":[575,1],"end":[584,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"N","kind":{"const":{"type":{"primitive":"usize"},"default":null}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"MaskElement","id":9492,"args":null},"generic_para