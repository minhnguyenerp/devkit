, without modifying the original"}},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"10957":{"id":10957,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\..\\..\\portable-simd\\crates\\core_simd\\src\\vendor\\x86.rs","begin":[35,1],"end":[35,44]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"From","id":61,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"Simd","id":9499,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}},{"const":{"expr":"8","value":null,"is_literal":false}}],"constraints":[]}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"__m512i","id":9326,"args":null}},"items":[10955],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"32755":{"id":32755,"crate_id":0,"name":"vqshrn_n_s64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[40879,1],"end":[40889,2]},"visibility":"public","docs":"Signed saturating shift right narrow\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vqshrn_n_s64)","links":{},"attrs":[{"other":"#[<cfg_trace>(not(target_arch = \"arm\"))]"},{"other":"#[<cfg_attr_trace>(test, assert_instr(sqshrn, N = 2))]"},{"other":"#[rustc_legacy_const_generics(1)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["