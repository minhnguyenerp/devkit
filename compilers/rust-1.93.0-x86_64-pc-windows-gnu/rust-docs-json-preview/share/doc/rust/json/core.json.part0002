s":null}}],["IMM_S5",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"m256i","id":9431,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5141":{"id":5141,"crate_id":0,"name":"bitxor_assign","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"generic":"Self"}}}],["other",{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"usize"}}],"constraints":[]}}}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"26939":{"id":26939,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"RefUnwindSafe","id":681,"args":null},"for":{"resolved_path":{"path":"uint16x4x4_t","id":9152,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"48737":{"id":48737,"crate_id":0,"name":"todo","span":{"filename":"library\\core\\src\\macros\\mod.rs","begin":[877,1],"end":[884,2]},"visibility":"public","docs":"Indicates unfinished code.\n\nThis can be useful if you are prototyping and just\nwant a placeholder to let your code pass type analysis.\n\nThe difference between [`unimplemented!`] and `todo!` is that while `todo!` conveys\nan intent of implementing the functionality later and the message is \"not yet\nimplemented\", `unimplemented!` makes no such claims. Its message is \"not implemented\".\n\nAlso, some IDEs will mark `todo!`s.\n\n# Panics\n\nThis will always [`panic!`] because `todo!` is just a shorthand for `panic!` with a\nfixed, specific message.\n\nLike `panic!`, this macro has a second form for displaying custom values.\n\n# Examples\n\nHere's an example of some in-progress code. We have a trait `Foo`:\n\n```\ntrait Foo {\n    fn bar(&self) -> u8;\n    fn baz(&self);\n    fn qux(&self) -> Result<u64, ()>;\n}\n```\n\nWe want to implement `Foo` on one of our types, but we also want to work on\njust `bar()` first. In order for our code to compile, we need to implement\n`baz()` and `qux()`, so we can use `todo!`:\n\n```\n# trait Foo {\n#     fn bar(&self) -> u8;\n#     fn baz(&self);\n#     fn qux(&self) -> Result<u64, ()>;\n# }\nstruct MyStruct;\n\nimpl Foo for MyStruct {\n    fn bar(&self) -> u8 {\n        1 + 1\n    }\n\n    fn baz(&self) {\n        // Let's not worry about implementing baz() for now\n        todo!();\n    }\n\n    fn qux(&self) -> Result<u64, ()> {\n        // We can add a message to todo! to display our omission.\n        // This will display:\n        // \"thread 'main' panicked at 'not yet implemented: MyStruct is not yet quxable'\".\n        todo!(\"MyStruct is not yet quxable\");\n    }\n}\n\nfn main() {\n    let s = MyStruct;\n    s.bar();\n\n    // We aren't even using baz() or qux(), so this is fine.\n}\n```","links":{"`unimplemented!`":48738,"`panic!`":11693},"attrs":[{"other":"#[rustc_diagnostic_item = \"todo_macro\"]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 40, patch: 0})}, feature: \"todo_macro\"}}]"},{"other":"#[attr = AllowInternalUnstable([\"panic_internals\"])]"},"macro_export"],"deprecation":null,"inner":{"macro":"macro_rules! todo {\n    () => { ... };\n    ($($arg:tt)+) => { ... };\n}"}},"8992":{"id":8992,"crate_id":0,"name":"clone","span":{"filename":"library\\core\\src\\alloc\\mod.rs","begin":[31,16],"end":[31,21]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"resolved_path":{"path":"AllocError","id":8993,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"12843":{"id":12843,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Sync","id":9,"args":null},"for":{"resolved_path":{"path":"SocketAddrV4","id":8739,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"34641":{"id":34641,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\convert\\mod.rs","begin":[827,1],"end":[837,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"U","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"U"},"bounds":[{"trait_bound":{"trait":{"path":"Into","id":63,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"TryFrom","id":163,"args":{"angle_bracketed":{"args":[{"type":{"generic":"U"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"int64x1x4_t","id":9260,"args":null}},"items":[700,702],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"16694":{"id":16694,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u8"},"trait":{"path":"Shl","id":4638,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}}],"constraints":[]}}}}}}}},"38492":{"id":38492,"crate_id":0,"name":"_mm_mask_fnmsub_round_ss","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[40566,1],"end":[40584,2]},"visibility":"public","docs":"Multiply the lower single-precision (32-bit) floating-point elements in a and b, and subtract the lower element in c from the negated intermediate result. Store the result in the lower element of dst using writemask k (the element is copied from c when mask bit 0 is not set), and copy the upper 3 packed elements from a to the upper elements of dst.\\\n\nRounding is done according to the rounding\\[3:0\\] parameter, which can be one of:\\\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=mm_mask_fnmsub_round_ss&expand=2788)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vfnmsub, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr 