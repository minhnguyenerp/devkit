,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"2178":{"id":2178,"crate_id":0,"name":"leading_zeros","span":{"filename":"library\\core\\src\\num\\saturating.rs","begin":[1017,1],"end":[1017,58]},"visibility":"public","docs":"Returns the number of leading zeros in the binary representation of `self`.\n\n# Examples\n\n```\nuse std::num::Saturating;\n\nlet n = Saturating(i64::MAX >> 2);\n\nassert_eq!(n.leading_zeros(), 3);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 74, patch: 0})}, feature: \"saturating_int_impl\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"primitive":"u32"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"23976":{"id":23976,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\iter\\adapters\\filter_map.rs","begin":[29,1],"end":[33,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 9, patch: 0})}, feature: \"core_impl_debug\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"I","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"fmt::Debug","id":712,"args":null},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":false}}},{"name":"F","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Debug","id":712,"args":null},"for":{"resolved_path":{"path":"FilterMap","id":8637,"args":{"angle_bracketed":{"args":[{"type":{"generic":"I"}},{"type":{"generic":"F"}}],"constraints":[]}}}},"items":[23975],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"45774":{"id":45774,"crate_id":0,"name":"lsx_vmul_d","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lsx\\generated.rs","begin":[3076,1],"end":[3078,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9440,"args":null}}],["b",{"resolved_path":{"path":"m128i","id":9440,"args":null}}]],"output":{"resolved_path":{"path":"m128i","id":9440,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"6029":{"id":6029,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}}}}},"27827":{"id":27827,"crate_id":0,"name":"update","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3772,1],"end":[3789,2]},"visibility":"public","docs":"Fetches the value, applies a function to it that it return a new value.\nThe new value is stored and the old value is returned.\n\nSee also: [`try_update`](`AtomicU16::try_update`).\n\nNote: This may call the function multiple times if the value has been changed from other threads in\nthe meantime, but the function will have been applied only once to the stored value.\n\n`update` takes two [`Ordering`] arguments to describe the memory ordering of this operation.\nThe first describes the required ordering for when the operation finally succeeds while the second\ndescribes the required ordering for loads. These correspond to the success and failure orderings of\n[`AtomicU16::compare_exchange`]\nrespectively.\n\nUsing [`Acquire`] as success ordering makes the store part\nof this operation [`Relaxed`], and using [`Release`] makes the final successful load\n[`Relaxed`]. The (failed) load ordering can only be [`SeqCst`], [`Acquire`] or [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic operations on\n[`u16`].\n\n# Considerations\n\n[CAS operation]: https://en.wikipedia.org/wiki/Compare-and-swap\nThis method is not magic; it is not provided by the hardware, and does not act like a\ncritical section or mutex.\n\nIt is implemented on top of an atomic [compare-and-swap operation], and thus is subject to\nthe usual drawbacks of CAS operations. In particular, be careful of the [ABA problem]\nif this atomic integer is an index or more generally if knowledge of only the *bitwise value*\nof the atomic is not in and of itself sufficient to ensure any required preconditions.\n\n[ABA Problem]: https://en.wikipedia.org/wiki/ABA_problem\n[compare-and-swap operation]: https://en.wikipedia.org/wiki/Compare-and-swap\n\n# Examples\n\n```rust\n#![feature(atomic_try_update)]\nuse std::sync::atomic::{AtomicU16, Ordering};\n\nlet x = AtomicU16::new(7);\nassert_eq!(x.update(Ordering::SeqCst, Ordering::SeqCst, |x| x + 1), 7);\nassert_eq!(x.update(Ordering::SeqCst, Ordering::SeqCst, |x| x + 1), 8);\nassert_eq!(x.load(Ordering::SeqCst), 9);\n```","links":{"`SeqCst`":27623,"`AtomicU16::try_update`":27828,"`Acquire`":27624,"`Relaxed`":27625,"`Release`":27626,"`u16`":254,"`AtomicU16::compare_exchange`":27818,"`Ordering`":8789},"attrs":[{"other":"#[<cfg_trace>(target_has_atomic = \"16\")]"},{"other":"#[<cfg_attr_trace>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 135894, is_soft: false}, feature: \"atomic_try_update\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = RustcShouldNotBeCalledOnConstItems]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["set_order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}],["fetch_order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}],["f",{"impl_trait":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u16"}],"output":{"primitive":"u16"}}}},"generic_params":[],"modifier":"none"}}]}]],"output":{"primitive":"u16"},"is_c_variadic":false},"generics":{"params":[{"name":"impl FnMut(u16) -> u16","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u16"}],"output":{"primitive":"u16"}}}},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":true}}}],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49625":{"id":49625,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[212,1],"end":[217,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"