:{"resolved_path":{"path":"__m128i","id":9308,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18957":{"id":18957,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Shr","id":4656,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u128"}}}}],"constraints":[]}}},"for":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u64"}}},"items":[18955,18956],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"40755":{"id":40755,"crate_id":0,"name":"_mm512_maskz_fcmul_round_pch","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512fp16.rs","begin":[3832,1],"end":[3839,2]},"visibility":"public","docs":"Multiply packed complex numbers in a by the complex conjugates of packed complex numbers in b, and\nstore the results in dst using zeromask k (the element is zeroed out when corresponding mask bit is not set).\nEach complex number is composed of two adjacent half-precision (16-bit) floating-point elements, which\ndefines the complex number `complex = vec.fp16[0] + i * vec.fp16[1]`, or the complex conjugate `conjugate = vec.fp16[0] - i * vec.fp16[1]`.\n\nRounding is done according to the rounding parameter, which can be one of:\n\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://software.intel.com/sites/landingpage/IntrinsicsGuide/#text=_mm512_maskz_fcmul_round_pch)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vfcmulcph, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 127213, is_soft: false}, feature: \"stdarch_x86_avx512_f16\"}}]"},{"target_feature":{"enable":["avx512fp16"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["k",{"resolved_path":{"path":"__mmask16","id":35943,"args":null}}],["a",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}],["b",{"resolved_path":{"path":"__m512h","id":9350,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m512h","id":9350,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1010":{"id":1010,"crate_id":0,"name":"midpoint","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2300,1],"end":[2310,2]},"visibility":"public","docs":"Calculates the midpoint (average) between `self` and `rhs`.\n\n`midpoint(a, b)` is `(a + b) >> 1` as if it were performed in a\nsufficiently-large signed integral type. This implies that the result is\nalways rounded towards negative infinity and that no overflow will ever occur.\n\n# Examples\n\n```\n# use std::num::NonZero;\n#\n# fn main() { test().unwrap(); }\n# fn test() -> Option<()> {\nlet one = NonZero::new(1u128)?;\nlet two = NonZero::new(2u128)?;\nlet four = NonZero::new(4u128)?;\n\nassert_eq!(one.midpoint(four), two);\nassert_eq!(four.midpoint(one), two);\n# Some(())\n# }\n```","links":{},"attrs":[{"other":"#[doc(alias = \"average_floor\")]"},{"other":"#[doc(alias = \"average\")]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 85, patch: 0})}, feature: \"num_midpoint\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 85, patch: 0})}, feature: \"num_midpoint\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"22808":{"id":22808,"crate_id":0,"name":"forward_checked","span":{"filename":"library\\core\\src\\iter\\range.rs","begin":[539,5],"end":[542,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["start",{"resolved_path":{"path":"AsciiChar","id":8557,"args":null}}],["count",{"primitive":"usize"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"resolved_path":{"path":"AsciiChar","id":8557,"args":null}}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates