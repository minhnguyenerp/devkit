brary\\core\\src\\sync\\atomic.rs","begin":[3810,1],"end":[3827,2]},"visibility":"public","docs":"Get atomic access to a `&mut [u32]` slice.\n\n**Note:** This function is only available on targets where `AtomicU32` has the same alignment as `u32`.\n\n# Examples\n\n```ignore-wasm\n#![feature(atomic_from_mut)]\nuse std::sync::atomic::{AtomicU32, Ordering};\n\nlet mut some_ints = [0; 10];\nlet a = &*AtomicU32::from_mut_slice(&mut some_ints);\nstd::thread::scope(|s| {\n    for i in 0..a.len() {\n        s.spawn(move || a[i].store(i as _, Ordering::Relaxed));\n    }\n});\nfor (i, n) in some_ints.into_iter().enumerate() {\n    assert_eq!(i, n as usize);\n}\n```","links":{},"attrs":[{"other":"#[<cfg_trace>(target_has_atomic_equal_alignment = \"32\")]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 76314, is_soft: false}, feature: \"atomic_from_mut\"}}]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["v",{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"slice":{"primitive":"u32"}}}}]],"output":{"borrowed_ref":{"lifetime":null,"is_mutable":true,"type":{"slice":{"generic":"Self"}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49680":{"id":49680,"crate_id":0,"name":"div_exact","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[295,5],"end":[314,6]},"visibility":"public","docs":"Integer division without remainder. Computes `self / rhs`, returning `None` if `self % rhs != 0`.\n\n# Panics\n\nThis function will panic  if `rhs == 0`.\n\n## Overflow behavior\n\nOn overflow, this function will panic if overflow checks are enabled (default in debug\nmode) and wrap if overflow checks are disabled (default in release mode).\n\n# Examples\n\n```\n#![feature(exact_div)]\nassert_eq!(64i32.div_exact(2), Some(32));\nassert_eq!(64i32.div_exact(32), Some(2));\nassert_eq!((i32::MIN + 1).div_exact(-1), Some(2147483647));\nassert_eq!(65i32.div_exact(2), None);\n```\n```should_panic\n#![feature(exact_div)]\nlet _ = 64i32.div_exact(0);\n```\n```should_panic\n#![feature(exact_div)]\nlet _ = i32::MIN.div_exact(-1);\n```","links":{},"attrs":[{"other":"#[rustc_inherit_overflow_checks]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 139911, is_soft: false}, feature: \"exact_div\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"generic":"Self"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"generic":"Self"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9935":{"id":9935,"crate_id":0,"name":"reverse","span":{"filename":"library\\core\\src\\cmp.rs","begin":[562,5],"end":[568,6]},"visibility":"public","docs":"Reverses the `Ordering`.\n\n* `Less` becomes `Greater`.\n* `Greater` becomes `Less`.\n* `Equal` becomes `Equal`.\n\n# Examples\n\nBasic behavior:\n\n```\nuse std::cmp::Ordering;\n\nassert_eq!(Ordering::Less.reverse(), Ordering::Greater);\nassert_eq!(Ordering::Equal.reverse(), Ordering::Equal);\nassert_eq!(Ordering::Greater.reverse(), Ordering::Less);\n```\n\nThis method can be used to reverse a comparison:\n\n```\nlet data: &mut [_] = &mut [2, 10, 5, 8];\n\n// sort the array from largest to smallest.\ndata.sort_by(|a, b| a.cmp(b).reverse());\n\nlet b: &mut [_] = &mut [10, 8, 5, 2];\nassert!(data == b);\n```","links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 48, patch: 0})}, feature: \"const_ordering\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"resolved_path":{"path":"Ordering","id":1380,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31733":{"id":31733,"crate_id":0,"name":"vdup_lane_u64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[9968,1],"end":[9971,2]},"visibility":"public","docs":"Set all vector lanes to the same value\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vdup_lane_u64)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_feature(enable = \"v7\"))]"},{"other":"#[<cfg_attr_trace>(all(test, target_arch = \"arm\"), assert_instr(nop, N = 0))]"},{"other":"#[<cfg_attr_trace>(all(test,\nany(target_arch = \"aarch64\", target_arch = \"arm64ec\")),\nassert_instr(nop, N = 0))]"},{"other":"#[rustc_legacy_const_generics(1)]"},{"other":"#[<cfg_attr_trace>(not(target_arch = \"arm\"),\nstable(feature = \"neon_intrinsics\", since = \"1.59.0\"))]"},{"other":"#[<cfg_attr_trace>(target_arch = \"arm\",\nunstable(feature = \"stdarch_arm_neon_intrinsics\", issue = \"111800\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 59, patch: 0})}, feature: \"neon_intrinsics\"}}]"},{"target_feature":{"enable":["neon"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"uint64x1_t","id":9026,"args":null}}],["N",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"uint64x1_t","id":9026,"a