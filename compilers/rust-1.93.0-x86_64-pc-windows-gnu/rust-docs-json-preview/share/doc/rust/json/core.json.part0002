ask_roundscale_pd","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[5851,1],"end":[5863,2]},"visibility":"public","docs":"Round packed double-precision (64-bit) floating-point elements in a to the number of fraction bits specified by imm8, and store the results in dst using writemask k (elements are copied from src when the corresponding mask bit is not set).\\\nRounding is done according to the imm8\\[2:0\\] parameter, which can be one of:\\\n* [`_MM_FROUND_TO_NEAREST_INT`] : round to nearest\n* [`_MM_FROUND_TO_NEG_INF`] : round down\n* [`_MM_FROUND_TO_POS_INF`] : round up\n* [`_MM_FROUND_TO_ZERO`] : truncate\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_mask_roundscale_pd&expand=4770)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_CUR_DIRECTION`":35318,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vrndscalepd, IMM8 = 0))]"},{"other":"#[rustc_legacy_const_generics(3)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["src",{"resolved_path":{"path":"__m256d","id":9323,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["a",{"resolved_path":{"path":"__m256d","id":9323,"args":null}}],["IMM8",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m256d","id":9323,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_