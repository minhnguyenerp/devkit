r access to the memory that this intrinsic\nmutates, a call to [`_mm_sfence`] must be performed by the thread that used the intrinsic. In\nparticular, functions that call this intrinsic should generally call `_mm_sfence` before they\nreturn.\n\nSee [`_mm_sfence`] for details.","links":{"`_mm_sfence`":35024},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(movntdq))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},{"target_feature":{"enable":["sse2"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["mem_addr",{"raw_pointer":{"is_mutable":true,"type":{"resolved_path":{"path":"__m128i","id":9308,"args":null}}}}],["a",{"resolved_path":{"path":"__m128i","id":9308,"args":null}}]],"output":null,"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"17211":{"id":17211,"crate_id":0,"name":"shl","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = TrackCaller]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"u128"}}}]],"output":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u128"},"trait":{"path":"Shl","id":4638,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"39009":{"id":39009,"crate_id":0,"name":"_mm256_mask_cmplt_epu16_mask","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512b