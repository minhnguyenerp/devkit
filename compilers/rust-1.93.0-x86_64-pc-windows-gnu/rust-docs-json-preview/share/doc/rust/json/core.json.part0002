d":26933,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"RefUnwindSafe","id":681,"args":null},"for":{"resolved_path":{"path":"int16x4x4_t","id":9134,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"48731":{"id":48731,"crate_id":0,"name":"assert_eq","span":{"filename":"library\\core\\src\\macros\\mod.rs","begin":[42,1],"end":[69,2]},"visibility":"public","docs":"Asserts that two expressions are equal to each other (using [`PartialEq`]).\n\nAssertions are always checked in both debug and release builds, and cannot\nbe disabled. See [`debug_assert_eq!`] for assertions that are disabled in\nrelease builds by default.\n\n[`debug_assert_eq!`]: crate::debug_assert_eq\n\nOn panic, this macro will print the values of the expressions with their\ndebug representations.\n\nLike [`assert!`], this macro has a second form, where a custom\npanic message can be provided.\n\n# Examples\n\n```\nlet a = 3;\nlet b = 1 + 2;\nassert_eq!(a, b);\n\nassert_eq!(a, b, \"we are testing addition with {} and {}\", a, b);\n```","links":{"crate::debug_assert_eq":48730,"`assert!`":95,"`PartialEq`":49},"attrs":[{"other":"#[rustc_diagnostic_item = \"assert_eq_macro\"]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"},{"other":"#[attr = AllowInternalUnstable([\"panic_internals\"])]"},"macro_export"],"deprecation":null,"inner":{"macro":"macro_rules! assert_eq {\n    ($left:expr, $right:expr $(,)?) => { ... };\n    ($left:expr, $right:expr, $($arg:tt)+) => { ... };\n}"}},"8986":{"id":8986,"crate_id":0,"name":"LocalWaker","span":{"filename":"library\\core\\src\\task\\wake.rs","begin":[740,1],"end":[742,2]},"visibility":"public","docs":"A `LocalWaker` is analogous to a [`Waker`], but it does not implement [`Send`] or [`Sync`].\n\nThis handle encapsulates a [`RawWaker`] instance, which defines the\nexecutor-specific wakeup behavior.\n\nLocal wakers can be requested from a `Context` with the [`local_waker`] method.\n\nThe typical life of a `LocalWaker` is that it is constructed by an executor, wrapped in a\n[`Context`] using [`ContextBuilder`], then passed to [`Future::poll()`]. Then, if the future chooses to return\n[`Poll::Pending`], it must also store the waker somehow and call [`LocalWaker::wake()`] when\nthe future should be polled again.\n\nImplements [`Clone`], but neither [`Send`] nor [`Sync`]; therefore, a local waker may\nnot be moved to other threads. In general, when deciding to use wakers or local wakers,\nlocal wakers are preferable unless the waker needs to be sent across threads. This is because\nwakers can incur in additional cost related to memory synchronization.\n\nNote that it is preferable to use `local_waker.clone_from(&new_waker)` instead\nof `*local_waker = new_waker.clone()`, as the former will avoid cloning the waker\nunnecessarily if the two wakers [wake the same task](Self::will_wake).\n\n# Examples\nUsage of a local waker to implement a future analogous to `std::thread::yield_now()`.\n```\n#![feature(local_waker)]\nuse std::future::{Future, poll_fn};\nuse std::task::Poll;\n\n// a future that returns pending once.\nfn yield_now() -> impl Future<Output=()> + Unpin {\n    let mut yielded = false;\n    poll_fn(move |cx| {\n        if !yielded {\n            yielded = true;\n            cx.local_waker().wake_by_ref();\n            return Poll::Pending;\n        }\n        return Poll::Ready(())\n    })\n}\n\n# async fn __() {\nyield_now().await;\n# }\n```\n\n[`Future::poll()`]: core::future::Future::poll\n[`Poll::Pending`]: core::task::Poll::Pending\n[`local_waker`]: core::task::Context::local_waker","links":{"core::task::Poll::Pending":30834,"`Sync`":9,"`LocalWaker::wake()`":31011,"`ContextBuilder`":12218,"`Clone`":37,"Self::will_wake":31012,"`Send`":5,"`Waker`":8982,"`RawWaker`":9810,"core::task::Context::local_waker":30964,"`Context`":12216,"core::future::Future::poll":13624},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 118959, is_soft: false}, feature: \"local_waker\"}}]"},{"repr":{"kind":"transparent","align":null,"packed":null,"int":null}}],"deprecation":null,"inner":{"struct":{"kind":{"plain":{"fields":[],"has_stripped_fields":true}},"generics":{"params":[],"where_predicates":[]},"impls":[31020,13416,26574,26882,31021,31022,31023,31024,31025,31026,31027,31028,14048,8985,10457,21845,28675,12441,13180]}}},"12837":{"id":12837,"crate_id":0,"name":null,"span":null,"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Sync","id":9,"args":null},"for":{"resolved_path":{"path":"IpAddr","id":8721,"args":null}},"items":[],"is_negative":false,"is_synthetic":true,"blanket_impl":null}}},"34635":{"id":34635,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\borrow.rs","begin":[212,1],"end":[217,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"T"},"bounds":[{"trait_bound":{"trait":{"path":"Sized","id":7,"args":null},"generic_params":[],"modifier":"maybe"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"Borrow","id":684,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"int64x1x4_t","id":9260,"args":null}},"items":[682],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"16688":{"id":16688,"crate_id":0,"name":"Output","span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[517,1],"end":[517,70]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"assoc_type":{"generics":{"params":[],"where_predicates":[]},"bounds":[],"type":{"qualified_path":{"name":"Output","args":null,"self_type":{"primitive":"u8"},"trait":{"path":"Shl","id":4638,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i64"}}],"constraints":[]}}}}}}}},"38486":{"id":38486,"crate_id":0,"name":"_mm_mask3_fnmadd_round_ss","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86\\avx512f.rs","begin":[40374,1],"end":[40391,2]},"visibility":"public","docs":"Multiply the lower single-precision (32-bit) floating-point elements in a and b, and add the negated intermediate result to the lower element in c. Store the result in the lower element of dst using writemask k (the element is copied from c when mask bit 0 is not set), and copy the upper 3 packed elements from c to the upper elements of dst.\\\n\nRounding is done according to the rounding\\[3:0\\] parameter, which can be one of:\\\n* [`_MM_FROUND_TO_NEAREST_INT`] | [`_MM_FROUND_NO_EXC`] : round to nearest and suppress exceptions\n* [`_MM_FROUND_TO_NEG_INF`] | [`_MM_FROUND_NO_EXC`] : round down and suppress exceptions\n* [`_MM_FROUND_TO_POS_INF`] | [`_MM_FROUND_NO_EXC`] : round up and suppress exceptions\n* [`_MM_FROUND_TO_ZERO`] | [`_MM_FROUND_NO_EXC`] : truncate and suppress exceptions\n* [`_MM_FROUND_CUR_DIRECTION`] : use `MXCSR.RC` - see [`_MM_SET_ROUNDING_MODE`]\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=mm_mask3_fnmadd_round_ss&expand=2741)","links":{"`_MM_FROUND_TO_POS_INF`":35316,"`_MM_SET_ROUNDING_MODE`":35056,"`_MM_FROUND_TO_NEAREST_INT`":35314,"`_MM_FROUND_NO_EXC`":35320,"`_MM_FROUND_TO_NEG_INF`":35315,"`_MM_FROUND_TO_ZERO`":35317,"`_MM_FROUND_CUR_DIRECTION`":35318},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vfnmadd, ROUNDING = 8))]"},{"other":"#[rustc_legacy_const_generics(4)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m128","id":9311,"args":null}}],["b",{"resolved_path":{"path":"__m128","id":9311,"args":null}}],["c",{"resolved_path":{"path":"__m128","id":9311,"args":null}}],["k",{"resolved_path":{"path":"__mmask8","id":35946,"args":null}}],["ROUNDING",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"__m128","id":9311,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"20539":{"id":20539,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[905,1],"end":[905,81]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"BitXorAssign","id":2377,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"primitive":"i128"}}}}],"constraints":[]}}},"for":{"primitive":"i128"},"items":[20538],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"42337":{"id":42337,"crate_id":0,"name":"vdiv_f16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\aarch64\\neon\\generated.rs",