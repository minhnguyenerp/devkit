public","docs":null,"links":{},"attrs":[{"other":"#[rustc_legacy_const_generics(1)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lsx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m128i","id":9440,"args":null}}],["IMM5",{"primitive":"u32"}]],"output":{"resolved_path":{"path":"m128i","id":9440,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5956":{"id":5956,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 8, patch: 0})}, feature: \"op_assign_traits\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"DivAssign","id":1413,"args":null},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}},"items":[5955],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"27754":{"id":27754,"crate_id":0,"name":"fetch_update","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3734,1],"end":[3751,2]},"visibility":"public","docs":"Fetches the value, and applies a function to it that returns an optional\nnew value. Returns a `Result` of `Ok(previous_value)` if the function returned `Some(_)`, else\n`Err(previous_value)`.\n\nNote: This may call the function multiple times if the value has been changed from other threads in\nthe meantime, as long as the function returns `Some(_)`, but the function will have been applied\nonly once to the stored value.\n\n`fetch_update` takes two [`Ordering`] arguments to describe the memory ordering of this operation.\nThe first describes the required ordering for when the operation finally succeeds while the second\ndescribes the required ordering for loads. These correspond to the success and failure orderings of\n[`AtomicU8::compare_exchange`]\nrespectively.\n\nUsing [`Acquire`] as success ordering makes the store part\nof this operation [`Relaxed`], and using [`Release`] makes the final successful load\n[`Relaxed`]. The (failed) load ordering can only be [`SeqCst`], [`Acquire`] or [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic operations on\n[`u8`].\n\n# Considerations\n\nThis method is not magic; it is not provided by the hardware, and does not act like a\ncritical section or mutex.\n\nIt is implemented on top of an atomic [compare-and-swap operation], and thus is subject to\nthe usual drawbacks of CAS operations. In particular, be careful of the [ABA problem]\nif this atomic integer is an index or more generally if knowledge of only the *bitwise value*\nof the atomic is not in and of itself sufficient to ensure any required preconditions.\n\n[ABA Problem]: https://en.wikipedia.org/wiki/ABA_problem\n[compare-and-swap operation]: https://en.wikipedia.org/wiki/Compare-and-swap\n\n# Examples\n\n```rust\nuse std::sync::atomic::{AtomicU8, Ordering};\n\nlet x = AtomicU8::new(7);\nassert_eq!(x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None), Err(7));\nassert_eq!(x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)), Ok(7));\nassert_eq!(x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)), Ok(8));\nassert_eq!(x.load(Ordering::SeqCst), 9);\n```","links":{"`AtomicU8::compare_exchange`":27746,"`Acquire`":27624,"`Relaxed`":27625,"`SeqCst`":27623,"`u8`":272,"`Ordering`":8789,"`Release`":27626},"attrs":[{"other":"#[<cfg_trace>(target_has_atomic = \"8\")]"},{"other":"#[<cfg_attr_trace>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 45, patch: 0})}, feature: \"no_more_cas\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = RustcShouldNotBeCalledOnConstItems]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["set_order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}],["fetch_order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}],["f",{"generic":"F"}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}},{"type":{"primitive":"u8"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[{"name":"F","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"F"},"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u8"}],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u8"}}],"constraints":[]}}}}}}},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49552":{"id":49552,"crate_id":0,"name":"shr_exact","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[271,5],"end":[290,6]},"visibility":"public","docs":"Exact shift right. Computes `self >> rhs` as long as it can be reversed losslessly.\n\nReturns `None` if any non-zero bits would be shifted out or if `rhs` >=\n`i16::BITS`.\nOtherwise, returns `Some(self >> rhs)`.\n\n# Examples\n\n```\n#![feature(exact_bitshifts)]\n\nassert_eq!(0x10i16.shr_exact(4), Some(0x1));\nassert_eq!(0x10i16.shr_exact(5), None);\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 144336, is_soft: false}, feature: \"exact_bitshifts\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"u32"}]],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9807":{"id":9807,"crate_id":0,"name":"eq","span":{"filename":"library\\core\\src\\task\\poll.rs","begin":[11,34],"end":[11,43]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Poll","id":8973,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}}}}}]],"output":{"primitive":"bool"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31605":{"id":31605,"crate_id":0,"name":"vclsq_u16","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[6505,1],"end":[6507,2]},"visibility":"public","docs":"Count leading sign bits\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vclsq_u16)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(target_arch = \"arm\", target_