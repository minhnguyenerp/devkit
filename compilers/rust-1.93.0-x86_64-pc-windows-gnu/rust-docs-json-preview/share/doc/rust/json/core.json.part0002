{"primitive":"isize"}}],"constraints":[]}}}}}}}},"41698":{"id":41698,"crate_id":0,"name":"_blsi_u64","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\x86_64\\bmi.rs","begin":[63,1],"end":[65,2]},"visibility":"public","docs":"Extracts lowest set isolated bit.\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_blsi_u64)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(blsi))]"},{"other":"#[<cfg_trace>(not(target_arch = \"x86\"))]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 27, patch: 0})}, feature: \"simd_x86\"}}]"},{"target_feature":{"enable":["bmi1"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["x",{"primitive":"u64"}]],"output":{"primitive":"u64"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"1953":{"id":1953,"crate_id":0,"name":"NonZeroI16","span":{"filename":"library\\core\\src\\num\\nonzero.rs","begin":[2363,1],"end":[2373,2]},"visibility":"public","docs":"An [`i16`] that is known not to equal zero.\n\nThis enables some memory layout optimization.\nFor example, `Option<NonZeroI16>` is the same size as `i16`:\n\n```rust\nassert_eq!(size_of::<Option<core::num::NonZeroI16>>(), size_of::<i16>());\n```\n\n# Layout\n\n`NonZeroI16` is guaranteed to have the same layout and bit validity as `i16`\nwith the exception that `0` is not a valid instance.\n`Option<NonZeroI16>` is guaranteed to be compatible with `i16`,\nincluding in FFI.\n\nThanks to the [null pointer optimization],\n`NonZeroI16` and `Option<NonZeroI16>`\nare guaranteed to have the same size and alignment:\n\n```\nuse std::num::NonZeroI16;\n\nassert_eq!(size_of::<NonZeroI16>(), size_of::<Option<NonZeroI16>>());\nassert_eq!(align_of::<NonZeroI16>(), align_of::<Option<NonZeroI16>>());\n```\n\n# Compile-time creation\n\nSince both [`Option::unwrap()`] and [`Option::expect()`] are `const`, it is possible to\ndefine a new\n`NonZeroI16`\nat compile time via:\n```\nuse std::num::NonZeroI16;\n\nconst TEN: NonZeroI16 = NonZeroI16::new(10).expect(\"ten is non-zero\");\n```\n\n[null pointer optimization]: crate::option#representation","links":{"crate::option#representation":816,"`Option::unwrap()`":1944,"`i16`":218,"`Option::expect()`":1945},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 34, patch: 0})}, feature: \"signed_nonzero\"}}]"}],"deprecation":null,"inner":{"type_alias":{"type":{"resolved_path":{"path":"NonZero","id":800,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i16"}}],"constraints":[]}}}},"generics":{"params":[],"where_predicates":[]}}}},"23751":{"id":23751,"crate_id":0,"name":"fold","span":{"filename":"library\\core\\src\\iter\\adapters\\by_ref_sized.rs","begin":[40,5],"end":[46,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["init",{"generic":"B"}],["f",{"generic":"F"}]],"output":{"generic":"B"},"is_c_variadic":false},"generics":{"params":[{"name":"B","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"F","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"F"},"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"generic":"B"},{"qualified_path":{"name":"Item","args":null,"self_type":{"generic":"Self"},"trait":{"path":"","id":77,"args":null}}}],"output":{"generic":"B"}}}},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"45549":{"id":45549,"crate_id":0,"name":nu