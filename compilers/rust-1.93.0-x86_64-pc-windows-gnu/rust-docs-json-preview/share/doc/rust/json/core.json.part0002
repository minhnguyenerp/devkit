s_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"6242":{"id":6242,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 22, patch: 0})}, feature: \"op_assign_builtins_by_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"AddAssign","id":2264,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"i8"}}],"constraints":[]}}}},"items":[6241],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"28040":{"id":28040,"crate_id":0,"name":"try_update","span":{"filename":"library\\core\\src\\sync\\atomic.rs","begin":[3886,1],"end":[3903,2]},"visibility":"public","docs":"Fetches the value, and applies a function to it that returns an optional\nnew value. Returns a `Result` of `Ok(previous_value)` if the function returned `Some(_)`, else\n`Err(previous_value)`.\n\nSee also: [`update`](`AtomicU128::update`).\n\nNote: This may call the function multiple times if the value has been changed from other threads in\nthe meantime, as long as the function returns `Some(_)`, but the function will have been applied\nonly once to the stored value.\n\n`try_update` takes two [`Ordering`] arguments to describe the memory ordering of this operation.\nThe first describes the required ordering for when the operation finally succeeds while the second\ndescribes the required ordering for loads. These correspond to the success and failure orderings of\n[`AtomicU128::compare_exchange`]\nrespectively.\n\nUsing [`Acquire`] as success ordering makes the store part\nof this operation [`Relaxed`], and using [`Release`] makes the final successful load\n[`Relaxed`]. The (failed) load ordering can only be [`SeqCst`], [`Acquire`] or [`Relaxed`].\n\n**Note**: This method is only available on platforms that support atomic operations on\n[`u128`].\n\n# Considerations\n\nThis method is not magic; it is not provided by the hardware, and does not act like a\ncritical section or mutex.\n\nIt is implemented on top of an atomic [compare-and-swap operation], and thus is subject to\nthe usual drawbacks of CAS operations. In particular, be careful of the [ABA problem]\nif this atomic integer is an index or more generally if knowledge of only the *bitwise value*\nof the atomic is not in and of itself sufficient to ensure any required preconditions.\n\n[ABA Problem]: https://en.wikipedia.org/wiki/ABA_problem\n[compare-and-swap operation]: https://en.wikipedia.org/wiki/Compare-and-swap\n\n# Examples\n\n```rust\n#![feature(atomic_try_update)]\n#![feature(integer_atomics)]\n\nuse std::sync::atomic::{AtomicU128, Ordering};\n\nlet x = AtomicU128::new(7);\nassert_eq!(x.try_update(Ordering::SeqCst, Ordering::SeqCst, |_| None), Err(7));\nassert_eq!(x.try_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)), Ok(7));\nassert_eq!(x.try_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)), Ok(8));\nassert_eq!(x.load(Ordering::SeqCst), 9);\n```","links":{"`Acquire`":27624,"`Relaxed`":27625,"`SeqCst`":27623,"`Release`":27626,"`AtomicU128::compare_exchange`":28030,"`AtomicU128::update`":28039,"`u128`":248,"`Ordering`":8789},"attrs":[{"other":"#[<cfg_trace>(target_has_atomic = \"128\")]"},{"other":"#[<cfg_attr_trace>(miri, track_caller)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 135894, is_soft: false}, feature: \"atomic_try_update\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"other":"#[attr = RustcShouldNotBeCalledOnConstItems]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["set_order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}],["fetch_order",{"resolved_path":{"path":"Ordering","id":8789,"args":null}}],["f",{"impl_trait":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u128"}],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}}}}},"generic_params":[],"modifier":"none"}}]}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}},{"type":{"primitive":"u128"}}],"constraints":[]}}}},"is_c_variadic":false},"generics":{"params":[{"name":"impl FnMut(u128) -> Option<u128>","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"FnMut","id":17,"args":{"parenthesized":{"inputs":[{"primitive":"u128"}],"output":{"resolved_path":{"path":"Option","id":79,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u128"}}],"constraints":[]}}}}}}},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":true}}}],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49838":{"id":49838,"crate_id":0,"name":"unchecked_shl_exact","span":{"filename":"library\\core\\src\\num\\mod.rs","begin":[319,5],"end":[338,6]},"visibility":"public","docs":"Unchecked exact shift left. Computes `self << rhs`, assuming the operation can be\nlosslessly reversed and `rhs` cannot be larger than\n`i64::BITS`.\n\n# Safety\n\nThis results in undefined behavior when `rhs >= self.leading_zeros() && rhs >=\nself.leading_ones()` i.e. when\n[`i64::shl_exact`]\nwould return `None`.","links":{"`i64::shl_exact`":49837},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 144336, is_soft: false}, feature: \"exact_bitshifts\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"this returns the result of the operation, without modifying the original"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["rhs",{"primitive":"u32"}]],"output":{"primitive":"i64"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":true,"is_async":false,"abi":"Rust"},"has_body":true}}},"10093":{"id":10093,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\pin.rs","begin":[1148,1],"end":[1152,2]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 41, patch: 0})}, feature: \"pin_trait_impls\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"Ptr","kind":{"type":{"bounds":[{"trait_bound":{"trait":{"path":"Deref","id":7973,"args":{"angle_bracketed":{"args":[],"constraints":[{"name":"Target","args":null,"binding":{"constraint":[{"trait_bound":{"trait":{"path":"Ord","id":45,"args":null},"generic_params":[],"modifier":"none"}}]}}]}}},"generic_params":[],"modifier":"none"}}],"default":null,"is_synthetic":false}}}],"where_predicates":[]},"provided_trait_methods":["max","min","clamp"],"trait":{"path":"Ord","id":45,"args":null},"for":{"resolved_path":{"path":"Pin","id":8756,"args":{"angle_bracketed":{"args":[{"type":{"generic":"Ptr"}}],"constraints":[]}}}},"items":[10092],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"31891":{"id":31891,"crate_id":0,"name":"vhaddq_s32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\