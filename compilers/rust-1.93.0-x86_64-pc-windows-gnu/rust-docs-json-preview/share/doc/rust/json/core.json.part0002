_MANT_NORM_1_2     // interval [1, 2)\\\n   _MM_MANT_NORM_p5_2    // interval [0.5, 2)\\\n   _MM_MANT_NORM_p5_1    // interval [0.5, 1)\\\n   _MM_MANT_NORM_p75_1p5 // interval [0.75, 1.5)\\\nThe sign is determined by sc which can take the following values:\\\n   _MM_MANT_SIGN_src     // sign = sign(src)\\\n   _MM_MANT_SIGN_zero    // sign = 0\\\n   _MM_MANT_SIGN_nan     // dst = NaN if sign(src) = 1\n\n[Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_getmant_pd&expand=2868)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(test, assert_instr(vgetmantpd, NORM = 0, SIGN = 0))]"},{"other":"#[rustc_legacy_const_generics(1, 2)]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 89, patch: 0})}, feature: \"stdarch_x86_avx512\"}}]"},{"target_feature":{"enable":["avx512f","avx512vl"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"__m256d","id":9323,"args":null}}],["NORM",{"resolved_path":{"path":"_MM_MANTISSA_NORM_ENUM","id":36447,"args":null}}],["SIGN",{"resolved_path":{"path":"_MM_MANTISSA_SIGN_ENUM","id":36448,"args":null}}]],"output":{"resolved_path":{"path":"__m256d","id":9323,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"18513":{"id":18513,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\ops\\bit.rs","begin":[639,1],"end":[639,70]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 0, patch: 0})}, feature: \"rust1\"}}]"}],"depre