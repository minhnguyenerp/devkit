ter size.\n\n# Examples\n\n```\nlet value = isize::from_ne_bytes(if cfg!(target_endian = \"big\") {\n    [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]\n} else {\n    [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]\n});\nassert_eq!(value, 0x1234567890123456);\n```\n\nWhen starting from a slice rather than an array, fallible conversion APIs can be used:\n\n```\nfn read_ne_isize(input: &mut &[u8]) -> isize {\n    let (int_bytes, rest) = input.split_at(size_of::<isize>());\n    *input = rest;\n    isize::from_ne_bytes(int_bytes.try_into().unwrap())\n}\n```","links":{"Self::from_le_bytes":50807,"Self::from_be_bytes":50805},"attrs":[{"other":"#[allow(unnecessary_transmutes)]"},{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 44, patch: 0})}, feature: \"const_int_conversion\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 32, patch: 0})}, feature: \"int_to_from_bytes\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":null}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["bytes",{"array":{"type":{"primitive":"u8"},"len":"8"}}]],"output":{"generic":"Self"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"11170":{"id":11170,"crate_id":0,"name":"try_from","span":{"filename":"library\\core\\src\\convert\\num.rs","begin":[371,1],"end":[371,52]},"visibility":"default","docs":"Tries to create the target number type from a source\nnumber type. This returns an error if the source value\nis outside of the range of the target type.","links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["u",{"primitive":"i32"}]],"output":{"resolved_path":{"path":"Result","id":85,"args":{"angle_bracketed":{"args":[{"type":{"generic"