ename":"library\\core\\src\\convert\\mod.rs","begin":[811,1],"end":[821,2]},"visibility":"default","docs":null,"links":{},"attrs":[],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[{"name":"T","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}},{"name":"U","kind":{"type":{"bounds":[],"default":null,"is_synthetic":false}}}],"where_predicates":[{"bound_predicate":{"type":{"generic":"U"},"bounds":[{"trait_bound":{"trait":{"path":"TryFrom","id":163,"args":{"angle_bracketed":{"args":[{"type":{"generic":"T"}}],"constraints":[]}}},"generic_params":[],"modifier":"none"}}],"generic_params":[]}}]},"provided_trait_methods":[],"trait":{"path":"TryInto","id":165,"args":{"angle_bracketed":{"args":[{"type":{"generic":"U"}}],"constraints":[]}}},"for":{"resolved_path":{"path":"BorrowedBuf","id":10673,"args":{"angle_bracketed":{"args":[{"lifetime":"'data"}],"constraints":[]}}}},"items":[697,698],"is_negative":false,"is_synthetic":false,"blanket_impl":{"generic":"T"}}}},"45464":{"id":45464,"crate_id":0,"name":"lasx_xvssrarni_du_q","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\loongarch64\\lasx\\generated.rs","begin":[6629,1],"end":[6632,2]},"visibility":"public","docs":null,"links":{},"attrs":[{"other":"#[rustc_legacy_const_generics(2)]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 117427, is_soft: false}, feature: \"stdarch_loongarch\"}}]"},{"target_feature":{"enable":["lasx"]}},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["a",{"resolved_path":{"path":"m256i","id":9431,"args":null}}],["b",{"resolved_path":{"path":"m256i","id":9431,"args":null}}],["IMM7",{"primitive":"u32"}]],"output":{"resolved_path":{"path":"m256i","id":9431,"args":null}},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"5719":{"id":5719,"crate_id":0,"name":null,"span":{"filename":"library\\core\\src\\num\\wrapping.rs","begin":[566,1],"end":[566,71]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143802, is_soft: false}, feature: \"const_ops\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Stable {since: Version(RustcVersion {major: 1,\nminor: 14, patch: 0})}, feature: \"wrapping_ref\"}}]"}],"deprecation":null,"inner":{"impl":{"is_unsafe":false,"generics":{"params":[],"where_predicates":[]},"provided_trait_methods":[],"trait":{"path":"Add","id":2252,"args":{"angle_bracketed":{"args":[{"type":{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}}}}}],"constraints":[]}}},"for":{"resolved_path":{"path":"Wrapping","id":4341,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"u64"}}],"constraints":[]}}}},"items":[5717,5718],"is_negative":false,"is_synthetic":false,"blanket_impl":null}}},"27517":{"id":27517,"crate_id":0,"name":"into_ok","span":{"filename":"library\\core\\src\\result.rs","begin":[1361,5],"end":[1369,6]},"visibility":"public","docs":"Returns the contained [`Ok`] value, but never panics.\n\nUnlike [`unwrap`], this method is known to never panic on the\nresult types it is implemented for. Therefore, it can be used\ninstead of `unwrap` as a maintainability safeguard that will fail\nto compile if the error type of the `Result` is later changed\nto an error that can actually occur.\n\n[`unwrap`]: Result::unwrap\n\n# Examples\n\n```\n# #![feature(never_type)]\n# #![feature(unwrap_infallible)]\n\nfn only_good_news() -> Result<String, !> {\n    Ok(\"this is fine\".into())\n}\n\nlet s: String = only_good_news().into_ok();\nprintln!(\"{s}\");\n```","links":{"Result::unwrap":11696,"`Ok`":89},"attrs":[{"other":"#[attr = ConstStability {stability: PartialConstStability {level: Unstable {reason: None,\nissue: 143773, is_soft: false}, feature: \"const_convert\", promotable: false}}]"},{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: Some(\"newly added\"),\nissue: 61695, is_soft: false}, feature: \"unwrap_infallible\"}}]"},{"other":"#[attr = AllowConstFnUnstable([\"const_precise_live_drops\"])]"},{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}]],"output":{"generic":"T"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[{"bound_predicate":{"type":{"generic":"E"},"bounds":[{"trait_bound":{"trait":{"path":"Into","id":63,"args":{"angle_bracketed":{"args":[{"type":{"primitive":"never"}}],"constraints":[]}}},"generic_params":[],"modifier":"maybe_const"}}],"generic_params":[]}}]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"49315":{"id":49315,"crate_id":0,"name":"clamp","span":{"filename":"library\\core\\src\\num\\f128.rs","begin":[1276,5],"end":[1292,6]},"visibility":"public","docs":"Restrict a value to a certain interval unless it is NaN.\n\nReturns `max` if `self` is greater than `max`, and `min` if `self` is\nless than `min`. Otherwise this returns `self`.\n\nNote that this function returns NaN if the initial value was NaN as\nwell. If the result is zero and among the three inputs `self`, `min`, and `max` there are\nzeros with different sign, either `0.0` or `-0.0` is returned non-deterministically.\n\n# Panics\n\nPanics if `min > max`, `min` is NaN, or `max` is NaN.\n\n# Examples\n\n```\n#![feature(f128)]\n# // FIXME(f16_f128): remove when `{eq,gt,unord}tf` are available\n# #[cfg(all(target_arch = \"x86_64\", target_os = \"linux\"))] {\n\nassert!((-3.0f128).clamp(-2.0, 1.0) == -2.0);\nassert!((0.0f128).clamp(-2.0, 1.0) == 0.0);\nassert!((2.0f128).clamp(-2.0, 1.0) == 1.0);\nassert!((f128::NAN).clamp(-2.0, 1.0).is_nan());\n\n// These always returns zero, but the sign (which is ignored by `==`) is non-deterministic.\nassert!((0.0f128).clamp(-0.0, -0.0) == 0.0);\nassert!((1.0f128).clamp(-0.0, 0.0) == 0.0);\n// This is definitely a negative zero.\nassert!((-1.0f128).clamp(-0.0, 1.0).is_sign_negative());\n# }\n```","links":{},"attrs":[{"other":"#[attr = Stability {stability: Stability {level: Unstable {reason: None,\nissue: 116909, is_soft: false}, feature: \"f128\"}}]"},{"other":"#[attr = Inline(Hint)]"},{"must_use":{"reason":"method returns a new number and does not mutate the original value"}}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"generic":"Self"}],["min",{"primitive":"f128"}],["max",{"primitive":"f128"}]],"output":{"primitive":"f128"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":true,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"9570":{"id":9570,"crate_id":0,"name":"ne","span":{"filename":"library\\core\\src\\cmp.rs","begin":[1885,5],"end":[1887,6]},"visibility":"default","docs":null,"links":{},"attrs":[{"other":"#[attr = Inline(Hint)]"}],"deprecation":null,"inner":{"function":{"sig":{"inputs":[["self",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}],["other",{"borrowed_ref":{"lifetime":null,"is_mutable":false,"type":{"generic":"Self"}}}]],"output":{"primitive":"bool"},"is_c_variadic":false},"generics":{"params":[],"where_predicates":[]},"header":{"is_const":false,"is_unsafe":false,"is_async":false,"abi":"Rust"},"has_body":true}}},"31368":{"id":31368,"crate_id":0,"name":"vabdq_u32","span":{"filename":"library\\core\\src\\..\\..\\stdarch\\crates\\core_arch\\src\\arm_shared\\neon\\generated.rs","begin":[1253,1],"end":[1263,2]},"visibility":"public","docs":"Absolute difference between the arguments\n[Arm's documentation](https://developer.arm.com/architectures/instruction-sets/intrinsics/vabdq_u32)","links":{},"attrs":[{"other":"#[<cfg_attr_trace>(